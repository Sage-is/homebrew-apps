class Price(NamedTuple):
    id: str
    kind: str
    name: str
    usd_per_tb: float
    min_usd: float
    unit: str
    min_days: int
    checked: str
    note: str


def parse_prices(text: str, source: str) -> List[Price]:
    rows = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or line.startswith("id|"):
            continue
        cells = line.split("|")
        if len(cells) != 9:
            die(f"{source}: a price row needs 9 cells (id|kind|name|usd_per_tb|min_usd|unit|min_days|checked|note): {line}")
        try:
            rows.append(Price(cells[0], cells[1], cells[2], float(cells[3]), float(cells[4]), cells[5],
                              int(cells[6]), cells[7], cells[8]))
        except ValueError:
            die(f"{source}: numbers expected in usd_per_tb, min_usd, min_days: {line}")
    return rows


def prices_user_file() -> str:
    return os.path.join(os.path.dirname(S.conf), "prices.tsv")


def load_prices() -> List[Price]:
    rows = {p.id: p for p in parse_prices(PRICES, "built-in price table")}
    user = prices_user_file()
    if os.path.isfile(user):
        rows.update({p.id: p for p in parse_prices(open(user).read(), user)})
    return list(rows.values())


def price_for(p: Price, size: int) -> float:
    return max(p.min_usd, p.usd_per_tb * size / 1e12)


def days_since(date: str) -> int:
    try:
        return int((time.time() - time.mktime(time.strptime(date, "%Y-%m-%d"))) // 86400)
    except ValueError:
        return 10 ** 6


def stale_note(prices: List[Price]) -> str:
    oldest = max((days_since(p.checked) for p in prices), default=0)
    if oldest <= PRICES_STALE_DAYS:
        return ""
    return (f"Prices were last checked {oldest} days ago: run 'offload prices --update' "
            f"or correct rows in {prices_user_file()}.")


def cmd_prices(args: list) -> None:
    if "--update" in args:
        import urllib.request
        log(f"Fetching the team price table from {PRICES_URL}")
        try:
            body = urllib.request.urlopen(PRICES_URL, timeout=30).read().decode("utf-8")
        except OSError as error:
            die(f"could not fetch {PRICES_URL}: {error}")
        m = re.search(r"# @@PRICES-BEGIN@@\n(.*?)# @@PRICES-END@@", body, re.S)
        if not m:
            die(f"{PRICES_URL} has no price table block")
        fresh = parse_prices(m.group(1), PRICES_URL)
        user = prices_user_file()
        os.makedirs(os.path.dirname(user), exist_ok=True)
        if os.path.isfile(user):
            os.replace(user, user + ".old")
            log(f"  previous file kept as {user}.old")
        with open(user, "w") as f:
            f.write("id|kind|name|usd_per_tb|min_usd|unit|min_days|checked|note\n" + m.group(1))
        log(f"  {len(fresh)} rows written to {user}, newest check {max(p.checked for p in fresh)}")
        return
    prices = load_prices()
    row = "{:<12} {:<6} {:<42} {:>10} {:>9} {:>6}  {}"
    print(row.format("ID", "KIND", "NAME", "$/TB", "MIN $", "DAYS", "CHECKED / NOTE"))
    for p in sorted(prices, key=lambda p: (p.kind, p.usd_per_tb)):
        per = "-" if p.kind == "free" else f"{p.usd_per_tb:g}/{'mo' if p.kind == 'cloud' else 'once'}"
        print(row.format(p.id, p.kind, p.name[:42], per, f"{p.min_usd:g}", p.min_days, f"{p.checked}  {p.note}"))
    note = stale_note(prices)
    if note:
        print()
        print(note)


def tool_version(cmd: list) -> str:
    """First line of a tool's version output, or '' when it is not installed."""
    if not shutil.which(cmd[0]):
        return ""
    out = capture(cmd, timeout=15)
    return out.splitlines()[0].strip() if out else "installed"


def print_tools(cold: str) -> None:
    store = cold or "<COLD>"
    rclone, annex = tool_version(["rclone", "version"]), tool_version(["git", "annex", "version"])
    restic, kopia = tool_version(["restic", "version"]), tool_version(["kopia", "--version"])
    print("--- Encrypted stores and mounts (optional tools; install with brew) ---")
    for name, version in (("rclone", rclone), ("git-annex", annex if "git-annex" in annex else ""),
                          ("restic", restic), ("kopia", kopia)):
        print(f"  {name:<10} {version or 'not installed: brew install ' + name}"
              + (f"  ({shutil.which('rclone')})" if name == "rclone" and rclone else ""))
    m = re.search(r"v(\d+)\.(\d+)", rclone)
    if m and (int(m.group(1)), int(m.group(2))) < (1, 65):
        print(f"  rclone at {shutil.which('rclone')} is older than 1.65: no 'nfsmount'. Homebrew's rclone is current.")
    print(f"""
  Built in, no install: an encrypted APFS sparsebundle on {store}. Attached, it is a drive of
  its own that can take private data (add it to OFFLOAD_DRIVES; 'offload drives' lists it):
    hdiutil create -type SPARSEBUNDLE -encryption AES-256 -fs APFS -size 200g -volname OffloadVault "{store}/OffloadVault.sparsebundle"
    hdiutil attach -owners on "{store}/OffloadVault.sparsebundle"
  rclone: an encrypted 'crypt' store over a folder on {store}; contents and names are encrypted,
  so Backblaze sees only ciphertext. Create it with 'rclone config' and take the password from
  the vault (sage-secret); never type it on a command line.
    rclone copy <folder> offload-crypt:<name>              archive a cold folder
    rclone nfsmount offload-crypt: ~/mnt/offload-crypt      browse it (rclone >= 1.65; never a symlink target)
  git-annex: tracks which drive or remote holds each file and drops a local copy only when
  enough copies exist elsewhere:
    git annex initremote cold type=directory directory="{store}/annex" encryption=hybrid keyid=<your GPG key>
  restic or Kopia: deduplicated, encrypted backups to B2, S3 or SFTP.""")


def cmd_plan(_args: list) -> None:
    print("=== offload plan (advice only: nothing moves, nothing uploads) ===")
    st = os.statvfs(S.home)
    boot_total, boot_free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
    need = max(0, boot_total * S.boot_free_pct // 100 - boot_free)
    print(f"Boot drive: {human(boot_free)} free of {human(boot_total)} ({100 * boot_free // boot_total}%). "
          f"Target {S.boot_free_pct}% free: " + (f"free {human(need)} more." if need else "already there."))
    print()
    print("--- Drives ---")
    for v in inventory():
        pct = f"{100 * v.free // v.size}%" if v.size else "-"
        print(f"  {os.path.basename(v.mount):<24} {v.role:<9} {pct:>4} free  backup {v.backup:<8} "
              f"encrypted {yes_no(v.encrypted):<3}  owners {yes_no(v.owners, 'on', 'off')}")
    print()
    placeable, immediate, admin, manual = [], 0, 0, 0
    for t in iter_targets(drives=False):
        size = row_bytes(t)
        if not size:
            continue
        tier, _ = split_tier(t.dest)
        if t.admin == "yes":
            admin += size
        elif t.strategy in ("sweep", "purge"):
            immediate += size
        elif t.strategy in TIERED and tier:
            placeable.append((size, t, tier))
        else:
            manual += size
    print("--- Fit: on-disk targets, largest first ---")
    placed, notes, backed = 0, [], set()
    for size, t, tier in sorted(placeable, key=lambda x: -x[0]):
        path, why = try_pick(tier, size, t.label)
        verdict = ""
        if not path and t.label in S.private:
            verdict = "keep internal: private, and no encrypted drive with ownership on"
            if t.label in ("Signal", "Messages"):
                verdict += " (it starts at login, so not inside a disk image either)"
        elif not path and tier == "HOT":
            path, _ = try_pick("COLD", size, t.label)
            if path:
                verdict = f"{os.path.basename(path)} (COLD: slower than HOT)"
        elif path:
            verdict = f"{os.path.basename(path)} ({tier})"
        if path:
            placed += size
            if t.label in TARGET_NOTES:
                notes.append(TARGET_NOTES[t.label])
            v = volume_for(path)
            if v:
                backed.add(v.backup)
                if v.backup == "none":
                    notes.append(f"{t.label} on {os.path.basename(path)} would have no backup "
                                 "(Time Machine excludes it and Backblaze does not cover it).")
        if not verdict:
            verdict = "no drive fits: " + "; ".join(why)
        print(f"  {human(size):>8}  {t.label:<18} {verdict}")
        if t.label == "Desktop" and os.path.isdir(os.path.join(S.home, "Library/Mobile Documents/com~apple~CloudDocs/Desktop")):
            notes.append("iCloud Drive has a Desktop folder: confirm 'Desktop & Documents' sync is off before moving Desktop.")
    print()
    print(f"  placeable now: {human(placed)} · caches and build cruft to clear: {human(immediate)} · "
          f"admin-only: {human(admin)} · manual (native UI or merge): {human(manual)}")
    after = boot_free + placed + immediate
    print(f"  boot drive after placing and clearing: {human(after)} free ({100 * after // boot_total}%)")
    hot = volume_for(S.hot) if S.hot else None
    if hot and hot.size and 100 * hot.free // hot.size < S.headroom:
        gib = math.ceil(hot.size * S.headroom / 100 / GIB)
        print()
        print(f"--- HOT is below {S.headroom}% free ---")
        print(f"  {os.path.basename(hot.mount)} has {human(hot.free)} free. Make room before buying anything:")
        print(f"    offload drain --need {gib}       # plan: coldest entries move to COLD, each leaves a symlink")
    if "BB" in backed:
        notes.append("Backblaze Personal keeps deleted files 30 days by default (turn on 1-year retention), "
                     "and drops a drive that stays unplugged for 30 days.")
    if notes:
        print()
        print("--- Coverage ---")
        for note in dict.fromkeys(notes):
            print(f"  {note}")
    shortfall = max(0, need - placed - immediate)
    archive = sum(size for size, t, _ in placeable if t.strategy == "archive")
    size = shortfall or archive
    print()
    if size:
        prices = load_prices()
        what = f"the {human(shortfall)} shortfall" if shortfall else f"cold archives ({human(archive)})"
        print(f"--- Options for {what} ---")
        row = "  {:<46} {:>14}  {}"
        for p in sorted(prices, key=lambda p: (p.kind != "free", p.kind == "buy", price_for(p, size))):
            cost = "free" if p.kind == "free" else f"${price_for(p, size):,.2f}" + ("/mo" if p.kind == "cloud" else " once")
            extra = f"min {p.min_days} d; " if p.min_days else ""
            print(row.format(p.name[:46], cost, extra + p.note))
        note = stale_note(prices)
        if note:
            print(f"  {note}")
    else:
        print("--- Options --- none needed: your drives cover the plan; no purchase or cloud storage required.")
    print()
    print_tools(S.cold)


