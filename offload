# Targets
# ----------------------------------------------------------------------------

def target_user() -> str:
    return os.path.basename(S.target_home.rstrip("/"))


def expand(path: str, drives: bool = True) -> str:
    """Replace <TH> <TARGET_HOME> <U> <DATE>; with drives=True also HOT/ and COLD/ (the primary drives)."""
    path = (path.replace("<TH>", S.target_home).replace("<TARGET_HOME>", S.target_home)
            .replace("<U>", target_user()).replace("<DATE>", S.date_tag))
    if drives and path.startswith("HOT/"):
        path = f"{S.hot}/{path[4:]}"
    elif drives and path.startswith("COLD/"):
        path = f"{S.cold}/{path[5:]}"
    return path


def iter_targets(drives: bool = True) -> Iterator[Target]:
    """Expanded rows. drives=False leaves HOT/ and COLD/ for move_one to resolve against every drive."""
    for row in S.targets:
        fields = (row.split("|") + [""] * 7)[:7]
        t = Target(*fields)
        yield t._replace(source=expand(t.source), dest=expand(t.dest, drives))


def require_drive(name: str) -> str:
    path = S.hot if name == "OFFLOAD_HOT" else S.cold
    if not path:
        die(f"{name} not set. Configure {S.conf} or export {name}.")
    if not os.path.isdir(path):
        die(f"{name} not mounted: {path}")
    return path


# ----------------------------------------------------------------------------
# Filesystem helpers
# ----------------------------------------------------------------------------

def physical_path(path: str) -> str:
    return os.path.realpath(path) if os.path.exists(path) else path


def colima_disks() -> str:
    """Colima's VM disk folder: $LIMA_HOME/_disks, else ($COLIMA_HOME or ~/.colima or $XDG_CONFIG_HOME/colima)/_lima/_disks."""
    colima_home = os.path.join(S.home, ".colima")
    if not os.path.lexists(colima_home) and os.environ.get("XDG_CONFIG_HOME"):
        colima_home = os.path.join(os.environ["XDG_CONFIG_HOME"], "colima")
    lima = os.environ.get("LIMA_HOME") or os.path.join(os.environ.get("COLIMA_HOME") or colima_home, "_lima")
    return os.path.join(lima, "_disks")


def free_bytes(path: str) -> int:
    st = os.statvfs(path)
    return st.f_bavail * st.f_frsize


def nearest_existing(path: str) -> str:
    while not os.path.isdir(path) and path not in ("/", ""):
        path = os.path.dirname(path)
    return path or "/"


def du_bytes(path: str) -> int:
    out = subprocess.run(["du", "-sk", path], capture_output=True, text=True).stdout.split()
    return int(out[0]) * 1024 if out and out[0].isdigit() else 0


def du_human(path: str) -> str:
    out = subprocess.run(["du", "-sh", path], capture_output=True, text=True).stdout.split()
    return out[0] if out else "?"


def df_avail_human(path: str) -> str:
    lines = subprocess.run(["df", "-h", path], capture_output=True, text=True).stdout.splitlines()
    return lines[1].split()[3] if len(lines) > 1 else "?"


def readable_dir(path: str) -> bool:
    return os.path.isdir(path) and os.access(path, os.R_OK | os.X_OK)


def is_empty_dir(path: str) -> bool:
    try:
        return not os.listdir(path)
    except OSError:
        return False


def tree_signature(path: str) -> str:
    """File count and summed logical sizes: allocation differs across volumes, logical bytes do not."""
    if not os.path.isdir(path):
        return "files=0 bytes=0"
    files = total = 0
    for root, _dirs, names in os.walk(path):  # os.walk does not follow directory links, like find -type f
        for name in names:
            try:
                st = os.lstat(os.path.join(root, name))
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode):
                files += 1
                total += st.st_size
    return f"files={files} bytes={total}"


def require_free(path: str, need: int) -> None:
    where = nearest_existing(path)
    avail = free_bytes(where)
    if avail < need:
        die(f"Not enough free on {where}: have {human(avail)}, need {human(need)}")
    log(f"  OK: {where} has {human(avail)} free (need {human(need)})")


def sweep_dirs(root: str) -> Iterator[str]:
    """Folders named in SWEEP_DIRNAMES under root, not descending into a match."""
    for here, dirs, _ in os.walk(root):
        keep = []
        for name in dirs:
            full = os.path.join(here, name)
            if name in SWEEP_DIRNAMES:
                yield full
            elif not os.path.islink(full):
                keep.append(name)
        dirs[:] = keep


# ----------------------------------------------------------------------------
# Running commands
# ----------------------------------------------------------------------------

def run(cmd: list) -> None:
    """Log the command; under --apply run it. EACCES is recorded for the admin pass; other failures stop."""
    text = shlex.join(cmd)
    log(f"  RUN: {text}")
    if S.dry:
        return
    proc = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if proc.stderr:
        _append_log(proc.stderr.rstrip())
    if proc.returncode == 0:
        return
    if "Permission denied" in proc.stderr or "Operation not permitted" in proc.stderr:
        warn("  EACCES — recording for admin pass")
        with open(S.admin_todo, "a") as f:
            f.write(f"# from {time.strftime('%c')}\n{text}\n")
        S.admin_needed = True
        raise PermissionDenied(text)
    die(f"Command failed (rc={proc.returncode}): {text}")


def manual_step(text: str) -> None:
    log(f"  [MANUALLY] {text}")
    if not S.dry and sys.stdin.isatty():
        input("  Press Enter when done (Ctrl-C to abort): ")


def assert_admin_invariants() -> None:
    if S.target_home.rstrip("/") == S.home.rstrip("/"):
        return
    user = os.environ.get("USER") or getpass.getuser()
    if user == target_user():
        die(f"Refusing to operate on {S.target_home} as '{user}' — Admin mode requires a separate account.")
    groups = subprocess.run(["id", "-Gn", user], capture_output=True, text=True).stdout.split()
    if "admin" not in groups:
        die(f"Current account '{user}' is not in the admin group.")


def assert_fda_granted() -> None:
    probe = os.path.join(S.target_home, "Library", "Messages")
    if os.path.isdir(probe):
        try:
            os.listdir(probe)
        except PermissionError:
            die(f"Cannot read {probe} — this Terminal lacks Full Disk Access.\n"
                "       Fix: System Settings -> Privacy & Security -> Full Disk Access ->\n"
                "            add this Terminal, then restart Terminal.")


