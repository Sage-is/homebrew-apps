# Drive inventory — every mounted volume, and which one takes a move
# ----------------------------------------------------------------------------

VOLUMES_ROOT = os.environ.get("OFFLOAD_VOLUMES", "/Volumes")
BZINFO = os.environ.get("OFFLOAD_BZINFO", "/Library/Backblaze.bzpkg/bzdata/bzinfo.xml")
NETWORK_FS = ("nfs", "smbfs", "afpfs", "webdav", "macfuse", "osxfuse", "fuse")
NO_UNIX_FS = ("exfat", "msdos")


@dataclass
class Volume:
    mount: str
    fs: str = ""                     # apfs, hfs, exfat, nfs ...
    ssd: Optional[bool] = None
    protocol: str = ""
    size: int = 0
    free: int = 0
    device: int = 0
    internal: bool = False
    removable: bool = False
    network: bool = False
    readonly: bool = False
    tm: str = "?"                    # dest | included | excluded | ?
    backblaze: bool = False
    owners: Optional[bool] = None
    encrypted: Optional[bool] = None
    image: str = ""                  # backing file, for an attached disk image
    role: str = ""
    reason: str = ""

    @property
    def host(self) -> str:
        """The drive that holds this disk image's file; '' when it sits on the boot drive."""
        prefix = VOLUMES_ROOT + "/"
        return self.image[len(prefix):].split("/")[0] if self.image.startswith(prefix) else ""

    @property
    def backup(self) -> str:
        if self.tm == "dest":
            return "TM dest"
        parts = (["TM"] if self.tm == "included" else []) + (["BB"] if self.backblaze else [])
        return "+".join(parts) or "none"


def capture(cmd: list, timeout: int = 30) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def mount_entries() -> dict:
    """Mount point -> (filesystem type, options, device) from mount(8)."""
    entries = {}
    for line in capture(["mount"]).splitlines():
        m = re.match(r"^(.*) on (.*) \(([^,)]+)(.*)\)$", line)
        if m:
            entries[m.group(2)] = (m.group(3).strip().lower(), m.group(4), m.group(1))
    return entries


def backblaze_dirs() -> set:
    """Lower-cased paths Backblaze backs up in full (bzdirfilter whichfiles="all")."""
    try:
        text = open(BZINFO, encoding="utf-8", errors="ignore").read()
    except OSError:
        return set()
    return {m.group(1) for m in re.finditer(r'<bzdirfilter\s+dir="([^"]*)"\s+whichfiles="all"', text)}


def time_machine_mounts() -> List[str]:
    out = capture(["tmutil", "destinationinfo"])
    return [line.split(":", 1)[1].strip() for line in out.splitlines() if line.startswith("Mount Point")]


def tm_status(mount: str, tm_mounts: List[str]) -> str:
    markers = ("Backups.backupdb", ".com.apple.TimeMachine.snapshots", ".com.apple.TimeMachine.IOCheck")
    if mount in tm_mounts or any(os.path.isdir(os.path.join(mount, m)) for m in markers):
        return "dest"
    out = capture(["tmutil", "isexcluded", mount])
    return "excluded" if "[Excluded]" in out else "included" if "[Included]" in out else "?"


def vol_info(mount: str) -> dict:
    """`diskutil info -plist` as a dict; {} when diskutil is missing or says nothing."""
    if not shutil.which("diskutil"):
        return {}
    raw = subprocess.run(["diskutil", "info", "-plist", mount], capture_output=True).stdout
    try:
        return plistlib.loads(raw) if raw else {}
    except (ValueError, plistlib.InvalidFileException):
        return {}


def disk_images() -> dict:
    """Mount point -> (image file, encrypted?) for attached disk images.

    diskutil calls every image removable and never encrypted: the encryption
    belongs to the image file, so only `hdiutil info` knows."""
    try:
        info = plistlib.loads(capture(["hdiutil", "info", "-plist"]).encode())
    except (ValueError, plistlib.InvalidFileException):
        return {}
    return {e["mount-point"]: (im.get("image-path", ""), bool(im.get("image-encrypted")))
            for im in info.get("images", []) for e in im.get("system-entities", []) if e.get("mount-point")}


def classify(v: Volume) -> None:
    """HOT (external SSD), COLD (external spinner) or EXCLUDED, with the reason."""
    if v.tm == "dest":
        v.role, v.reason = "EXCLUDED", "Time Machine destination"
    elif v.readonly:
        v.role, v.reason = "EXCLUDED", "read-only mount"
    elif v.network:
        v.role, v.reason = "EXCLUDED", "network or FUSE mount: never a move target"
    elif v.internal:
        v.role, v.reason = "EXCLUDED", "internal drive (not an offload target)"
    elif v.removable:
        v.role, v.reason = "EXCLUDED", "removable media"
    elif v.fs in NO_UNIX_FS:
        v.role, v.reason = "EXCLUDED", f"{v.fs}: no Unix permissions or safe symlinks"
    elif v.image and not v.host:
        v.role, v.reason = "EXCLUDED", "disk image stored on the boot drive"
    elif v.image:
        v.role, v.reason = ("HOT" if v.ssd else "COLD"), f"disk image on {v.host}"
    elif v.ssd:
        v.role, v.reason = "HOT", "external SSD"
    else:
        v.role, v.reason = "COLD", "external spinner" + (" (HFS+)" if v.fs == "hfs" else "")


def probe_volume(mount: str, mounts: dict, tm_mounts: List[str], bz: set) -> Volume:
    info = vol_info(mount)
    fstype, opts, _ = mounts.get(mount, ("", "", ""))
    st = os.statvfs(mount)
    image, encrypted = "", (bool(info.get("Encryption") or info.get("FileVault")) if info else None)
    if info.get("BusProtocol") == "Disk Image":
        image, encrypted = disk_images().get(mount, ("", encrypted))
    v = Volume(mount=mount, fs=(info.get("FilesystemType") or fstype or "").lower(), ssd=info.get("SolidState"),
               protocol=info.get("BusProtocol", ""), size=st.f_blocks * st.f_frsize, free=st.f_bavail * st.f_frsize,
               device=os.stat(mount).st_dev, internal=bool(info.get("Internal", False)),
               removable=bool(info.get("Removable") or info.get("RemovableMedia")) and not image,
               network=fstype.startswith(NETWORK_FS), readonly="read-only" in opts,
               tm=tm_status(mount, tm_mounts), backblaze=(mount.lower().rstrip("/") + "/") in bz,
               owners=info.get("GlobalPermissionsEnabled"), encrypted=encrypted, image=image)
    if v.host:  # an image is backed up with the drive that holds its file, as ciphertext
        v.backblaze = v.backblaze or (os.path.join(VOLUMES_ROOT, v.host).lower() + "/") in bz
    classify(v)
    return v


def load_inventory() -> List[Volume]:
    """Every real mount under /Volumes, once per mounted device."""
    mounts, tm_mounts, bz = mount_entries(), time_machine_mounts(), backblaze_dirs()
    seen, volumes = set(), []
    for name in sorted(os.listdir(VOLUMES_ROOT)) if os.path.isdir(VOLUMES_ROOT) else []:
        mount = os.path.join(VOLUMES_ROOT, name)
        if not os.path.isdir(mount) or os.path.islink(mount) or mount not in mounts:
            continue
        device_name = mounts[mount][2]
        if device_name not in seen:
            seen.add(device_name)
            volumes.append(probe_volume(mount, mounts, tm_mounts, bz))
    return volumes


_INVENTORY: Optional[List[Volume]] = None


def inventory() -> List[Volume]:
    global _INVENTORY
    if _INVENTORY is None:
        _INVENTORY = load_inventory()
    return _INVENTORY


def volume_for(path: str) -> Optional[Volume]:
    """The mounted volume holding `path` (longest mount-point prefix), if any."""
    path = path.rstrip("/")
    holding = [v for v in inventory() if path == v.mount or path.startswith(v.mount + "/")]
    return max(holding, key=lambda v: len(v.mount)) if holding else None


def candidates(tier: str) -> List[str]:
    """The tier's primary drive first, then opted-in OFFLOAD_DRIVES of the same role."""
    primary = S.hot if tier == "HOT" else S.cold
    extra = [d for d in S.drives if d.rstrip("/") != primary.rstrip("/")
             and (volume_for(d) is not None and volume_for(d).role == tier)]
    return [p for p in [primary] + extra if p]


def ineligible(path: str, size: int, label: str) -> str:
    """Why `path` cannot take `size` bytes of `label` now; '' when it can."""
    if not os.path.isdir(path):
        return "not mounted"
    v = volume_for(path)
    if path.startswith(VOLUMES_ROOT + "/") and (v is None or os.stat(path).st_dev != v.device):
        return "not mounted (a plain folder, not a mounted drive)"
    if v and v.network:
        return "a network or FUSE mount"
    if v and v.fs in NO_UNIX_FS:
        return f"{v.fs} has no Unix permissions or safe symlinks"
    if v and v.removable and path.rstrip("/") not in (S.hot.rstrip("/"), S.cold.rstrip("/")):
        return "removable media"
    if v and v.image and not v.host:
        return "a disk image stored on the boot drive frees nothing"
    if label in S.private and os.environ.get("OFFLOAD_ALLOW_PLAINTEXT") != "1":
        if not (v and v.encrypted and v.owners):
            return "private data needs an encrypted volume with ownership on (see 'offload plan')"
    st = os.statvfs(path)
    total, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize - S.reserved.get(path, 0)
    if free - size < total * S.headroom // 100:
        return f"would leave less than {S.headroom}% free ({human(max(free, 0))} free, needs {human(size)})"
    return ""


def try_pick(tier: str, size: int, label: str) -> tuple:
    """(first drive of the tier that can take the move, or '', reasons the others cannot). Reserves on success."""
    why = []
    for path in candidates(tier):
        reason = ineligible(path, size, label)
        if not reason:
            S.reserved[path] = S.reserved.get(path, 0) + size
            return path, why
        why.append(f"{path}: {reason}")
    return "", why or [f"OFFLOAD_{tier} not set"]


def pick_dest(tier: str, size: int, label: str) -> str:
    path, why = try_pick(tier, size, label)
    if not path:
        die(f"No {tier} drive can take {label} ({human(size)}): " + "; ".join(why))
    return path


def benchmark_read(mount: str) -> str:
    """Rough 1 GB sequential read; the probe file stays so a rerun is comparable."""
    probe = os.path.join(mount, ".offload-benchmark-probe-1g")
    if not os.path.isfile(probe):
        if subprocess.run(["dd", "if=/dev/zero", f"of={probe}", "bs=1m", "count=1024"],
                          capture_output=True).returncode != 0:
            return "n/a (write failed)"
    out = subprocess.run(["dd", f"if={probe}", "of=/dev/null", "bs=1m", "count=1024"],
                         capture_output=True, text=True).stderr
    m = re.search(r"\((\d+) bytes/sec\)", out)
    return f"{int(m.group(1)) // 1000000} MB/s" if m else "n/a"


def yes_no(value: Optional[bool], yes: str = "yes", no: str = "no") -> str:
    return "-" if value is None else yes if value else no


def cmd_drives(_args: list) -> None:
    row = "{:<26} {:<6} {:<4} {:<4} {:>8} {:>5}  {:<8} {:<6} {:<4} {:<9}{}  {}"
    speed_head = "  SPEED" if S.benchmark else ""
    print(row.format("DRIVE", "FS", "SSD", "PROT", "FREE", "FREE%", "BACKUP", "OWNERS", "ENC", "ROLE", speed_head, "REASON"))
    print(row.format("-----", "--", "---", "----", "----", "-----", "------", "------", "---", "----",
                     "  -----" if S.benchmark else "", "------"))
    detected = {"HOT": "", "COLD": ""}
    for v in inventory():
        name = os.path.basename(v.mount)
        name = name if len(name) <= 26 else name[:25] + "…"
        fs = {"apfs": "APFS", "hfs": "HFS+", "exfat": "ExFAT", "msdos": "FAT"}.get(v.fs, v.fs[:6])
        pct = f"{100 * v.free // v.size}%" if v.size else "-"
        speed = ("  -" if v.role == "EXCLUDED" else f"  {benchmark_read(v.mount)}") if S.benchmark else ""
        proto = {"Thunderbolt": "TB"}.get(v.protocol, v.protocol[:4])
        print(row.format(name, fs, yes_no(v.ssd), proto, human(v.free), pct, v.backup,
                         yes_no(v.owners, "on", "off"), yes_no(v.encrypted), v.role, speed, v.reason))
        if v.role in detected and not detected[v.role]:
            detected[v.role] = v.mount
    print()
    print("Detected:")
    print(f'  OFFLOAD_HOT="{detected["HOT"] or "<none>"}"')
    print(f'  OFFLOAD_COLD="{detected["COLD"] or "<none>"}"')
    print()
    print(f"Current config ({S.conf}):")
    if os.path.isfile(S.conf):
        for key, value, found, pad in (("OFFLOAD_HOT", S.hot, detected["HOT"], "   "),
                                       ("OFFLOAD_COLD", S.cold, detected["COLD"], "  ")):
            if value:
                verdict = "✓ matches" if value == found else "✗ differs from detection"
                print(f'  {key}="{value}"{pad}{verdict}')
            else:
                print(f"  {key} not set")
        if S.drives:
            print("  OFFLOAD_DRIVES=(" + " ".join(f'"{d}"' for d in S.drives) + ")")
    else:
        print("  (config file not found — using built-in defaults)")
    missing = [k for k, value in (("HOT", S.hot), ("COLD", S.cold)) if detected[k] and value != detected[k]]
    if missing:
        print()
        print(f"To persist detection, append to {S.conf}:")
        for key in missing:
            print(f"  echo 'OFFLOAD_{key}=\"{detected[key]}\"' >> {S.conf}")
    configured = {p.rstrip("/") for p in [S.hot, S.cold] + S.drives if p}
    others = [v.mount for v in inventory() if v.role in ("HOT", "COLD") and v.mount not in configured]
    if others:
        print()
        print("Other drives that could take moves (opt in; --apply only writes to configured drives):")
        print("  OFFLOAD_DRIVES+=(" + " ".join(f'"{m}"' for m in others) + ")")
    print()
    print("BACKUP: TM = Time Machine includes it; BB = Backblaze backs it up; TM dest = the backup disk itself.")
    print("Private data (" + ", ".join(S.private) + ") only goes to an encrypted volume with ownership on.")
    if S.benchmark:
        print("\nSPEED column is a rough 1 GB read against each drive. macOS lacks\n"
              "a userspace cache-bypass, so absolute MB/s can be inflated by the\n"
              "page cache — trust the *relative* ordering of drives, not absolute\n"
              "numbers. Probe files (.offload-benchmark-probe-1g) are left on each\n"
              "drive so a second run is reproducible; delete them when you're done.")


# ----------------------------------------------------------------------------
# repos — cold git clones: the remote is the archive, a bundle is the insurance
# ----------------------------------------------------------------------------

REPO_COLD_DAYS = int(os.environ.get("OFFLOAD_REPO_COLD_DAYS", "90"))
REPO_IGNORED_OK = {".DS_Store"}          # ignored files that never matter, beside SWEEP_DIRNAMES


class Repo(NamedTuple):
    path: str
    rel: str
    days: int
    verdict: str        # keep | synced | reclone | move
    reason: str


def git(repo: str, *args: str, network: bool = False) -> subprocess.CompletedProcess:
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_OPTIONAL_LOCKS="0")
    if network:
        env["GIT_SSH_COMMAND"] = "ssh -o BatchMode=yes"
    return subprocess.run(["git", "--no-optional-locks", "-C", repo, *args], capture_output=True, text=True,
                          env=env, timeout=120 if network else 60)


def repo_sources() -> List[str]:
    """Folders other targets own inside the repo roots (Clones is merged, not recloned)."""
    return [t.source for t in iter_targets() if t.strategy == "merge"]


def repo_find(root: str) -> List[str]:
    """Git working trees under root; never descends into a repo, build cruft, hidden or linked folders."""
    found, skip = [], set(repo_sources())
    for here, dirs, _files in os.walk(root):
        if here in skip:
            dirs[:] = []
            continue
        if os.path.lexists(os.path.join(here, ".git")) and here != root:
            found.append(here)
            dirs[:] = []
            continue
        dirs[:] = [d for d in dirs if not d.startswith(".") and d not in SWEEP_DIRNAMES
                   and not os.path.islink(os.path.join(here, d))]
    return sorted(found)


def repo_age_days(path: str) -> int:
    """Days since HEAD last moved (commit, checkout, reset, pull): the reflog's mtime, else HEAD's commit date.
    Not the index: any plain `git status`, by an IDE or a scanner, rewrites it and makes every repo look fresh."""
    try:
        stamp = os.stat(os.path.join(path, ".git", "logs", "HEAD")).st_mtime
    except OSError:
        out = git(path, "log", "-1", "--format=%ct").stdout.strip()
        if not out.isdigit():
            return 10 ** 6
        stamp = float(out)
    return int((time.time() - stamp) / 86400)


def sync_ancestor(path: str, root: str) -> str:
    """The sync app whose folder holds path (checked from path up to root's parent), else ''.
    Syncthing counts only by .stfolder, its live-folder marker: a .stignore outlives the folder it served."""
    here = path
    markers = {m: app for m, app in SYNC_MARKERS.items() if m != ".stignore"}
    while True:
        for marker, app in markers.items():
            if os.path.lexists(os.path.join(here, marker)):
                return app
        if here in (os.path.dirname(root), "/") or not here.startswith(os.path.dirname(root)):
            return ""
        here = os.path.dirname(here)


def repo_unsafe(path: str) -> str:
    """Why removing this clone could lose something the remote does not have; '' when it is safe."""
    gitdir = os.path.join(path, ".git")
    if not os.path.isdir(gitdir):
        return "a .git file (worktree or submodule checkout)"
    if not git(path, "remote").stdout.strip():
        return "no remote"
    status = git(path, "status", "--porcelain", "--ignored").stdout.splitlines()
    changed = [line for line in status if not line.startswith("!!")]
    if changed:
        return f"uncommitted changes ({len(changed)})"
    ignored = [line[3:].rstrip("/") for line in status if line.startswith("!!")]
    stray = [p for p in ignored if p.split("/")[0] not in SWEEP_DIRNAMES and os.path.basename(p) not in REPO_IGNORED_OK]
    if stray:
        return "ignored files the remote lacks: " + ", ".join(stray[:3]) + ("…" if len(stray) > 3 else "")
    unpushed = git(path, "log", "--branches", "--not", "--remotes", "--oneline").stdout.splitlines()
    if unpushed:
        return f"unpushed commits ({len(unpushed)})"
    if git(path, "stash", "list").stdout.strip():
        return "a stash"
    if os.path.exists(os.path.join(path, ".gitmodules")):
        return "submodules"
    if os.path.isdir(os.path.join(gitdir, "worktrees")) and os.listdir(os.path.join(gitdir, "worktrees")):
        return "extra worktrees"
    lfs = os.path.join(gitdir, "lfs", "objects")
    if os.path.isdir(lfs) and os.listdir(lfs):
        return "Git LFS objects"
    hooks = os.path.join(gitdir, "hooks")
    if os.path.isdir(hooks) and [h for h in os.listdir(hooks) if not h.endswith(".sample")]:
        return "custom hooks"
    return ""


def repo_keep_listed(rel: str) -> bool:
    import fnmatch
    keep = S.extra.get("OFFLOAD_REPO_KEEP", [])
    return any(fnmatch.fnmatch(rel, k) or fnmatch.fnmatch(os.path.basename(rel), k) for k in keep)


def classify_repo(path: str, root: str) -> Repo:
    rel, days = os.path.relpath(path, root), repo_age_days(path)
    if repo_keep_listed(rel):
        return Repo(path, rel, days, "keep", "in OFFLOAD_REPO_KEEP")
    if days < REPO_COLD_DAYS:
        return Repo(path, rel, days, "keep", f"active {days} d ago")
    app = sync_ancestor(path, root)
    if app and not S.synced_ok:
        return Repo(path, rel, days, "synced", f"inside a {app} folder: removing it removes it everywhere (--synced-ok)")
    unsafe = repo_unsafe(path)
    if unsafe.startswith("uncommitted changes"):
        edited = recent_edit_days(path)
        if edited < REPO_COLD_DAYS:
            return Repo(path, rel, edited, "keep", f"uncommitted edits {edited} d ago")
    if unsafe:
        return Repo(path, rel, days, "move", unsafe)
    return Repo(path, rel, days, "reclone", "clean and pushed (as of the last fetch)")


def recent_edit_days(path: str) -> int:
    """Days since the newest uncommitted change in the working tree was written."""
    newest = 0.0
    for line in git(path, "status", "--porcelain").stdout.splitlines():
        name = line[3:].split(" -> ")[-1].strip('"')
        try:
            newest = max(newest, os.lstat(os.path.join(path, name)).st_mtime)
        except OSError:
            pass
    return int((time.time() - newest) / 86400) if newest else 10 ** 6


def repos_target() -> Optional[Target]:
    return next((t for t in iter_targets(drives=False) if t.strategy == "repos"), None)


def manifest_path() -> str:
    return os.path.join(os.path.dirname(S.conf), "reclone.tsv")


def remote_holds_every_tip(path: str) -> str:
    """'' when every local branch tip and HEAD are on the remote right now; else why not."""
    remote = git(path, "remote").stdout.split()[0]
    listing = git(path, "ls-remote", remote, network=True)
    if listing.returncode != 0:
        return f"could not reach the remote ({(listing.stderr.strip().splitlines() or ['?'])[-1]})"
    remote_tips = {line.split()[0] for line in listing.stdout.splitlines() if line.strip()}
    local = git(path, "for-each-ref", "--format=%(objectname)", "refs/heads").stdout.split()
    local.append(git(path, "rev-parse", "HEAD").stdout.strip())
    for sha in filter(None, set(local)):
        if sha in remote_tips:
            continue
        held = any(git(path, "cat-file", "-e", tip).returncode == 0
                   and git(path, "merge-base", "--is-ancestor", sha, tip).returncode == 0 for tip in remote_tips)
        if not held:
            return f"commit {sha[:12]} is not on the remote"
    return ""


def append_manifest(dest_root: Optional[str], row: list) -> None:
    """One line in the local manifest, and a copy beside the data when it sits on a drive."""
    line = "\t".join(row) + "\n"
    for path in [manifest_path()] + ([os.path.join(dest_root, "reclone.tsv")] if dest_root else []):
        if S.dry:
            log(f"  WOULD RECORD in {path}: {line.strip()}")
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a") as f:
            f.write(line)


def copy_verify(src: str, dst: str) -> None:
    """rsync src to a new dst and compare file count + bytes; raise on mismatch, keep the source."""
    if os.path.lexists(dst):
        conflict(f"Destination {dst} exists — manual review required")
    run(["mkdir", "-p", os.path.dirname(dst)])
    run(["rsync", "-a", f"{src}/", f"{dst}/"])
    if not S.dry:
        s, d = tree_signature(src), tree_signature(dst)
        log(f"  Verify: src={s} dst={d}")
        if s != d:
            die(f"Signature mismatch for {src} — source preserved")


def strategy_repos(root: str, raw_dest: str, label: str) -> None:
    log(f"=== {label} (strategy=repos) ===")
    if not os.path.isdir(root):
        log(f"  SKIP: {root} missing")
        return
    tier, rest = split_tier(raw_dest)
    for r in (classify_repo(p, root) for p in repo_find(root)):
        if r.verdict not in ("reclone", "move"):
            continue
        log(f"--- {r.rel}: {r.verdict} ({r.reason}) ---")
        if r.verdict == "reclone" and not S.dry:
            missing = remote_holds_every_tip(r.path)
            if missing:
                warn(f"  {r.rel}: {missing}; copying the whole folder instead")
                r = r._replace(verdict="move", reason=missing)
        vol = pick_dest(tier or "COLD", du_bytes(r.path), label)
        dest_root = f"{vol}/{rest}"
        if r.verdict == "reclone":
            remote = git(r.path, "remote").stdout.split()[0]
            url = git(r.path, "remote", "get-url", remote).stdout.strip()
            branch = git(r.path, "branch", "--show-current").stdout.strip()
            sha = git(r.path, "rev-parse", "HEAD").stdout.strip()
            bundle = f"{dest_root}/{r.rel}.bundle"
            if os.path.lexists(bundle):
                conflict(f"Bundle {bundle} exists — manual review required")
            run(["mkdir", "-p", os.path.dirname(bundle)])
            run(["git", "-C", r.path, "bundle", "create", bundle, "--all"])
            run(["git", "-C", r.path, "bundle", "verify", bundle])
            append_manifest(dest_root, [S.date_tag, "reclone", r.path, url, branch, sha, bundle])
        else:
            copy_verify(r.path, f"{dest_root}/{r.rel}")
            append_manifest(dest_root, [S.date_tag, "moved", r.path, "", "", "", f"{dest_root}/{r.rel}"])
        run(["rm", "-rf", r.path])
        log(f"  DONE: {r.path} ({r.verdict})")


def cmd_repos(args: list) -> None:
    S.synced_ok = "--synced-ok" in args
    t = repos_target()
    if not t:
        die("no repos target in OFFLOAD_TARGETS")
    root = t.source
    if not os.path.isdir(root):
        die(f"{root} does not exist")
    rows = [classify_repo(p, root) for p in repo_find(root)]
    line = "{:<8} {:>6}  {:>8}  {:<44} {}"
    print(line.format("VERDICT", "AGE", "SIZE", "REPO", "REASON"))
    order = {"reclone": 0, "move": 1, "synced": 2, "keep": 3}
    totals: dict = {}
    for r in sorted(rows, key=lambda r: (order[r.verdict], -r.days, r.rel)):
        size = du_bytes(r.path) if r.verdict in ("reclone", "move") else 0
        totals[r.verdict] = totals.get(r.verdict, [0, 0])
        totals[r.verdict][0] += 1
        totals[r.verdict][1] += size
        age = "never" if r.days >= 10 ** 6 else drain_age(r.days)
        print(line.format(r.verdict, age, human(size) if size else "-", r.rel[:44], r.reason))
    print()
    print("  " + " · ".join(f"{v}: {totals[v][0]}" + (f" ({human(totals[v][1])})" if totals[v][1] else "")
                            for v in order if v in totals))
    print(f"  Cold means untouched for {REPO_COLD_DAYS} days. Verdicts use the last fetch; --apply re-checks "
          "the remote before it removes anything.")
    print(f"  Next: offload move {t.label}            # dry run; then add --apply")


def cmd_reclone(args: list) -> None:
    if not args or args[0] == "--apply":
        die("usage: offload reclone <path>|all [--apply]")
    S.dry = "--apply" not in args
    want = args[0]
    if not os.path.isfile(manifest_path()):
        die(f"no manifest at {manifest_path()}: nothing was recloned or moved from here")
    entries = [line.rstrip("\n").split("\t") for line in open(manifest_path()) if line.strip()]
    chosen = [e for e in entries if len(e) == 7 and (want == "all" or os.path.abspath(want) == e[2])]
    if not chosen:
        die(f"'{want}' is not in {manifest_path()}")
    log(f"offload v{VERSION} reclone  {want}  mode={mode()}")
    for _date, kind, path, url, branch, sha, copy in chosen:
        log(f"=== {path} ({kind}) ===")
        if os.path.lexists(path):
            log(f"  SKIP: {path} is already there")
            continue
        if kind == "moved":
            copy_verify(copy, path)
            run(["rm", "-rf", copy])
            continue
        source = url
        if not S.dry and git(os.path.dirname(path) or "/", "ls-remote", url, network=True).returncode != 0:
            warn(f"  the remote {url} does not answer; restoring from the bundle {copy}")
            source = copy
        run(["git", "clone", source, path])
        if source != url:
            run(["git", "-C", path, "remote", "set-url", "origin", url])
        if branch:
            run(["git", "-C", path, "checkout", branch])
        if not S.dry:
            head = git(path, "rev-parse", "HEAD").stdout.strip()
            if head != sha:
                warn(f"  {path}: HEAD is {head[:12]}, the recorded commit was {sha[:12]} (the branch moved on)")
        log(f"  DONE: {path} restored from {'the remote' if source == url else 'the bundle'}")


# ----------------------------------------------------------------------------
# cloud — opt-in archive to a remote the team approved (rclone); never by default
# ----------------------------------------------------------------------------
# A row whose destination starts with CLOUD/ goes to the first rclone remote in
# OFFLOAD_APPROVED_REMOTES, and only when the run says both --apply and --upload.
# Order: copy, check (cryptcheck for crypt remotes), record, then remove the source.

def rclone_remote_types() -> dict:
    """Configured rclone remotes -> type, from `rclone listremotes --long` (reads local config only)."""
    types = {}
    for line in capture(["rclone", "listremotes", "--long"]).splitlines():
        if ":" in line:
            name, kind = line.split(":", 1)
            types[name.strip() + ":"] = kind.strip()
    return types


def cloud_dest(rest: str, label: str) -> tuple:
    """(remote, full destination, crypt?) for a CLOUD/ row; dies unless the remote is approved and fit."""
    if not S.approved_remotes:
        die("CLOUD/ needs OFFLOAD_APPROVED_REMOTES in offload.conf: the rclone remotes your team approved")
    if not shutil.which("rclone"):
        die("rclone is not installed: brew install rclone")
    remote = S.approved_remotes[0]
    name = remote.split(":", 1)[0] + ":"
    kind = rclone_remote_types().get(name)
    if kind is None:
        die(f"{name} is approved but not configured in rclone (rclone config)")
    if label in S.private and kind != "crypt":
        die(f"{label} is private: it may only go to a crypt remote, and {name} is '{kind}'")
    base = remote if remote.endswith((":", "/")) else remote + "/"
    return name, base + rest, kind == "crypt"


def strategy_cloud(src: str, raw_dest: str, label: str) -> None:
    log(f"=== {label} (strategy=cloud) ===")
    if not os.path.isdir(src):
        log(f"  SKIP: {src} missing")
        return
    if is_empty_dir(src):
        log(f"  SKIP: {src} is empty")
        return
    _, rest = split_tier(raw_dest)
    remote, dest, crypt = cloud_dest(rest, label)
    if not S.dry and not S.upload:
        die("uploading needs --upload as well as --apply (data leaves this machine)")
    if S.dry:
        log(f"  WOULD UPLOAD {human(du_bytes(src))} to {dest} (approved remote {remote}); nothing leaves without --apply --upload")
        return
    run(["rclone", "copy", src, dest])
    run(["rclone", "cryptcheck" if crypt else "check", src, dest])
    append_manifest(None, [S.date_tag, "cloud", src, dest, "", "", remote])
    run(["rm", "-rf", src])
    run(["mkdir", "-p", src])
    log(f"  DONE: {src} archived to {dest} (source recreated empty)")


def cmd_restore(args: list) -> None:
    if not args or args[0] == "--apply":
        die("usage: offload restore <Label|path> [--apply]")
    S.dry = "--apply" not in args
    want = args[0]
    label_src = {t.label: t.source for t in iter_targets()}.get(want, os.path.abspath(want))
    if not os.path.isfile(manifest_path()):
        die(f"no manifest at {manifest_path()}: nothing was archived to the cloud from here")
    entries = [line.rstrip("\n").split("\t") for line in open(manifest_path()) if line.strip()]
    chosen = [e for e in entries if len(e) == 7 and e[1] == "cloud" and e[2] == label_src]
    if not chosen:
        die(f"'{want}' has no cloud archive in {manifest_path()}")
    _date, _kind, src, dest, _b, _s, remote = chosen[-1]
    crypt = rclone_remote_types().get(remote) == "crypt" if shutil.which("rclone") else False
    log(f"offload v{VERSION} restore  {want}  from {dest}  mode={mode()}")
    run(["mkdir", "-p", src])
    run(["rclone", "copy", dest, src])
    run(["rclone", "cryptcheck" if crypt else "check", src, dest])
    log(f"  DONE: {src} restored; the cloud copy stays at {dest}")


