LIST_ROW = "{:<16} {:<10} {:<9} {:<7} {:<10} {}"


def cmd_list_one() -> int:
    print(LIST_ROW.format("LABEL", "CATEGORY", "STRATEGY", "ADMIN", "RECLAIM", "STATE"))
    print(LIST_ROW.format("----", "--------", "--------", "-----", "-------", "-----"))
    prev, total, unreadable = "", 0, 0
    for t in iter_targets():
        if prev and t.category != prev:
            print()
        prev = t.category
        state, size = row_state(t), row_bytes(t)
        total += size
        unreadable += state.startswith("unreadable")
        print(LIST_ROW.format(t.label, t.category, t.strategy, t.admin, human(size) if size else "-", state))
    print()
    print(f"Potential reclaim from offloading remaining items: {human(total)}")
    if unreadable and S.target_home.rstrip("/") != S.home.rstrip("/"):
        print()
        print(f"Note: {unreadable} row(s) marked 'unreadable' — POSIX permissions block")
        print(f"      this account from reading {S.target_home}. For a full audit:")
        print(f"        sudo offload --target-home {S.target_home} list")
    return total


def real_users() -> List[str]:
    out = subprocess.run(["dscl", ".", "-list", "/Users", "UniqueID"], capture_output=True, text=True).stdout
    users = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1].isdigit() and 500 <= int(parts[1]) < 10000 and not parts[0].startswith("_"):
            users.append(parts[0])
    return users


def cmd_list(_args: list) -> None:
    if not S.all_users:
        cmd_list_one()
        return
    users = real_users()
    if not users:
        die("no real users found (dscl returned nothing)")
    grand, bar = 0, "═" * 56
    for user in users:
        if not os.path.isdir(f"/Users/{user}"):
            continue
        S.target_home = f"/Users/{user}"
        print(bar)
        print(f"  /Users/{user}   (TARGET_HOME={S.target_home})")
        print(bar)
        grand += cmd_list_one()
        print()
    print("═" * 59)
    print(f"GRAND TOTAL potential reclaim across all users: {human(grand)}")
    print("═" * 59)


