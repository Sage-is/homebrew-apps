#!/usr/bin/env bash
# offload(1) — poka-yoke disk offload tool for macOS
#
# NAME
#   offload — move user data to external drives via symlinks, safely
#
# SYNOPSIS
#   offload [--target-home <path>] <subcommand> [args...] [--apply]
#
# DESCRIPTION
#   offload moves heavy, low-velocity data out of $HOME onto an
#   external drive. The home folder itself stays internal — we move
#   the *contents* of specific paths inside $HOME and replace each
#   with a symlink (or, for archive targets, leave a fresh empty
#   directory). This is the supported pattern: iCloud, FileVault,
#   login, and macOS updates remain untouched.
#
#   A guard launcher refuses to start an app whose data lives on an
#   unmounted volume. Dry-run is the default; --apply must be
#   explicit. Cross-volume moves verify (file count + bytes) before
#   deleting source. Re-running is idempotent.
#
# SUBCOMMANDS
#   help                print this text (script header is single source of truth)
#   version             print the script version
#   status              disk free + recent log + admin todo
#   list                every entry in OFFLOAD_TARGETS with its current state
#   checklist           generated progress checklist (live from OFFLOAD_TARGETS)
#   launch <App>        guarded launch (refuses if symlink target unmounted)
#   move <Label> [--apply]                       offload one entry by label
#   move <category> [--apply]                    offload every entry in a category
#   relocations (alias: media-libraries)         print native-UI relocation
#                                                steps — Docker, Photos,
#                                                Music.app, iMovie
#   protected <Label> [--apply]                  alias for `move <Label>` that
#                                                requires --target-home + FDA
#
# DATA MODEL — OFFLOAD_TARGETS
#   Every relocatable thing is a row in OFFLOAD_TARGETS. Every
#   subcommand reads from this list; there is no parallel hardcoded
#   knowledge. Schema (pipe-delimited):
#
#     label | category | source | dest | strategy | admin? | bundle
#
#   Tokens expanded at runtime:
#     <TH>    -> $TARGET_HOME       (current user's $HOME by default)
#     <U>     -> $(basename "$TARGET_HOME")
#     <DATE>  -> YYYY-MM-DD
#     HOT/    -> $OFFLOAD_HOT/
#     COLD/   -> $OFFLOAD_COLD/
#
#   Strategies:
#     symlink     — rsync to dest, verify, rm source, ln -s dest source
#     archive     — rsync to dest, rm source, recreate empty source dir
#                   (no symlink; fresh empty target for new arrivals)
#     merge       — rsync --update into existing dest, rm source
#                   (dest is authoritative; source is gone)
#     sweep       — find subdirs matching internal patterns and delete
#                   (no destination; data is rebuildable from source code)
#     purge       — delete the entire source dir, recreate empty. For
#                   caches and rebuild-on-demand support files (iOS
#                   DeviceSupport, ~/.cache, ~/.npm, Homebrew cache,
#                   simulator runtimes/caches). Apps re-populate.
#     native-ui   — printed instructions only; the tool never auto-mutates
#                   media libraries (Photos, Music.app, iMovie) because
#                   those apps have safer native "Choose Library" UIs
#
#   Categories: app | home | cold | merge | dev | cache | sweep | protected | vm | media-lib
#
# OPTIONS
#   --target-home <path>   work on a different user's home (Admin mode).
#                          Defaults to $HOME. When set to a different user's
#                          home, admin-mode invariants apply for move/protected:
#                          caller must NOT be the target user, must be in the
#                          admin group, and (for protected targets) the
#                          Terminal must have Full Disk Access. `list` honors
#                          --target-home without admin gating (read-only).
#   --all-users            (list only) iterate every real macOS user account
#                          (UID >= 500, non-underscore-prefixed) and show
#                          each user's offload state plus a grand-total
#                          reclaim. Useful for the Admin account auditing
#                          which homes still have movable data. To see
#                          actual sizes for other users (not "unreadable"),
#                          run under sudo:
#                            sudo offload list --all-users
#                          List is read-only; running it under sudo does
#                          not violate the "never sudo from inside" rule.
#   --apply                actually mutate. Without it, every move is a
#                          dry-run that prints intent only.
#
# CONFIGURATION
#   Drive paths come from environment variables OFFLOAD_HOT and
#   OFFLOAD_COLD, or from a config file at
#   ${XDG_CONFIG_HOME:-$HOME/.config}/offload/offload.conf .
#   The config file is a sourced shell snippet:
#
#     OFFLOAD_HOT=/Volumes/MyFastSSD
#     OFFLOAD_COLD=/Volumes/MyArchiveHDD
#     # optional: extend or replace OFFLOAD_TARGETS
#     OFFLOAD_TARGETS+=(
#       "MyCustomApp|app|<TH>/Library/Application Support/Custom|HOT/MovedAppData/<U>/Custom|symlink|no|MyCustomApp"
#     )
#
# DESIGN — Poka-Yoke Discipline
#   1. Single source of truth. OFFLOAD_TARGETS is the only list.
#      Every subcommand (list, checklist, launch, move, protected,
#      media-libraries) reads from it. No duplicated knowledge.
#
#   2. Dry-run by default. Mutation requires --apply. There is no
#      destructive default and no "yes-to-all" alias.
#
#   3. Verify before delete. Cross-volume moves rsync to destination,
#      compare file count + total bytes against source, remove
#      source only on signature match.
#
#   4. Idempotent. Re-running on an already-symlinked source skips.
#      An existing destination is never silently overwritten.
#
#   5. Never sudo from inside. EACCES failures append to
#      ~/offload-admin-todo.txt; a reviewable sudo-wrapper is
#      emitted at ~/bin/offload-admin-pass for manual execution.
#
#   6. Two-account workflow. Protected targets require a separate
#      macOS Admin account whose Terminal has Full Disk Access.
#      Admin-mode is selected via --target-home pointing at a
#      different user's home.
#
#   7. Guard launcher. 'offload launch' checks the symlink target
#      before opening the app.
#
#   DOES NOT
#   The tool deliberately does NOT do any of these things:
#
#   - Relocate $HOME via `dscl . -change NFSHomeDirectory ...`.
#     That changes the home-folder pointer in Directory Services
#     and breaks iCloud Drive (which refuses to sync if $HOME is
#     not on internal APFS), confuses FileVault login, and has been
#     broken by macOS updates repeatedly. We move *contents*, not
#     the pointer.
#
#   - Symlink Apple sandbox containers (~/Library/Containers/com.apple.*).
#     The sandbox kit resolves the real path and refuses if it is
#     outside the container. Mail, Messages.app's Container (not
#     the archive), Notes, etc. are excluded.
#
#   - Symlink browser profiles. Chrome, Firefox, Brave, and Zen
#     do constant SQLite writes; corruption under symlinks is
#     common.
#
#   - Move media libraries (Photos / Music.app / iMovie / Final Cut)
#     via symlinks. Those apps have safer native "Choose Library"
#     UIs. Use 'offload media-libraries' for the steps.
#
# EXAMPLES
#   First-time setup:
#     mkdir -p ~/.config/offload
#     cat > ~/.config/offload/offload.conf <<'EOF'
#     OFFLOAD_HOT=/Volumes/MyFastSSD
#     OFFLOAD_COLD=/Volumes/MyArchiveHDD
#     EOF
#
#   Inspect:
#     offload status
#     offload list           # everything offload knows about
#     offload checklist      # live progress checklist
#
#   Safe first sweep (build cruft, fully reversible by rebuild):
#     offload move BuildCruft
#     offload move BuildCruft --apply
#
#   Move one specific app:
#     offload move Signal --apply
#
#   Move every entry in a category:
#     offload move app --apply        # all Application Support entries
#     offload move home --apply       # ~/Movies + ~/Music
#
#   Guarded launch:
#     offload launch Signal
#
#   Media libraries (manual, native UI):
#     offload media-libraries
#
#   Admin running on another user's home (Admin account, FDA on Terminal):
#     offload protected --target-home /Users/alice Messages --apply
#     offload --target-home /Users/alice move Signal --apply
#
# FILES
#   ${XDG_CONFIG_HOME:-~/.config}/offload/offload.conf   user config
#   ~/offload-YYYY-MM-DD.log                             per-run log
#   ~/offload-admin-todo.txt                             EACCES paths
#   ~/bin/offload-admin-pass                             emitted sudo-review script
#
# EXIT STATUS
#   0   success
#   1   invariant violation, invalid input, or fatal error
#   2   destination conflict (manual review required)
#
# SEE ALSO
#   rsync(1), tmutil(8), ln(1), launchctl(1)
#
# AUTHOR
#   Sage-is/homebrew-apps tap. Issues:
#   https://github.com/Sage-is/homebrew-apps/issues

set -euo pipefail

VERSION="0.5.0"

# ----------------------------------------------------------------------------
# Defaults
# ----------------------------------------------------------------------------

OFFLOAD_CONF="${OFFLOAD_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/offload/offload.conf}"

OFFLOAD_HOT="${OFFLOAD_HOT:-}"
OFFLOAD_COLD="${OFFLOAD_COLD:-}"

# Built-in default OFFLOAD_TARGETS.
# Schema: label|category|source|dest|strategy|admin?|bundle
# Tokens: <TH>=$TARGET_HOME, <U>=target user, <DATE>=YYYY-MM-DD
#         HOT/ and COLD/ prefix the destination with $OFFLOAD_HOT / $OFFLOAD_COLD
DEFAULT_OFFLOAD_TARGETS=(
  # --- Application Support symlinks --------------------------------------
  "Signal|app|<TH>/Library/Application Support/Signal|HOT/MovedAppData/<U>/Signal|symlink|no|Signal"
  "Obsidian|app|<TH>/Library/Application Support/obsidian|HOT/MovedAppData/<U>/Obsidian|symlink|no|Obsidian"
  "Steam|app|<TH>/Library/Application Support/Steam|HOT/MovedAppData/<U>/Steam|symlink|no|Steam"
  "Keybase|app|<TH>/Library/Application Support/Keybase|HOT/MovedAppData/<U>/Keybase|symlink|no|Keybase"
  "Minecraft|app|<TH>/Library/Application Support/minecraft|HOT/MovedAppData/<U>/Minecraft|symlink|no|Minecraft"
  "VSCode|app|<TH>/Library/Application Support/Code|HOT/MovedAppData/<U>/VSCode|symlink|no|Visual Studio Code"
  "Epic|app|<TH>/Library/Application Support/Epic|HOT/MovedAppData/<U>/Epic|symlink|no|Epic Games Launcher"
  "Cursor|app|<TH>/Library/Application Support/Cursor|HOT/MovedAppData/<U>/Cursor|symlink|no|Cursor"

  # --- Home subdirectories (move contents, leave $HOME pointer alone) ----
  "Movies|home|<TH>/Movies|HOT/MovedHome/<U>/Movies|symlink|no|-"
  "Music|home|<TH>/Music|HOT/MovedHome/<U>/Music|symlink|no|-"
  "Pictures|home|<TH>/Pictures|HOT/MovedHome/<U>/Pictures|symlink|no|-"
  "Desktop|home|<TH>/Desktop|HOT/MovedHome/<U>/Desktop|symlink|no|-"

  # --- Hidden home dirs (toolchains and editor data; rebuilds if drive
  # --- gone). All symlink strategy; safe-mount story: tools fail to
  # --- launch cleanly when the dock is unplugged, no data loss. ----------
  "LocalShare|home|<TH>/.local|HOT/MovedHome/<U>/.local|symlink|no|-"
  "Bun|home|<TH>/.bun|HOT/MovedHome/<U>/.bun|symlink|no|-"
  "Pyenv|home|<TH>/.pyenv|HOT/MovedHome/<U>/.pyenv|symlink|no|-"
  "VSCodeUser|home|<TH>/.vscode|HOT/MovedHome/<U>/.vscode|symlink|no|-"
  "VSCodeInsidersUser|home|<TH>/.vscode-insiders|HOT/MovedHome/<U>/.vscode-insiders|symlink|no|-"
  "CursorUser|home|<TH>/.cursor|HOT/MovedHome/<U>/.cursor|symlink|no|-"

  # --- Spitfire Audio sound libraries (often gigabytes; if the user has
  # --- Spitfire installed). Harmless absent for everyone else. -----------
  "Spitfire|home|<TH>/Spitfire|HOT/MovedHome/<U>/Spitfire|symlink|no|-"

  # --- Cold archive (no symlink — fresh empty source) --------------------
  "Downloads|cold|<TH>/Downloads|COLD/Archive/Downloads-<U>-<DATE>|archive|no|-"

  # --- Active merge (rsync --update; source removed; use dest directly) --
  "Clones|merge|<TH>/Documents/Projects/Clones|HOT/Clones|merge|no|-"

  # --- Developer caches ---------------------------------------------------
  "CoreSimulator|dev|<TH>/Library/Developer/CoreSimulator|HOT/MovedAppData/<U>/CoreSimulator|symlink|no|-"

  # --- Build-cruft sweep (delete in place; rebuildable from source) ------
  "BuildCruft|sweep|<TH>/Documents/Projects/GitHub|(in-place delete)|sweep|no|-"

  # --- Purge: delete the source dir, recreate empty. For caches and    --
  # --- rebuild-on-demand support files. Apps re-populate as needed.    --
  "iOS-DeviceSupport|cache|<TH>/Library/Developer/Xcode/iOS DeviceSupport|(in-place purge)|purge|no|-"
  "XcodeDerivedData|cache|<TH>/Library/Developer/Xcode/DerivedData|(in-place purge)|purge|no|-"
  "XcodeArchives|cache|<TH>/Library/Developer/Xcode/Archives|(in-place purge)|purge|no|-"
  "XdgCache|cache|<TH>/.cache|(in-place purge)|purge|no|-"
  "NpmCache|cache|<TH>/.npm|(in-place purge)|purge|no|-"
  "HomebrewCache|cache|<TH>/Library/Caches/Homebrew|(in-place purge)|purge|no|-"

  # --- Protected (Admin account + FDA on Terminal) -----------------------
  "Messages|protected|<TH>/Library/Messages|HOT/MovedProtected/<U>/Messages|symlink|yes|-"
  "iOS-Backups|protected|<TH>/Library/Application Support/MobileSync/Backup|HOT/MovedProtected/<U>/iOS-Backups|symlink|yes|-"

  # --- VM disk image (Docker Desktop manages relocation in its own UI) ---
  "Docker|vm|<TH>/Library/Containers/com.docker.docker|HOT/Docker|native-ui|no|-"

  # --- Media libraries (native UI; tool never auto-moves these) ----------
  "Photos-Library|media-lib|<TH>/Pictures/Photos Library.photoslibrary|HOT/Photos Library.photoslibrary|native-ui|no|-"
  "Music-Library|media-lib|<TH>/Music/Music/Media|HOT/Music Media|native-ui|no|-"
  "iMovie-Library|media-lib|<TH>/Movies/iMovie Library.imovielibrary|HOT/iMovie Library.imovielibrary|native-ui|no|-"
)

# Build-cruft find patterns (used by sweep strategy)
SWEEP_DIRNAMES=(node_modules .venv venv target build dist __pycache__ .next)

OFFLOAD_TARGETS=()

# Source user config if it exists.
if [[ -f "$OFFLOAD_CONF" ]]; then
  # shellcheck disable=SC1090
  source "$OFFLOAD_CONF"
fi

# Fall back to defaults if config didn't populate.
if [[ ${#OFFLOAD_TARGETS[@]} -eq 0 ]]; then
  OFFLOAD_TARGETS=("${DEFAULT_OFFLOAD_TARGETS[@]}")
fi

# Legacy compatibility: if config still uses OFFLOAD_APPS (v0.1.x schema)
# AND nothing in the current OFFLOAD_TARGETS covers a label, append it.
if declare -p OFFLOAD_APPS &>/dev/null; then
  for row in "${OFFLOAD_APPS[@]}"; do
    IFS='|' read -r label src bundle <<<"$row"
    found=0
    for t in "${OFFLOAD_TARGETS[@]}"; do
      [[ "${t%%|*}" == "$label" ]] && { found=1; break; }
    done
    [[ $found -eq 0 ]] && OFFLOAD_TARGETS+=("$label|app|$src|HOT/MovedAppData/<U>/$label|symlink|no|$bundle")
  done
fi

# Runtime state.
TARGET_HOME="$HOME"
DRY=1
LIST_ALL_USERS=0
DATE_TAG="$(date +%Y-%m-%d)"
LOG="$HOME/offload-$DATE_TAG.log"
ADMIN_TODO="$HOME/offload-admin-todo.txt"
ADMIN_PASS="$HOME/bin/offload-admin-pass"

# Set by cmd_list_one for the --all-users caller to grand-total.
LAST_TOTAL_BYTES=0

# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------

log()  { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" | tee -a "$LOG"; }
warn() { printf '[%s] WARN: %s\n' "$(date '+%H:%M:%S')" "$*" | tee -a "$LOG" >&2; }
die()  { printf '[%s] FATAL: %s\n' "$(date '+%H:%M:%S')" "$*" | tee -a "$LOG" >&2; exit 1; }
mode() { [[ $DRY -eq 1 ]] && echo DRY-RUN || echo APPLY; }

target_user() { basename "$TARGET_HOME"; }

# Expand <TH>, <U>, <DATE>, HOT/, COLD/ tokens in a path.
expand_tokens() {
  local s="$1" u; u="$(target_user)"
  s="${s//<TH>/$TARGET_HOME}"
  s="${s//<U>/$u}"
  s="${s//<DATE>/$DATE_TAG}"
  if [[ "$s" == HOT/* ]];  then s="${OFFLOAD_HOT}/${s#HOT/}"; fi
  if [[ "$s" == COLD/* ]]; then s="${OFFLOAD_COLD}/${s#COLD/}"; fi
  echo "$s"
}

# Iterate OFFLOAD_TARGETS, yielding fully-expanded rows.
iter_targets() {
  for row in "${OFFLOAD_TARGETS[@]}"; do
    IFS='|' read -r label cat src dest strat adm bundle <<<"$row"
    src="$(expand_tokens "$src")"
    dest="$(expand_tokens "$dest")"
    printf '%s|%s|%s|%s|%s|%s|%s\n' "$label" "$cat" "$src" "$dest" "$strat" "$adm" "$bundle"
  done
}

require_drive() {
  local var="$1" path="${!1:-}"
  [[ -n "$path" ]] || die "$var not set. Configure $OFFLOAD_CONF or export $var."
  [[ -d "$path" ]] || die "$var not mounted: $path"
}

free_bytes() { df -k "$1" | awk 'NR==2 {print $4 * 1024}'; }
human()      { numfmt --to=iec-i --suffix=B "$1" 2>/dev/null || echo "$1 B"; }

require_free() {
  local p="$1" need="$2"
  # Walk up to the nearest existing ancestor — df can only query existing paths.
  while [[ ! -d "$p" ]]; do p="$(dirname "$p")"; [[ "$p" == "/" ]] && break; done
  local avail; avail="$(free_bytes "$p")"
  (( avail >= need )) || die "Not enough free on $p: have $(human $avail), need $(human $need)"
  log "  OK: $p has $(human $avail) free (need $(human $need))"
}

manual_step() {
  log "  [MANUALLY] $1"
  [[ $DRY -eq 0 && -t 0 ]] && read -r -p "  Press Enter when done (Ctrl-C to abort): "
}

do_run() {
  log "  RUN: $*"
  if [[ $DRY -eq 0 ]]; then
    if ! eval "$@" 2>>"$LOG"; then
      local rc=$?
      if grep -q 'Permission denied' "$LOG" 2>/dev/null; then
        warn "  EACCES — recording for admin pass"
        printf '# from %s\n%s\n' "$(date)" "$*" >> "$ADMIN_TODO"
        return 0
      fi
      die "Command failed (rc=$rc): $*"
    fi
  fi
}

tree_signature() {
  local p="$1"
  [[ -d "$p" ]] || { echo "files=0 bytes=0"; return; }
  local f; f="$(find "$p" -type f 2>/dev/null | wc -l | tr -d ' ')"
  local b; b="$(du -sk "$p" 2>/dev/null | awk '{print $1*1024}')"
  echo "files=$f bytes=$b"
}

assert_admin_invariants() {
  [[ "$TARGET_HOME" == "$HOME" ]] && return 0
  local tu; tu="$(target_user)"
  [[ "$USER" != "$tu" ]] \
    || die "Refusing to operate on $TARGET_HOME as '$USER' — Admin mode requires a separate account."
  id -Gn "$USER" | tr ' ' '\n' | grep -qx admin \
    || die "Current account '$USER' is not in the admin group."
}

assert_fda_granted() {
  local probe="$TARGET_HOME/Library/Messages"
  if [[ -d "$probe" ]]; then
    if ! stat "$probe" >/dev/null 2>&1; then
      die "Cannot stat $probe — this Terminal lacks Full Disk Access.
       Fix: System Settings -> Privacy & Security -> Full Disk Access ->
            add this Terminal, then restart Terminal."
    fi
  fi
}

# ----------------------------------------------------------------------------
# Strategy implementations
# ----------------------------------------------------------------------------

strategy_symlink() {
  local src="$1" dst="$2" label="$3"
  log "=== $label (strategy=symlink) ==="
  if [[ -L "$src" ]]; then
    [[ "$(readlink "$src")" == "$dst" ]] \
      && { log "  SKIP: $src already symlinked to $dst"; return 0; } \
      || die "$src is a symlink to '$(readlink "$src")', not '$dst'"
  fi
  [[ -d "$src" ]] || { log "  SKIP: $src missing"; return 0; }
  [[ -e "$dst" ]] && die "Destination $dst exists — manual review required"

  local need; need="$(du -sk "$src" | awk '{print $1*1024}')"
  require_free "$(dirname "$dst")" "$need"

  log "  Source sig: $(tree_signature "$src")"
  do_run "mkdir -p \"$(dirname "$dst")\""
  do_run "rsync -a \"$src/\" \"$dst/\""

  if [[ $DRY -eq 0 ]]; then
    local s d; s="$(tree_signature "$src")"; d="$(tree_signature "$dst")"
    log "  Verify: src=$s dst=$d"
    [[ "$s" == "$d" ]] || die "Signature mismatch — source preserved"
    do_run "rm -rf \"$src\""
    do_run "ln -s \"$dst\" \"$src\""
    [[ "$TARGET_HOME" != "$HOME" ]] && do_run "chown -R \"$(target_user)\" \"$dst\""
    log "  DONE: $src -> $dst"
  fi
}

strategy_archive() {
  local src="$1" dst="$2" label="$3"
  log "=== $label (strategy=archive) ==="
  [[ -d "$src" ]] || { log "  SKIP: $src missing"; return 0; }
  if [[ "$label" == "Downloads" && -n "$OFFLOAD_HOT" && -d "$OFFLOAD_HOT" ]]; then
    local roms_dst="$OFFLOAD_HOT/ROMs"
    local roms=()
    while IFS= read -r f; do roms+=("$f"); done < <(
      find "$src" -maxdepth 1 -type f -name '*.zip' \
        \( -iname '*Mario*' -o -iname '*Zelda*' -o -iname '*Pokemon*' \
           -o -iname '*Sonic*' -o -iname '*Metroid*' -o -iname '*Kirby*' \
           -o -iname '*GameCube*' -o -iname '*Nintendo*' \) 2>/dev/null
    )
    if (( ${#roms[@]} > 0 )); then
      log "  Pre-filter: ${#roms[@]} ROM zip(s) -> $roms_dst"
      do_run "mkdir -p \"$roms_dst\""
      for f in "${roms[@]}"; do
        local base; base="$(basename "$f")"
        [[ -e "$roms_dst/$base" ]] && { warn "    SKIP duplicate: $base"; continue; }
        do_run "mv -n \"$f\" \"$roms_dst/\""
      done
    fi
  fi
  do_run "mkdir -p \"$dst\""
  do_run "rsync -a --remove-source-files \"$src/\" \"$dst/\""
  do_run "find \"$src\" -type d -empty -delete"
  do_run "mkdir -p \"$src\""
  log "  DONE: $src archived to $dst (source recreated empty)"
}

strategy_merge() {
  local src="$1" dst="$2" label="$3"
  log "=== $label (strategy=merge --update) ==="
  [[ -d "$src" ]] || { log "  SKIP: $src missing"; return 0; }
  [[ -d "$dst" ]] || die "$dst must already exist (merge target)"
  do_run "rsync -av --update \"$src/\" \"$dst/\""
  if [[ $DRY -eq 0 ]]; then
    local sc dc
    sc="$(find "$src" -type f | wc -l | tr -d ' ')"
    dc="$(find "$dst" -type f | wc -l | tr -d ' ')"
    (( dc >= sc )) || die "Dest has $dc files, src had $sc — incomplete"
    do_run "rm -rf \"$src\""
    log "  DONE: $src merged into $dst (source removed)"
  fi
}

strategy_sweep() {
  local src="$1" _dst="$2" label="$3"
  log "=== $label (strategy=sweep) ==="
  [[ -d "$src" ]] || { log "  SKIP: $src missing"; return 0; }
  manual_step "Confirm no active builds running (npm run dev, cargo watch, etc.)"

  local find_args=("-type" "d" "(")
  local first=1
  for n in "${SWEEP_DIRNAMES[@]}"; do
    [[ $first -eq 0 ]] && find_args+=("-o")
    find_args+=("-name" "$n")
    first=0
  done
  find_args+=(")" "-prune")

  local total_kb=0
  while IFS= read -r d; do
    local kb; kb="$(du -sk "$d" 2>/dev/null | awk '{print $1}')"
    total_kb=$((total_kb + kb))
    log "  $(printf '%10s KB  %s' "$kb" "$d")"
    do_run "rm -rf \"$d\""
  done < <(find "$src" "${find_args[@]}" 2>/dev/null)
  log "  Total: $(human $((total_kb * 1024)))"
}

strategy_native_ui() {
  local _src="$1" _dst="$2" label="$3"
  log "=== $label (strategy=native-ui) ==="
  log "  This target is moved through the owning app's native UI."
  log "  See 'offload relocations' for the procedure."
}

strategy_purge() {
  local src="$1" _dst="$2" label="$3"
  log "=== $label (strategy=purge) ==="
  [[ -d "$src" ]] || { log "  SKIP: $src missing"; return 0; }
  log "  Source size: $(du -sh "$src" 2>/dev/null | awk '{print $1}')"
  do_run "rm -rf \"$src\""
  do_run "mkdir -p \"$src\""
  log "  DONE: $src purged (recreated empty)"
}

move_one() {
  local row="$1"
  IFS='|' read -r label cat src dest strat adm bundle <<<"$row"

  if [[ "$adm" == "yes" && "$TARGET_HOME" == "$HOME" ]]; then
    warn "  SKIP: $label requires Admin mode. Re-run with --target-home <path> from a separate Admin account whose Terminal has Full Disk Access."
    return 0
  fi
  if [[ "$adm" == "yes" ]]; then
    assert_admin_invariants
    assert_fda_granted
  fi

  case "$strat" in
    symlink)   require_drive OFFLOAD_HOT;  strategy_symlink "$src" "$dest" "$label" ;;
    archive)   require_drive OFFLOAD_COLD; strategy_archive "$src" "$dest" "$label" ;;
    merge)     require_drive OFFLOAD_HOT;  strategy_merge   "$src" "$dest" "$label" ;;
    sweep)                                 strategy_sweep   "$src" "$dest" "$label" ;;
    purge)                                 strategy_purge   "$src" "$dest" "$label" ;;
    native-ui)                             strategy_native_ui "$src" "$dest" "$label" ;;
    *) die "unknown strategy '$strat' for $label" ;;
  esac
}

# ----------------------------------------------------------------------------
# Per-row state assessment
# ----------------------------------------------------------------------------

# Bytes that would be reclaimed by offloading this row.
# 0 if the row is already done (symlinked/archived/merged) or absent.
# Subshell + set +o pipefail so EACCES on another user's home returns 0
# instead of crashing the script.
row_bytes() (
  set +o pipefail
  local src="$1" dest="$2" strat="$3"
  case "$strat" in
    symlink|native-ui)
      # On-disk and not yet a symlink -> reclaim = size of source
      if [[ -d "$src" && ! -L "$src" ]]; then
        du -sk "$src" 2>/dev/null | awk '{print $1*1024}'
      else
        echo 0
      fi
      ;;
    archive)
      # Source still has content -> reclaim = its size
      if [[ -d "$src" ]] && [[ -n "$(ls -A "$src" 2>/dev/null)" ]]; then
        du -sk "$src" 2>/dev/null | awk '{print $1*1024}'
      else
        echo 0
      fi
      ;;
    merge)
      if [[ -d "$src" ]]; then
        du -sk "$src" 2>/dev/null | awk '{print $1*1024}'
      else
        echo 0
      fi
      ;;
    sweep)
      # Sum sizes of matching subdirs.
      [[ -d "$src" ]] || { echo 0; return; }
      local find_args=("-type" "d" "(")
      local first=1
      for n in "${SWEEP_DIRNAMES[@]}"; do
        [[ $first -eq 0 ]] && find_args+=("-o")
        find_args+=("-name" "$n")
        first=0
      done
      find_args+=(")" "-prune")
      find "$src" "${find_args[@]}" 2>/dev/null \
        | xargs -I{} du -sk "{}" 2>/dev/null \
        | awk '{sum += $1} END {print sum*1024+0}'
      ;;
    purge)
      if [[ -d "$src" && -r "$src" && -x "$src" ]]; then
        du -sk "$src" 2>/dev/null | awk '{print $1*1024+0}'
      else
        echo 0
      fi
      ;;
    *) echo 0 ;;
  esac
)

# Real macOS users (UID >= 500, < 10000, non-underscore-prefixed).
list_real_users() {
  dscl . -list /Users UniqueID 2>/dev/null \
    | awk '$2 >= 500 && $2 < 10000 {print $1}' \
    | grep -v '^_'
}

row_state() (
  set +o pipefail
  local src="$1" dest="$2" strat="$3"
  case "$strat" in
    symlink)
      if [[ -L "$src" ]]; then
        local tgt; tgt="$(readlink "$src")"
        if [[ -d "$tgt" ]]; then echo "symlinked"
        else                    echo "broken-symlink"
        fi
      elif [[ -d "$src" && -r "$src" && -x "$src" ]]; then
        echo "on-disk ($(du -sh "$src" 2>/dev/null | awk '{print $1}'))"
      elif [[ -d "$src" ]]; then
        echo "unreadable"
      else
        echo "absent"
      fi
      ;;
    archive)
      if [[ ! -d "$src" ]]; then
        echo "absent"
      elif [[ ! -r "$src" || ! -x "$src" ]]; then
        echo "unreadable"
      elif [[ -z "$(ls -A "$src" 2>/dev/null)" ]]; then
        echo "empty (likely already archived)"
      else
        echo "on-disk ($(du -sh "$src" 2>/dev/null | awk '{print $1}'))"
      fi
      ;;
    merge)
      # Dest is intentionally shared across users for merge (single
      # canonical Clones repo). Only report "merged" when the
      # caller's own source is gone AND the caller actually owns
      # data merged in. Without a per-user marker we keep this
      # conservative: source missing => absent.
      if [[ -d "$src" ]] && [[ -r "$src" && -x "$src" ]]; then
        echo "on-disk ($(du -sh "$src" 2>/dev/null | awk '{print $1}'))"
      elif [[ -d "$src" ]]; then
        echo "unreadable"
      else
        echo "absent"
      fi
      ;;
    sweep)
      if [[ -d "$src" ]]; then
        local find_args=("-type" "d" "(")
        local first=1
        for n in "${SWEEP_DIRNAMES[@]}"; do
          [[ $first -eq 0 ]] && find_args+=("-o")
          find_args+=("-name" "$n")
          first=0
        done
        find_args+=(")" "-prune")
        local count; count="$(find "$src" "${find_args[@]}" 2>/dev/null | wc -l | tr -d ' ')"
        echo "$count cruft dirs"
      else
        echo "absent"
      fi
      ;;
    native-ui)
      if [[ -L "$src" ]]; then echo "symlinked (via native UI)"
      elif [[ -e "$src" ]];  then echo "on-disk ($(du -sh "$src" 2>/dev/null | awk '{print $1}'))"
      else                        echo "absent"
      fi
      ;;
    purge)
      if [[ ! -d "$src" ]]; then
        echo "absent"
      elif [[ ! -r "$src" || ! -x "$src" ]]; then
        echo "unreadable"
      elif [[ -z "$(ls -A "$src" 2>/dev/null)" ]]; then
        echo "purged (empty)"
      else
        echo "on-disk ($(du -sh "$src" 2>/dev/null | awk '{print $1}'))"
      fi
      ;;
    *) echo "unknown" ;;
  esac
)

# ----------------------------------------------------------------------------
# Subcommand: list
# ----------------------------------------------------------------------------

cmd_list_one() {
  printf '%-16s %-10s %-9s %-7s %-10s %s\n' LABEL CATEGORY STRATEGY ADMIN RECLAIM STATE
  printf '%-16s %-10s %-9s %-7s %-10s %s\n' ---- -------- -------- ----- ------- -----
  local prev_cat="" total=0 unreadable=0
  while IFS='|' read -r label cat src dest strat adm bundle; do
    if [[ "$cat" != "$prev_cat" && -n "$prev_cat" ]]; then echo ""; fi
    prev_cat="$cat"
    local state bytes
    state="$(row_state "$src" "$dest" "$strat")"
    bytes="$(row_bytes "$src" "$dest" "$strat")"
    total=$((total + bytes))
    case "$state" in unreadable*) unreadable=$((unreadable + 1)) ;; esac
    local rec="-"
    (( bytes > 0 )) && rec="$(human $bytes)"
    printf '%-16s %-10s %-9s %-7s %-10s %s\n' "$label" "$cat" "$strat" "$adm" "$rec" "$state"
  done < <(iter_targets)
  echo ""
  printf 'Potential reclaim from offloading remaining items: %s\n' "$(human $total)"
  if (( unreadable > 0 )) && [[ "$TARGET_HOME" != "$HOME" ]]; then
    echo ""
    echo "Note: $unreadable row(s) marked 'unreadable' — POSIX permissions block"
    echo "      this account from reading $TARGET_HOME. For a full audit:"
    echo "        sudo offload --target-home $TARGET_HOME list"
  fi
  LAST_TOTAL_BYTES=$total
}

cmd_list() {
  if [[ "$LIST_ALL_USERS" -eq 1 ]]; then
    local grand=0
    local users; users="$(list_real_users)"
    [[ -n "$users" ]] || die "no real users found (dscl returned nothing)"
    for u in $users; do
      local uh="/Users/$u"
      [[ -d "$uh" ]] || continue
      TARGET_HOME="$uh"
      echo "════════════════════════════════════════════════════════"
      echo "  /Users/$u   (TARGET_HOME=$TARGET_HOME)"
      echo "════════════════════════════════════════════════════════"
      cmd_list_one
      grand=$((grand + LAST_TOTAL_BYTES))
      echo
    done
    echo "═══════════════════════════════════════════════════════════"
    printf 'GRAND TOTAL potential reclaim across all users: %s\n' "$(human $grand)"
    echo "═══════════════════════════════════════════════════════════"
  else
    cmd_list_one
  fi
}

# ----------------------------------------------------------------------------
# Subcommand: launch
# ----------------------------------------------------------------------------

cmd_launch() {
  local bundle="${1:?usage: offload launch <BundleName>}"
  local src=""
  while IFS='|' read -r label cat r_src dest strat adm r_bundle; do
    if [[ "$bundle" == "$r_bundle" || "$bundle" == "$label" ]]; then
      src="$r_src"; break
    fi
  done < <(iter_targets)
  if [[ -n "$src" && -L "$src" ]]; then
    local tgt; tgt="$(readlink "$src")"
    if [[ ! -d "$tgt" ]]; then
      osascript -e "display dialog \"Cannot launch $bundle: its data lives at\n\n$tgt\n\nThat volume is not mounted. Plug in the drive and try again.\" buttons {\"OK\"} default button \"OK\" with icon stop" >/dev/null
      exit 1
    fi
  fi
  exec open -a "$bundle"
}

# ----------------------------------------------------------------------------
# Subcommand: status
# ----------------------------------------------------------------------------

cmd_status() {
  echo "=== offload v$VERSION  TARGET_HOME=$TARGET_HOME ==="
  echo "Config: $OFFLOAD_CONF $([[ -f "$OFFLOAD_CONF" ]] && echo '(loaded)' || echo '(not found — using defaults)')"
  echo
  echo "=== Disk space ==="
  local paths=(/)
  [[ -n "$OFFLOAD_HOT"  && -d "$OFFLOAD_HOT"  ]] && paths+=("$OFFLOAD_HOT")
  [[ -n "$OFFLOAD_COLD" && -d "$OFFLOAD_COLD" ]] && paths+=("$OFFLOAD_COLD")
  df -h "${paths[@]}" 2>/dev/null
  echo
  echo "=== Targets summary ==="
  local total=0 symlinked=0 on_disk=0 absent=0 admin_required=0
  while IFS='|' read -r label cat src dest strat adm bundle; do
    total=$((total + 1))
    local s; s="$(row_state "$src" "$dest" "$strat")"
    case "$s" in
      symlinked*)            symlinked=$((symlinked + 1)) ;;
      on-disk*)              on_disk=$((on_disk + 1)) ;;
      absent)                absent=$((absent + 1)) ;;
    esac
    [[ "$adm" == "yes" ]] && admin_required=$((admin_required + 1))
  done < <(iter_targets)
  echo "  total: $total | on-disk: $on_disk | symlinked: $symlinked | absent: $absent | admin-only: $admin_required"
  echo
  echo "=== Recent log ==="
  if [[ -f "$LOG" ]]; then tail -n 15 "$LOG"; else echo "(no log yet)"; fi
  echo
  echo "=== Admin todo ==="
  if [[ -s "$ADMIN_TODO" ]]; then cat "$ADMIN_TODO"; else echo "(empty)"; fi
}

# ----------------------------------------------------------------------------
# Subcommand: checklist
# ----------------------------------------------------------------------------

cmd_checklist() {
  cat <<HEADER
# Offload checklist (live — generated by \`offload checklist\`)
# Target home: $TARGET_HOME
# HOT  drive:  ${OFFLOAD_HOT:-<not configured>}
# COLD drive:  ${OFFLOAD_COLD:-<not configured>}

## Pre-flight
- [ ] HOT mounted (\`ls "$OFFLOAD_HOT"\` works)
- [ ] COLD mounted (\`ls "$OFFLOAD_COLD"\` works)
- [ ] No active builds running
- [ ] Time Machine has a recent backup

## Targets (live state)
HEADER
  local prev_cat=""
  while IFS='|' read -r label cat src dest strat adm bundle; do
    if [[ "$cat" != "$prev_cat" ]]; then
      echo ""
      echo "### $cat"
      prev_cat="$cat"
    fi
    local s; s="$(row_state "$src" "$dest" "$strat")"
    local mark="[ ]"
    case "$s" in
      symlinked*|merged|archived*) mark="[x]" ;;
    esac
    printf -- '- %s %-16s %-9s %s\n' "$mark" "$label" "$strat" "$s"
    if [[ "$adm" == "yes" ]]; then
      printf -- '      Admin only: offload protected --target-home %s %s --apply\n' "$TARGET_HOME" "$label"
    elif [[ "$strat" == "native-ui" ]]; then
      printf -- '      See: offload media-libraries\n'
    else
      printf -- '      offload move %s --apply' "$label"
      [[ -n "$bundle" && "$bundle" != "-" ]] && printf -- '  &&  offload launch "%s"' "$bundle"
      printf -- '\n'
    fi
  done < <(iter_targets)

  cat <<'FOOTER'

## Final
- [ ] Boot drive has comfortable headroom (offload status)
- [ ] If ~/offload-admin-todo.txt non-empty: review then `sudo bash ~/bin/offload-admin-pass`
FOOTER
}

# ----------------------------------------------------------------------------
# Subcommand: media-libraries
# ----------------------------------------------------------------------------

cmd_relocations() {
  cat <<EOS
=== Native-UI relocations (the script never auto-moves these) ===
Some apps cache the absolute path to their data internally. A
symlink works most of the time, but the native UIs handle the
transition cleanly including index rebuilds and metadata fixups.
Use these for: Docker, Photos, Music, iMovie, Final Cut.

Suggested destinations (HOT drive: ${OFFLOAD_HOT:-<not configured>}):

Docker disk image (typically the biggest single win)
  1. Quit any running containers.
  2. Docker Desktop > Settings > Resources > Advanced > Disk image location.
  3. Change to ${OFFLOAD_HOT:-<HOT>}/Docker/
  4. Apply & Restart. Docker copies the image to the new location
     and keeps the old until you confirm.
  5. After it boots cleanly: 'docker ps' should work and
     'docker run --rm hello-world' should succeed.
  6. The original ~/Library/Containers/com.docker.docker can then be
     deleted from Docker's UI prompt (or manually after verification).

Photos Library
  1. Quit Photos.
  2. Move ~/Pictures/Photos\ Library.photoslibrary to ${OFFLOAD_HOT:-<HOT>}/
  3. Hold Option (⌥) while launching Photos.
  4. Click "Other Library..." and pick the moved bundle.
  5. Photos > Settings > General > Use as System Photo Library.

Music.app Library
  1. Quit Music.
  2. Music > Settings > Files > Music Media folder location > Change…
  3. Point at ${OFFLOAD_HOT:-<HOT>}/Music\ Media (creates folder).
  4. File > Library > Organize Library… > Consolidate files.
  5. Move ~/Music/Music/Music\ Library.musiclibrary to the new location
     via File > Library > Choose Library… if you also want metadata external.

iMovie / Final Cut Pro Library
  1. Quit iMovie / Final Cut.
  2. Move ~/Movies/iMovie\ Library.imovielibrary to ${OFFLOAD_HOT:-<HOT>}/
  3. Double-click the moved .imovielibrary bundle to relaunch from new location.
  4. (Final Cut: File > Open Library… > select the moved .fcpbundle.)
EOS
}

# Backward compatibility — 'media-libraries' was the v0.2.x name.
cmd_media_libraries() { cmd_relocations; }

# ----------------------------------------------------------------------------
# Reporting
# ----------------------------------------------------------------------------

report_space() {
  log "--- Space ($(mode)) ---"
  log "  Boot:       $(df -h / | awk 'NR==2 {print $4}') free"
  [[ -n "$OFFLOAD_HOT"  ]] && log "  HOT  ($OFFLOAD_HOT):  $(df -h "$OFFLOAD_HOT" 2>/dev/null | awk 'NR==2 {print $4}') free"
  [[ -n "$OFFLOAD_COLD" ]] && log "  COLD ($OFFLOAD_COLD): $(df -h "$OFFLOAD_COLD" 2>/dev/null | awk 'NR==2 {print $4}') free"
}

emit_admin_pass() {
  [[ -s "$ADMIN_TODO" ]] || return 0
  log "  Admin items found; emitting $ADMIN_PASS"
  {
    echo '#!/usr/bin/env bash'
    echo '# offload-admin-pass — REVIEW EVERY LINE before running.'
    echo '# Then: sudo bash '"$ADMIN_PASS"
    echo '# Generated by offload on '"$(date)"
    echo 'set -euo pipefail'
    echo ''
    cat "$ADMIN_TODO"
  } > "$ADMIN_PASS"
  chmod +x "$ADMIN_PASS"
  warn "Admin-pass script at $ADMIN_PASS — REVIEW EVERY LINE before sudo'ing"
}

# ----------------------------------------------------------------------------
# Subcommand: move <Label-or-category>
# ----------------------------------------------------------------------------

cmd_move() {
  local needle="${1:?usage: offload move <Label-or-category> [--apply]}"; shift || true
  for a in "$@"; do
    case "$a" in --apply) DRY=0 ;; esac
  done

  assert_admin_invariants

  log "============================================="
  log "offload v$VERSION move  needle=$needle  mode=$(mode)  TARGET_HOME=$TARGET_HOME"
  log "============================================="
  report_space

  local matched=0
  while IFS='|' read -r label cat src dest strat adm bundle; do
    if [[ "$needle" == "$label" || "$needle" == "$cat" ]]; then
      move_one "$label|$cat|$src|$dest|$strat|$adm|$bundle"
      matched=$((matched + 1))
    fi
  done < <(iter_targets)

  [[ $matched -gt 0 ]] || die "no targets matched '$needle' — see 'offload list'"

  report_space
  emit_admin_pass
  log "Done. Log: $LOG"
}

# ----------------------------------------------------------------------------
# Subcommand: protected (move with admin gating reinforced)
# ----------------------------------------------------------------------------

cmd_protected() {
  local needle="${1:?usage: offload protected --target-home <path> <Label> [--apply]}"; shift || true
  [[ "$TARGET_HOME" != "$HOME" ]] \
    || die "'protected' requires --target-home pointing at a DIFFERENT user's home."
  cmd_move "$needle" "$@"
}

# ----------------------------------------------------------------------------
# help — extracted from header (no duplication)
# ----------------------------------------------------------------------------

cmd_help() {
  awk 'NR>1 && /^#($| )/ {sub(/^# ?/, ""); print; next} NR>1 && !/^#/ {exit}' "$0"
}

# ----------------------------------------------------------------------------
# Dispatch
# ----------------------------------------------------------------------------

main() {
  local args=()
  while (( $# > 0 )); do
    case "$1" in
      --target-home) TARGET_HOME="$2"; shift 2 ;;
      --all-users)   LIST_ALL_USERS=1; shift ;;
      *)             args+=("$1"); shift ;;
    esac
  done
  set -- "${args[@]}"

  local sub="${1:-help}"; shift || true
  case "$sub" in
    help|-h|--help)            cmd_help ;;
    version|-V|--version)      echo "offload v$VERSION" ;;
    status)                    cmd_status ;;
    list)                      cmd_list ;;
    checklist)                 cmd_checklist ;;
    relocations|media-libraries|media) cmd_relocations ;;
    launch)                    cmd_launch "$@" ;;
    move)                      cmd_move "$@" ;;
    protected)                 cmd_protected "$@" ;;
    *) die "unknown subcommand: $sub (try 'offload help')" ;;
  esac
}

main "$@"
