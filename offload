report_space() {
  log "--- Space ($(mode)) ---"
  log "  Boot:       $(df -h / | awk 'NR==2 {print $4}') free"
  [[ -n "$OFFLOAD_HOT"  ]] && log "  HOT  ($OFFLOAD_HOT):  $(df -h "$OFFLOAD_HOT" 2>/dev/null | awk 'NR==2 {print $4}') free"
  [[ -n "$OFFLOAD_COLD" ]] && log "  COLD ($OFFLOAD_COLD): $(df -h "$OFFLOAD_COLD" 2>/dev/null | awk 'NR==2 {print $4}') free"
}

emit_admin_pass() {
  [[ -s "$ADMIN_TODO" ]] || return 0
  log "  Admin items found; emitting $ADMIN_PASS"
  {
    echo '#!/usr/bin/env bash'
    echo '# offload-admin-pass — REVIEW EVERY LINE before running.'
    echo '# Then: sudo bash '"$ADMIN_PASS"
    echo '# Generated by offload on '"$(date)"
    echo 'set -euo pipefail'
    echo ''
    cat "$ADMIN_TODO"
  } > "$ADMIN_PASS"
  chmod +x "$ADMIN_PASS"
  warn "Admin-pass script at $ADMIN_PASS — REVIEW EVERY LINE before sudo'ing"
}

# ----------------------------------------------------------------------------
# Subcommand: move <Label-or-category>
# ----------------------------------------------------------------------------

cmd_move() {
  local needle="${1:?usage: offload move <Label-or-category> [--apply]}"; shift || true
  for a in "$@"; do
    case "$a" in --apply) DRY=0 ;; esac
  done

  assert_admin_invariants

  log "============================================="
  log "offload v$VERSION move  needle=$needle  mode=$(mode)  TARGET_HOME=$TARGET_HOME"
  log "============================================="
  report_space

  local matched=0
  while IFS='|' read -r label cat src dest strat adm bundle; do
    if [[ "$needle" == "$label" || "$needle" == "$cat" ]]; then
      move_one "$label|$cat|$src|$dest|$strat|$adm|$bundle"
      matched=$((matched + 1))
    fi
  done < <(iter_targets)

  [[ $matched -gt 0 ]] || die "no targets matched '$needle' — see 'offload list'"

  report_space
  emit_admin_pass
  log "Done. Log: $LOG"
}

# ----------------------------------------------------------------------------
# Subcommand: protected (move with admin gating reinforced)
# ----------------------------------------------------------------------------

cmd_protected() {
  local needle="${1:?usage: offload protected --target-home <path> <Label> [--apply]}"; shift || true
  [[ "$TARGET_HOME" != "$HOME" ]] \
    || die "'protected' requires --target-home pointing at a DIFFERENT user's home."
  cmd_move "$needle" "$@"
}

# ----------------------------------------------------------------------------
# Subcommand: drain — make room on a full HOT drive by moving to COLD
# ----------------------------------------------------------------------------
# A full HOT drive breaks whatever grows on it: Docker Desktop's sparse
# Docker.raw turns every VM write into "input/output error" once the host
# volume is out of space (the 3.2.0 AI-UI release died this way, 2026-09-26).
#
# One scan gives every top-level entry a size, a last-touched age, and a
# status with its reason: cold (safe to suggest), warm (touched recently),
# live (a sync app, an active git repo, or a file open right now), or skip
# (owned by offload, a VM disk, a media library, drained already).
# Loose files in the drive root are grouped by kind (@loose-archives ...).

DRAIN_WARM_DAYS="${DRAIN_WARM_DAYS:-30}"

# Prints key $2 of the JSON object in file $1, if both exist.
json_key() {
  [[ -f "$1" ]] || return 0
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2]) or "")' "$1" "$2" 2>/dev/null || true
}

# The folders that hold Docker Desktop's, Colima's and OrbStack's VM disks,
# as each runtime is set up. A drain must never take one: rsync writes a sparse
# disk out at full size, and the size check cannot see a VM that wrote to its
# disk mid-copy, since a disk image keeps its size.
vm_disk_dirs() {
  json_key "$HOME/Library/Group Containers/group.com.docker/settings-store.json" DataFolder
  colima_disks
  # Colima may run without the environment this shell has.
  echo "$HOME/.colima/_lima/_disks"
  echo "$HOME/Library/Group Containers/HUAQ24HBR6.dev.orbstack/data"
  json_key "$HOME/.orbstack/vmconfig.json" data_dir
}

# Top-level names on HOT that offload itself owns, plus the VM disk folders.
drain_protected() {
  local rel dir hot
  while IFS='|' read -r _ _ _ dest _ _ _; do
    [[ "$dest" == "$OFFLOAD_HOT"/* ]] || continue
    rel="${dest#"$OFFLOAD_HOT"/}"; echo "${rel%%/*}"
  done < <(iter_targets)
  # Compare physical paths: _disks is often a symlink into HOT. A VM folder
  # that is the HOT root itself keeps every entry, since its disks sit loose.
  # A glob, not ls: CLICOLOR_FORCE makes ls wrap names in colour codes.
  hot="$(cd -P "$OFFLOAD_HOT" && pwd -P)"
  while IFS= read -r dir; do
    dir="$(physical_path "$dir")"
    if [[ "$dir" == "$hot"/* ]]; then rel="${dir#"$hot"/}"; echo "${rel%%/*}"
    elif [[ "$dir" == "$hot" ]]; then (cd "$hot" && printf '%s\n' *); fi
  done < <(vm_disk_dirs)
}

# Scan HOT. Prints, tab-separated:
#   E <name> <bytes> <days-since-touched> <status> <reason>   one per entry or @group
#   M <@group> <file>                                        one per group member
drain_scan() {
  DRAIN_PROTECTED="$(drain_protected | sort -u)" python3 - "$OFFLOAD_HOT" "$DRAIN_WARM_DAYS" <<'PY'
import os, subprocess, sys, time

hot, warm_days = sys.argv[1], int(sys.argv[2])
protected = set(filter(None, os.environ.get("DRAIN_PROTECTED", "").split("\n")))
now = time.time()
MEDIA = (".photoslibrary", ".musiclibrary", ".imovielibrary", ".fcpbundle")
SYNC = {".stfolder": "Syncthing", ".stignore": "Syncthing", ".sync": "Resilio Sync",
        ".dropbox": "Dropbox", ".dropbox.cache": "Dropbox", ".owncloudsync.log": "Nextcloud",
        ".SynologyWorkingDirectory": "Synology Drive"}
KINDS = {"archives": ".7z .zip .rar .tar .gz .tgz .xz .bz2 .iso .dmg .pkg",
         "videos": ".mp4 .mov .m4v .mkv .avi .webm",
         "audio": ".mp3 .wav .aif .aiff .flac .m4a .mid .midi",
         "images": ".jpg .jpeg .png .heic .tif .tiff .gif .psd .raw .dng",
         "documents": ".pdf .doc .docx .ppt .pptx .key .pages .numbers .xls .xlsx"}
KIND = {ext: k for k, exts in KINDS.items() for ext in exts.split()}

# Files open right now, by top-level entry: one lsof call for the whole system.
open_by = {}
try:
    out = subprocess.run(["lsof", "-w", "-Fcn"], capture_output=True, text=True, timeout=60).stdout
    cmd = "?"
    for line in out.splitlines():
        if line[:1] == "c": cmd = line[1:]
        elif line[:1] == "n" and line.startswith("n" + hot + "/"):
            top = line[len(hot) + 2:].split("/", 1)[0]
            open_by.setdefault(top, cmd)
except (OSError, subprocess.SubprocessError):
    pass

def walk(path):
    """bytes, newest mtime, live reason ('' if none), for a file or a tree."""
    try:
        st = os.lstat(path)
    except OSError:
        return 0, 0, ""
    size, newest, live = st.st_blocks * 512, st.st_mtime, ""
    stack = [(path, 0)] if os.path.isdir(path) and not os.path.islink(path) else []
    while stack:
        d, depth = stack.pop()
        try:
            it = os.scandir(d)
        except OSError:
            continue
        with it:
            for e in it:
                try:
                    s = e.stat(follow_symlinks=False)
                except OSError:
                    continue
                size += s.st_blocks * 512
                newest = max(newest, s.st_mtime)
                if not live and depth <= 3:
                    if e.name in SYNC or (e.name.startswith((".sync_", "._sync_")) and e.name.endswith(".db")):
                        live = SYNC.get(e.name, "Nextcloud") + " folder"
                    elif e.name == ".git" and e.is_dir(follow_symlinks=False):
                        for probe in ("index", "logs/HEAD", "FETCH_HEAD"):
                            try:
                                age = (now - os.stat(os.path.join(e.path, probe)).st_mtime) / 86400
                            except OSError:
                                continue
                            if age < warm_days:
                                live = f"git repo active {int(age)} d ago"
                                break
                if e.is_dir(follow_symlinks=False):
                    stack.append((e.path, depth + 1))
    return size, newest, live

def row(name, size, newest, status, reason):
    days = int((now - newest) / 86400) if newest else -1
    print(f"E\t{name}\t{size}\t{days}\t{status}\t{reason}")

def files(n):
    return f"{n} file" + ("" if n == 1 else "s")

groups = {}
for name in sorted(os.listdir(hot)):
    if name.startswith("."):
        continue
    path = os.path.join(hot, name)
    if os.path.islink(path):
        row(name, 0, 0, "skip", "drained already: " + os.readlink(path)); continue
    if name.endswith(MEDIA):
        row(name, 0, 0, "skip", "media library: use 'offload relocations'"); continue
    if name in protected:
        row(name, 0, 0, "skip", "owned by offload or a VM disk"); continue
    if os.path.isfile(path):
        groups.setdefault("@loose-" + KIND.get(os.path.splitext(name)[1].lower(), "other"), []).append(name)
        continue
    size, newest, live = walk(path)
    days = (now - newest) / 86400
    if name in open_by:
        row(name, size, newest, "live", f"open by {open_by[name]}")
    elif live:
        row(name, size, newest, "live", live)
    elif days < warm_days:
        row(name, size, newest, "warm", f"touched {int(days)} d ago")
    else:
        row(name, size, newest, "cold", "")

for group, members in sorted(groups.items()):
    size = newest = 0
    opened = [m for m in members if m in open_by]
    for m in members:
        s, n, _ = walk(os.path.join(hot, m))
        size, newest = size + s, max(newest, n)
        print(f"M\t{group}\t{m}")
    days = (now - newest) / 86400
    if opened:
        row(group, size, newest, "live", f"{opened[0]} open by {open_by[opened[0]]}")
    elif days < warm_days:
        row(group, size, newest, "warm", f"{files(len(members))}, newest touched {int(days)} d ago")
    else:
        row(group, size, newest, "cold", files(len(members)))
PY
}

drain_age() {
  local d="$1"
  if   (( d < 0 ));   then echo "-"
  elif (( d < 14 ));  then echo "${d} d"
  elif (( d < 90 ));  then echo "$(( d / 7 )) wk"
  elif (( d < 730 )); then echo "$(( d / 30 )) mo"
  else echo "$(( d / 365 )) yr"; fi
}

drain_sig() {
  if [[ -d "$1" ]]; then tree_signature "$1"; else echo "files=1 bytes=$(stat -f %z "$1")"; fi
}

drain_one() {
  local name="$1" src="$OFFLOAD_HOT/$1" dst="$DRAIN_DEST/$1"
  log "=== drain $name ==="
  [[ -e "$src" ]] || die "$src does not exist"
  [[ -e "$dst" || -L "$dst" ]] && die "Destination $dst exists — manual review required"
  log "  Source sig: $(drain_sig "$src")"
  do_run "mkdir -p \"$DRAIN_DEST\""
  if [[ -d "$src" ]]; then do_run "rsync -a \"$src/\" \"$dst/\""; else do_run "rsync -a \"$src\" \"$dst\""; fi
  if [[ $DRY -eq 0 ]]; then
    local s d; s="$(drain_sig "$src")"; d="$(drain_sig "$dst")"
    log "  Verify: src=$s dst=$d"
    [[ "$s" == "$d" ]] || die "Signature mismatch — source preserved"
    do_run "rm -rf \"$src\""
    do_run "ln -s \"$dst\" \"$src\""
    log "  DONE: $src -> $dst"
  fi
}

cmd_drain() {
  local need_gib=30 names=() name
  while (( $# > 0 )); do
    case "$1" in
      --apply) DRY=0; shift ;;
      --need)  need_gib="${2:?--need takes a number of GiB}"; shift 2 ;;
      *)       names+=("$1"); shift ;;
    esac
  done
  [[ "$need_gib" =~ ^[0-9]+$ ]] || die "--need takes a whole number of GiB"
  (( DRY == 0 && ${#names[@]} == 0 )) && die "drain --apply needs the names to move. Run 'offload drain' for a plan."
  require_drive OFFLOAD_HOT; require_drive OFFLOAD_COLD
  DRAIN_DEST="$OFFLOAD_COLD/Drained/$(basename "$OFFLOAD_HOT")"

  log "============================================="
  log "offload v$VERSION drain  mode=$(mode)  need=${need_gib}GiB free on HOT"
  log "============================================="
  report_space
  log "  Scanning $OFFLOAD_HOT: sizes, ages, sync apps, git repos, open files (big drives take minutes)..."
  local scan; scan="$(drain_scan)"
  local rows; rows="$(awk -F'\t' '$1 == "E"' <<<"$scan")"

  # The plan: named entries, or the coldest cold entries until the gap closes.
  local plan=() total=0 kb bytes days status reason
  if (( ${#names[@]} )); then
    for name in "${names[@]}"; do
      [[ "$name" == */* || "$name" == *[\"\$\`\\]* ]] && die "unsafe name: $name"
      IFS=$'\t' read -r _ _ bytes days status reason < <(awk -F'\t' -v n="$name" '$2 == n' <<<"$rows")
      [[ -n "${status:-}" ]] || die "'$name' is not on $OFFLOAD_HOT (see 'offload drain')"
      [[ "$status" == skip ]] && die "'$name' is not movable: $reason"
      [[ "$status" == live ]] && die "'$name' is live ($reason). Stop that first, then drain it."
      [[ "$status" == warm ]] && warn "  $name was $reason; moving it anyway, as named"
      plan+=("$name"); total=$(( total + bytes )); status=""
    done
  else
    local gap=$(( need_gib * 1073741824 - $(free_bytes "$OFFLOAD_HOT") ))
    while IFS=$'\t' read -r _ name bytes days status reason; do
      (( total >= gap )) && break
      [[ "$name" == *[\"\$\`\\]* ]] && continue
      plan+=("$name"); total=$(( total + bytes ))
    done < <(awk -F'\t' '$5 == "cold"' <<<"$rows" | sort -t$'\t' -k4,4nr -k3,3nr)   # coldest first
  fi

  log "--- $OFFLOAD_HOT (* = in this plan) ---"
  log "$(printf '    %10s  %-7s %-5s %s' SIZE TOUCHED STATE NAME)"
  local order
  for order in cold warm live skip; do
    while IFS=$'\t' read -r _ name bytes days status reason; do
      local mark=" " n; for n in "${plan[@]:-}"; do [[ "$n" == "$name" ]] && mark="*"; done
      log "$(printf '  %s %10s  %-7s %-5s %s%s' "$mark" "$([[ $status == skip ]] && echo - || human "$bytes")" "$(drain_age "$days")" "$status" "$name" "${reason:+  ($reason)}")"
    done < <(awk -F'\t' -v s="$order" '$5 == s' <<<"$rows" | sort -t$'\t' -k3,3nr)
  done

  if (( ${#plan[@]} == 0 )); then
    if (( ${#names[@]} == 0 )); then log "  Nothing to suggest: HOT has ${need_gib}GiB free, or nothing cold is left."; fi
    return 0
  fi
  log "--- Plan: $(human "$total") to $DRAIN_DEST; each entry leaves a symlink ---"
  require_free "$OFFLOAD_COLD" "$total"
  if (( ${#names[@]} == 0 )); then
    log "  A suggestion: coldest first, cold entries only. Then:"
    log "    offload drain$(printf ' %q' "${plan[@]}") --apply"
    return 0
  fi
  for name in "${plan[@]}"; do
    if [[ "$name" == @* ]]; then
      while IFS=$'\t' read -r _ _ member; do drain_one "$member"; done < <(awk -F'\t' -v g="$name" '$1 == "M" && $2 == g' <<<"$scan")
    else
      drain_one "$name"
    fi
  done
  report_space
  [[ $DRY -eq 1 ]] && log "Dry run. Add --apply to move."
  log "Done. Log: $LOG"
}

# ----------------------------------------------------------------------------
# Subcommand: drives — auto-detect external drives, classify HOT/COLD
# ----------------------------------------------------------------------------

# Returns 0 if the mount-point houses a Time Machine backup.
# Detection is filesystem-evidence + tmutil, not name-based: a drive
# accidentally named "TM" or "backup" is NOT excluded; only macOS-
# recognized TM destinations or backup directories are.
is_time_machine() {
  local mp="$1"
  # Old-style.
  [[ -d "$mp/Backups.backupdb" ]] && return 0
  # APFS-era .timemachine snapshot directory.
  [[ -d "$mp/.com.apple.TimeMachine.snapshots" ]] && return 0
  # Modern TM creates this guard dir at the destination root.
  [[ -d "$mp/.com.apple.TimeMachine.IOCheck" ]] && return 0
  # tmutil is the canonical source of truth for "this is a TM destination".
  if command -v tmutil >/dev/null 2>&1; then
    tmutil destinationinfo 2>/dev/null \
      | awk -F': *' '$1 ~ /^Mount Point/ {print $2}' \
      | grep -qxF "$mp" && return 0
  fi
  return 1
}

# Read a single field from `diskutil info <mount>` output.
# Field names are matched verbatim against diskutil's "Field Name:" prefix.
# Subshell + `set +e` so a non-zero diskutil exit (invalid path, missing
# attribute) cleanly yields empty output instead of crashing the script.
diskutil_field() (
  set +e
  set +o pipefail
  local mp="$1" field="$2"
  diskutil info "$mp" 2>/dev/null \
    | awk -F: -v f="$field" 'index($0, f":") {sub(/^[ \t]+/, "", $2); print $2; exit}'
)

# Optional throughput benchmark. Times reading 100 MB sequentially.
# Only runs when --benchmark is set; otherwise this helper is unused.
benchmark_read() (
  set +e
  set +o pipefail
  local mp="$1"
  # macOS BSD `dd` has no cache-bypass (no GNU iflag=direct), and `purge`
  # needs sudo. We use a 1 GB probe so the macOS page cache can't fully
  # hold it — first read hits disk for most of the file, subsequent reads
  # are increasingly cache-warm. Reported speeds are rough; the *relative*
  # ordering of drives is the meaningful signal, not absolute MB/s.
  local probe="$mp/.offload-benchmark-probe-1g"
  if [[ ! -f "$probe" ]]; then
    if ! dd if=/dev/zero of="$probe" bs=1M count=1024 2>/dev/null; then
      echo "n/a (write failed)"
      return 0
    fi
  fi
  local out bps
  out=$(dd if="$probe" of=/dev/null bs=1M count=1024 2>&1 | tail -1)
  bps=$(echo "$out" | sed -nE 's/.*\(([0-9]+) bytes\/sec\).*/\1/p')
  if [[ -n "$bps" && "$bps" -gt 0 ]]; then
    printf '%d MB/s' "$((bps / 1000000))"
  else
    echo "n/a"
  fi
)

# Classify a single mount. Outputs "ROLE|REASON" on stdout.
# ROLE in {HOT, COLD, EXCLUDED, UNKNOWN}.
detect_role() {
  local mp="$1"

  if is_time_machine "$mp"; then
    echo "EXCLUDED|Time Machine backup present"
    return 0
  fi

  # Read-only check via mount(8) flags.
  if mount | grep -F " on $mp " | grep -q "read-only"; then
    echo "EXCLUDED|read-only mount"
    return 0
  fi

  local solid loc fs
  solid="$(diskutil_field "$mp" "Solid State")"
  loc="$(diskutil_field "$mp" "Device Location")"
  fs="$(diskutil_field "$mp" "File System Personality")"

  # Only consider externals for HOT/COLD; internals are the boot drive.
  if [[ "$loc" != "External" ]]; then
    echo "EXCLUDED|internal drive (not an offload target)"
    return 0
  fi

  if [[ "$solid" == "Yes" ]]; then
    echo "HOT|External SSD + $fs"
    return 0
  fi

  if [[ "$solid" == "No" || "$solid" == "Info not available" ]]; then
    if [[ "$fs" == *HFS+* ]]; then
      echo "COLD|HFS+ + spinner + external"
    else
      echo "COLD|spinner + external"
    fi
    return 0
  fi

  echo "UNKNOWN|no Solid State info from diskutil"
}

cmd_drives() {
  local hdr_extra=""
  (( BENCHMARK == 1 )) && hdr_extra="  SPEED"

  printf '%-28s %-7s %-6s %-5s %-7s %-9s%s  %s\n' \
    DRIVE FS SOLID PROT FREE ROLE "$hdr_extra" REASON
  printf '%-28s %-7s %-6s %-5s %-7s %-9s%s  %s\n' \
    ---- -- ----- ---- ---- ---- "${hdr_extra:+      }" ------

  local detected_hot="" detected_cold=""

  # Pre-compute the mount table so we can skip pseudo-entries like
  # /Volumes/com.apple.TimeMachine.localsnapshots (a magic directory that
  # is not a mount point and makes `diskutil info` return non-zero).
  local mount_table; mount_table="$(mount)"

  for mp in /Volumes/*; do
    [[ -d "$mp" ]] || continue
    # Only inspect real mount points.
    grep -qF " on $mp " <<<"$mount_table" || continue

    local name fs solid proto free role reason speed=""
    name="$(basename "$mp")"
    fs="$(diskutil_field "$mp" "File System Personality")"
    solid="$(diskutil_field "$mp" "Solid State")"
    proto="$(diskutil_field "$mp" "Protocol")"
    free="$(df -h "$mp" 2>/dev/null | awk 'NR==2 {print $4}')"

    IFS='|' read -r role reason < <(detect_role "$mp")

    # Truncate to keep the table aligned.
    [[ ${#name}  -gt 26 ]] && name="${name:0:25}…"
    case "$fs" in
      *APFS*) fs="APFS" ;;
      *HFS+*|*"HFS Plus"*) fs="HFS+" ;;
    esac
    case "$solid" in Yes) solid="yes" ;; No) solid="no" ;; *) solid="-" ;; esac
    case "$proto" in USB) proto="USB" ;; Thunderbolt) proto="TB" ;; *) proto="${proto:0:5}" ;; esac

    if (( BENCHMARK == 1 )); then
      if [[ "$role" == "EXCLUDED" ]]; then
        speed="  -"
      else
        speed="  $(benchmark_read "$mp")"
      fi
    fi

    printf '%-28s %-7s %-6s %-5s %-7s %-9s%s  %s\n' \
      "$name" "$fs" "$solid" "$proto" "${free:--}" "$role" "$speed" "$reason"

    # Track the first detected of each role for the "Detected:" footer.
    [[ -z "$detected_hot"  && "$role" == "HOT"  ]] && detected_hot="$mp"
    [[ -z "$detected_cold" && "$role" == "COLD" ]] && detected_cold="$mp"
  done

  echo ""
  echo "Detected:"
  echo "  OFFLOAD_HOT=\"${detected_hot:-<none>}\""
  echo "  OFFLOAD_COLD=\"${detected_cold:-<none>}\""
  echo ""
  echo "Current config ($OFFLOAD_CONF):"
  local cfg_status=""
  if [[ -f "$OFFLOAD_CONF" ]]; then
    if [[ -n "$OFFLOAD_HOT" ]]; then
      cfg_status="$([[ "$OFFLOAD_HOT" == "$detected_hot" ]] && echo '✓ matches' || echo '✗ differs from detection')"
      echo "  OFFLOAD_HOT=\"$OFFLOAD_HOT\"   $cfg_status"
    else
      echo "  OFFLOAD_HOT not set"
    fi
    if [[ -n "$OFFLOAD_COLD" ]]; then
      cfg_status="$([[ "$OFFLOAD_COLD" == "$detected_cold" ]] && echo '✓ matches' || echo '✗ differs from detection')"
      echo "  OFFLOAD_COLD=\"$OFFLOAD_COLD\"  $cfg_status"
    else
      echo "  OFFLOAD_COLD not set"
    fi
  else
    echo "  (config file not found — using built-in defaults)"
  fi
  echo ""
  echo "To persist detection, append to $OFFLOAD_CONF:"
  [[ -n "$detected_hot"  ]] && echo "  echo 'OFFLOAD_HOT=\"$detected_hot\"' >> $OFFLOAD_CONF"
  [[ -n "$detected_cold" ]] && echo "  echo 'OFFLOAD_COLD=\"$detected_cold\"' >> $OFFLOAD_CONF"
  echo ""
  if (( BENCHMARK == 1 )); then
    echo ""
    echo "SPEED column is a rough 1 GB read against each drive. macOS lacks"
    echo "a userspace cache-bypass, so absolute MB/s can be inflated by the"
    echo "page cache — trust the *relative* ordering of drives, not absolute"
    echo "numbers. Probe files (.offload-benchmark-probe-1g) are left on each"
    echo "drive so a second run is reproducible; delete them when you're done."
  fi

  echo ""
  echo "Note: for cross-drive deduplication, consider installing jdupes:"
  echo "  brew install jdupes"
}

# ----------------------------------------------------------------------------
# help — extracted from header (no duplication)
# ----------------------------------------------------------------------------

cmd_help() {
  awk 'NR>1 && /^#($| )/ {sub(/^# ?/, ""); print; next} NR>1 && !/^#/ {exit}' "$0"
}

# ----------------------------------------------------------------------------
# Dispatch
# ----------------------------------------------------------------------------

main() {
  local args=()
  while (( $# > 0 )); do
    case "$1" in
      --target-home) TARGET_HOME="$2"; shift 2 ;;
      --all-users)   LIST_ALL_USERS=1; shift ;;
      --benchmark)   BENCHMARK=1; shift ;;
      *)             args+=("$1"); shift ;;
    esac
  done
  set -- "${args[@]}"

  local sub="${1:-help}"; shift || true
  case "$sub" in
    help|-h|--help)            cmd_help ;;
    version|-V|--version)      echo "offload v$VERSION" ;;
    status)                    cmd_status ;;
    list)                      cmd_list ;;
    checklist)                 cmd_checklist ;;
    drives)                    cmd_drives ;;
    relocations|media-libraries|media) cmd_relocations ;;
    launch)                    cmd_launch "$@" ;;
    move)                      cmd_move "$@" ;;
    protected)                 cmd_protected "$@" ;;
    drain)                     cmd_drain "$@" ;;
    *) die "unknown subcommand: $sub (try 'offload help')" ;;
  esac
}

main "$@"
