# ----------------------------------------------------------------------------
# drain — make room on a full HOT drive by moving to COLD
# ----------------------------------------------------------------------------
# A full HOT drive breaks whatever grows on it: Docker Desktop's sparse
# Docker.raw turns every VM write into "input/output error" once the host
# volume is out of space (the 3.2.0 AI-UI release died this way, 2026-09-26).
# One scan gives every top-level entry a size, a last-touched age, and a
# status with its reason: cold (safe to suggest), warm (touched recently),
# live (a sync app, an active git repo, or a file open right now), or skip
# (owned by offload, a VM disk, a media library, drained already).

DRAIN_WARM_DAYS = int(os.environ.get("DRAIN_WARM_DAYS", "30"))
MEDIA_SUFFIXES = (".photoslibrary", ".musiclibrary", ".imovielibrary", ".fcpbundle")
SYNC_MARKERS = {".stfolder": "Syncthing", ".stignore": "Syncthing", ".sync": "Resilio Sync",
                ".dropbox": "Dropbox", ".dropbox.cache": "Dropbox", ".owncloudsync.log": "Nextcloud",
                ".SynologyWorkingDirectory": "Synology Drive"}
KINDS = {"archives": ".7z .zip .rar .tar .gz .tgz .xz .bz2 .iso .dmg .pkg",
         "videos": ".mp4 .mov .m4v .mkv .avi .webm",
         "audio": ".mp3 .wav .aif .aiff .flac .m4a .mid .midi",
         "images": ".jpg .jpeg .png .heic .tif .tiff .gif .psd .raw .dng",
         "documents": ".pdf .doc .docx .ppt .pptx .key .pages .numbers .xls .xlsx"}
KIND_OF = {ext: kind for kind, exts in KINDS.items() for ext in exts.split()}


class Entry(NamedTuple):
    name: str
    size: int
    days: int
    status: str
    reason: str


def json_key(path: str, key: str) -> str:
    try:
        return str(json.load(open(path)).get(key) or "")
    except (OSError, ValueError, AttributeError):
        return ""


def vm_disk_dirs() -> List[str]:
    """Folders that hold Docker Desktop's, Colima's and OrbStack's VM disks, as each runtime is set up."""
    dirs = [json_key(os.path.join(S.home, "Library/Group Containers/group.com.docker/settings-store.json"), "DataFolder"),
            colima_disks(), os.path.join(S.home, ".colima/_lima/_disks"),
            os.path.join(S.home, "Library/Group Containers/HUAQ24HBR6.dev.orbstack/data"),
            json_key(os.path.join(S.home, ".orbstack/vmconfig.json"), "data_dir")]
    return [d for d in dirs if d]


def drain_protected() -> set:
    """Top-level names on HOT that offload owns, plus the folders holding VM disks."""
    names = set()
    for t in iter_targets():
        if t.dest.startswith(S.hot + "/"):
            names.add(t.dest[len(S.hot) + 1:].split("/", 1)[0])
    hot = os.path.realpath(S.hot)
    for folder in vm_disk_dirs():
        real = physical_path(folder)
        if real.startswith(hot + "/"):
            names.add(real[len(hot) + 1:].split("/", 1)[0])
        elif real == hot:
            names.update(n for n in os.listdir(hot) if not n.startswith("."))
    return names


def open_files_by_entry(hot: str) -> dict:
    """Top-level entry -> command holding a file open there: one lsof call for the whole system."""
    found = {}
    try:
        out = subprocess.run(["lsof", "-w", "-Fcn"], capture_output=True, text=True, timeout=60).stdout
    except (OSError, subprocess.SubprocessError):
        return found
    cmd = "?"
    for line in out.splitlines():
        if line[:1] == "c":
            cmd = line[1:]
        elif line.startswith("n" + hot + "/"):
            found.setdefault(line[len(hot) + 2:].split("/", 1)[0], cmd)
    return found


def walk_entry(path: str, now: float) -> tuple:
    """Allocated bytes, newest mtime, live reason ('' if none), for a file or a tree."""
    try:
        st = os.lstat(path)
    except OSError:
        return 0, 0.0, ""
    size, newest, live = st.st_blocks * 512, st.st_mtime, ""
    stack = [(path, 0)] if os.path.isdir(path) and not os.path.islink(path) else []
    while stack:
        folder, depth = stack.pop()
        try:
            entries = list(os.scandir(folder))
        except OSError:
            continue
        for e in entries:
            try:
                s = e.stat(follow_symlinks=False)
            except OSError:
                continue
            size += s.st_blocks * 512
            newest = max(newest, s.st_mtime)
            if not live and depth <= 3:
                if e.name in SYNC_MARKERS or (e.name.startswith((".sync_", "._sync_")) and e.name.endswith(".db")):
                    live = SYNC_MARKERS.get(e.name, "Nextcloud") + " folder"
                elif e.name == ".git" and e.is_dir(follow_symlinks=False):
                    for probe in ("index", "logs/HEAD", "FETCH_HEAD"):
                        try:
                            age = (now - os.stat(os.path.join(e.path, probe)).st_mtime) / 86400
                        except OSError:
                            continue
                        if age < DRAIN_WARM_DAYS:
                            live = f"git repo active {int(age)} d ago"
                            break
            if e.is_dir(follow_symlinks=False):
                stack.append((e.path, depth + 1))
    return size, newest, live


def drain_scan(hot: str) -> tuple:
    """Entries (one per top-level item or @loose group) and group members."""
    now, protected, open_by = time.time(), drain_protected(), open_files_by_entry(hot)
    entries, groups = [], {}

    def add(name, size, newest, status, reason):
        entries.append(Entry(name, size, int((now - newest) / 86400) if newest else -1, status, reason))

    for name in sorted(os.listdir(hot)):
        if name.startswith("."):
            continue
        path = os.path.join(hot, name)
        if os.path.islink(path):
            add(name, 0, 0, "skip", "drained already: " + os.readlink(path))
        elif name.endswith(MEDIA_SUFFIXES):
            add(name, 0, 0, "skip", "media library: use 'offload relocations'")
        elif name in protected:
            add(name, 0, 0, "skip", "owned by offload or a VM disk")
        elif os.path.isfile(path):
            groups.setdefault("@loose-" + KIND_OF.get(os.path.splitext(name)[1].lower(), "other"), []).append(name)
        else:
            size, newest, live = walk_entry(path, now)
            days = (now - newest) / 86400
            if name in open_by:
                add(name, size, newest, "live", f"open by {open_by[name]}")
            elif live:
                add(name, size, newest, "live", live)
            elif days < DRAIN_WARM_DAYS:
                add(name, size, newest, "warm", f"touched {int(days)} d ago")
            else:
                add(name, size, newest, "cold", "")
    for group, members in sorted(groups.items()):
        size, newest = 0, 0.0
        for m in members:
            s, n, _ = walk_entry(os.path.join(hot, m), now)
            size, newest = size + s, max(newest, n)
        files = f"{len(members)} file" + ("" if len(members) == 1 else "s")
        opened = [m for m in members if m in open_by]
        days = (now - newest) / 86400
        if opened:
            add(group, size, newest, "live", f"{opened[0]} open by {open_by[opened[0]]}")
        elif days < DRAIN_WARM_DAYS:
            add(group, size, newest, "warm", f"{files}, newest touched {int(days)} d ago")
        else:
            add(group, size, newest, "cold", files)
    return entries, groups


def drain_age(days: int) -> str:
    if days < 0:
        return "-"
    if days < 14:
        return f"{days} d"
    if days < 90:
        return f"{days // 7} wk"
    if days < 730:
        return f"{days // 30} mo"
    return f"{days // 365} yr"


def drain_sig(path: str) -> str:
    return tree_signature(path) if os.path.isdir(path) else f"files=1 bytes={os.lstat(path).st_size}"


def drain_one(name: str, dest_root: str) -> None:
    src, dst = os.path.join(S.hot, name), os.path.join(dest_root, name)
    log(f"=== drain {name} ===")
    if not os.path.lexists(src):
        die(f"{src} does not exist")
    if os.path.lexists(dst):
        conflict(f"Destination {dst} exists — manual review required")
    log(f"  Source sig: {drain_sig(src)}")
    run(["mkdir", "-p", dest_root])
    run(["rsync", "-a", f"{src}/", f"{dst}/"] if os.path.isdir(src) else ["rsync", "-a", src, dst])
    if S.dry:
        return
    s, d = drain_sig(src), drain_sig(dst)
    log(f"  Verify: src={s} dst={d}")
    if s != d:
        die("Signature mismatch — source preserved")
    run(["rm", "-rf", src])
    if os.path.lexists(src):
        die(f"{src} is still there after rm — not linking; finish by hand")
    run(["ln", "-s", dst, src])
    log(f"  DONE: {src} -> {dst}")


UNSAFE_NAME = re.compile(r'["$`\\]')


def cmd_drain(args: list) -> None:
    need_gib, names = 30, []
    i = 0
    while i < len(args):
        if args[i] == "--apply":
            S.dry = False
        elif args[i] == "--need":
            if i + 1 >= len(args):
                die("--need takes a number of GiB")
            need_gib, i = args[i + 1], i + 1
        else:
            names.append(args[i])
        i += 1
    if not str(need_gib).isdigit():
        die("--need takes a whole number of GiB")
    need_gib = int(need_gib)
    if not S.dry and not names:
        die("drain --apply needs the names to move. Run 'offload drain' for a plan.")
    hot, cold = require_drive("OFFLOAD_HOT"), require_drive("OFFLOAD_COLD")
    dest_root = os.path.join(cold, "Drained", os.path.basename(hot.rstrip("/")))

    log("=============================================")
    log(f"offload v{VERSION} drain  mode={mode()}  need={need_gib}GiB free on HOT")
    log("=============================================")
    report_space()
    log(f"  Scanning {hot}: sizes, ages, sync apps, git repos, open files (big drives take minutes)...")
    entries, groups = drain_scan(hot)
    by_name = {e.name: e for e in entries}

    plan, total = [], 0
    if names:
        for name in names:
            if "/" in name or UNSAFE_NAME.search(name):
                die(f"unsafe name: {name}")
            e = by_name.get(name)
            if not e:
                die(f"'{name}' is not on {hot} (see 'offload drain')")
            if e.status == "skip":
                die(f"'{name}' is not movable: {e.reason}")
            if e.status == "live":
                die(f"'{name}' is live ({e.reason}). Stop that first, then drain it.")
            if e.status == "warm":
                warn(f"  {name} was {e.reason}; moving it anyway, as named")
            plan.append(name)
            total += e.size
    else:
        gap = need_gib * GIB - free_bytes(hot)
        for e in sorted((e for e in entries if e.status == "cold"), key=lambda e: (-e.days, -e.size, e.name)):
            if total >= gap:
                break
            if UNSAFE_NAME.search(e.name):
                continue
            plan.append(e.name)
            total += e.size

    log(f"--- {hot} (* = in this plan) ---")
    log(f"    {'SIZE':>10}  {'TOUCHED':<7} {'STATE':<5} NAME")
    for status in ("cold", "warm", "live", "skip"):
        for e in sorted((e for e in entries if e.status == status), key=lambda e: (-e.size, e.name)):
            mark = "*" if e.name in plan else " "
            size = "-" if e.status == "skip" else human(e.size)
            reason = f"  ({e.reason})" if e.reason else ""
            log(f"  {mark} {size:>10}  {drain_age(e.days):<7} {e.status:<5} {e.name}{reason}")

    if not plan:
        if not names:
            log(f"  Nothing to suggest: HOT has {need_gib}GiB free, or nothing cold is left.")
        return
    log(f"--- Plan: {human(total)} to {dest_root}; each entry leaves a symlink ---")
    require_free(cold, total)
    if not names:
        log("  A suggestion: coldest first, cold entries only. Then:")
        log("    offload drain " + " ".join(shlex.quote(n) for n in plan) + " --apply")
        return
    for name in plan:
        for member in (groups.get(name, []) if name.startswith("@") else [name]):
            try:
                drain_one(member, dest_root)
            except PermissionDenied:
                warn(f"  STOPPED: {member} needs the admin pass")
    report_space()
    if S.dry:
        log("Dry run. Add --apply to move.")
    log(f"Done. Log: {S.log_path}")
    if S.admin_needed:
        emit_admin_pass()
        sys.exit(3)


