def strategy_symlink(src: str, dst: str, label: str) -> None:
    log(f"=== {label} (strategy=symlink) ===")
    if os.path.islink(src):
        if os.readlink(src) == dst:
            log(f"  SKIP: {src} already symlinked to {dst}")
            return
        conflict(f"{src} is a symlink to '{os.readlink(src)}', not '{dst}'")
    if not os.path.isdir(src):
        log(f"  SKIP: {src} missing")
        return
    if os.path.lexists(dst):
        conflict(f"Destination {dst} exists — manual review required")
    require_free(os.path.dirname(dst), du_bytes(src))
    log(f"  Source sig: {tree_signature(src)}")
    run(["mkdir", "-p", os.path.dirname(dst)])
    run(["rsync", "-a", f"{src}/", f"{dst}/"])
    if S.dry:
        return
    s, d = tree_signature(src), tree_signature(dst)
    log(f"  Verify: src={s} dst={d}")
    if s != d:
        die("Signature mismatch — source preserved")
    run(["rm", "-rf", src])
    if os.path.lexists(src):
        die(f"{src} is still there after rm — not linking; finish by hand")
    run(["ln", "-s", dst, src])
    if S.target_home.rstrip("/") != S.home.rstrip("/"):
        run(["chown", "-R", target_user(), dst])
    log(f"  DONE: {src} -> {dst}")


ROM_WORDS = ("mario", "zelda", "pokemon", "sonic", "metroid", "kirby", "gamecube", "nintendo")


def strategy_archive(src: str, dst: str, label: str) -> None:
    log(f"=== {label} (strategy=archive) ===")
    if not os.path.isdir(src):
        log(f"  SKIP: {src} missing")
        return
    if label == "Downloads" and S.hot and os.path.isdir(S.hot):
        roms_dst = os.path.join(S.hot, "ROMs")
        roms = sorted(e.path for e in os.scandir(src) if e.is_file() and e.name.endswith(".zip")
                      and any(w in e.name.lower() for w in ROM_WORDS))
        if roms:
            log(f"  Pre-filter: {len(roms)} ROM zip(s) -> {roms_dst}")
            run(["mkdir", "-p", roms_dst])
            for rom in roms:
                if os.path.exists(os.path.join(roms_dst, os.path.basename(rom))):
                    warn(f"    SKIP duplicate: {os.path.basename(rom)}")
                    continue
                run(["mv", "-n", rom, f"{roms_dst}/"])
    if os.path.lexists(dst):
        conflict(f"Destination {dst} exists — manual review required")
    require_free(os.path.dirname(dst), du_bytes(src))
    before = tree_signature(src)
    log(f"  Source sig: {before}")
    run(["mkdir", "-p", dst])
    run(["rsync", "-a", "--remove-source-files", f"{src}/", f"{dst}/"])
    if not S.dry:
        after = tree_signature(dst)
        log(f"  Verify: src={before} dst={after}")
        if after != before:
            die(f"Signature mismatch — check {dst} against what is left in {src} before anything else")
    run(["find", src, "-type", "d", "-empty", "-delete"])
    run(["mkdir", "-p", src])
    log(f"  DONE: {src} archived to {dst} (source recreated empty)")


def strategy_merge(src: str, dst: str, label: str) -> None:
    log(f"=== {label} (strategy=merge --update) ===")
    if not os.path.isdir(src):
        log(f"  SKIP: {src} missing")
        return
    if not os.path.isdir(dst):
        die(f"{dst} must already exist (merge target)")
    run(["rsync", "-av", "--update", f"{src}/", f"{dst}/"])
    if S.dry:
        return
    src_files = int(tree_signature(src).split()[0].split("=")[1])
    dst_files = int(tree_signature(dst).split()[0].split("=")[1])
    if dst_files < src_files:
        die(f"Dest has {dst_files} files, src had {src_files} — incomplete")
    run(["rm", "-rf", src])
    log(f"  DONE: {src} merged into {dst} (source removed)")


def strategy_sweep(src: str, _dst: str, label: str) -> None:
    log(f"=== {label} (strategy=sweep) ===")
    if not os.path.isdir(src):
        log(f"  SKIP: {src} missing")
        return
    manual_step("Confirm no active builds running (npm run dev, cargo watch, etc.)")
    total = 0
    for folder in sweep_dirs(src):
        size = du_bytes(folder)
        total += size
        log(f"  {size // 1024:>10} KB  {folder}")
        run(["rm", "-rf", folder])
    log(f"  Total: {human(total)}")


def strategy_purge(src: str, _dst: str, label: str) -> None:
    log(f"=== {label} (strategy=purge) ===")
    if not os.path.isdir(src):
        log(f"  SKIP: {src} missing")
        return
    log(f"  Source size: {du_human(src)}")
    run(["rm", "-rf", src])
    run(["mkdir", "-p", src])
    log(f"  DONE: {src} purged (recreated empty)")


def strategy_native_ui(_src: str, _dst: str, label: str) -> None:
    log(f"=== {label} (strategy=native-ui) ===")
    log("  This target is moved through the owning app's native UI.")
    log("  See 'offload relocations' for the procedure.")


STRATEGIES = {
    "symlink": ("OFFLOAD_HOT", strategy_symlink),
    "archive": ("OFFLOAD_COLD", strategy_archive),
    "merge": ("OFFLOAD_HOT", strategy_merge),
    "sweep": (None, strategy_sweep),
    "purge": (None, strategy_purge),
    "native-ui": (None, strategy_native_ui),
    "repos": (None, lambda src, dest, label: strategy_repos(src, dest, label)),
    "cloud": (None, lambda src, dest, label: strategy_cloud(src, dest, label)),
}


TIERED = ("symlink", "archive")   # strategies whose drive is picked at move time


def split_tier(dest: str) -> tuple:
    for tier in ("HOT", "COLD", "CLOUD"):
        if dest.startswith(tier + "/"):
            return tier, dest[len(tier) + 1:]
    return "", dest


def same_place(anchor: str, vol: str) -> bool:
    """anchor sits on vol's device and is reached without a symlink below vol."""
    if os.stat(anchor).st_dev != os.stat(vol).st_dev:
        return False
    expected = os.path.normpath(os.path.join(os.path.realpath(vol), os.path.relpath(anchor, vol)))
    return os.path.realpath(anchor) == expected


def resolve_dest(t: Target) -> Optional[str]:
    """The destination for a tiered move, picked now; None when the row is already done."""
    tier, rest = split_tier(t.dest)
    src, vols = t.source, candidates(tier)
    if os.path.islink(src):
        target = os.readlink(src)
        if any(target == f"{v}/{rest}" for v in vols):
            log(f"=== {t.label} (strategy={t.strategy}) ===")
            log(f"  SKIP: {src} already symlinked to {target}")
            return None
        conflict(f"{src} is a symlink to '{target}', not to {tier}/{rest} on a configured drive")
    if not os.path.isdir(src):
        return f"{(vols or [''])[0]}/{rest}"          # the strategy reports it missing
    if os.stat(os.path.realpath(src)).st_dev != os.stat(S.target_home).st_dev:
        conflict(f"{src} is not on the boot drive (it resolves to {os.path.realpath(src)}) — manual review required")
    for v in vols:
        if os.path.isdir(v) and os.path.lexists(f"{v}/{rest}"):
            conflict(f"Destination {v}/{rest} exists — manual review required")
    vol = pick_dest(tier, du_bytes(src), t.label)
    dest = f"{vol}/{rest}"
    if not same_place(nearest_existing(os.path.dirname(dest)), vol):
        conflict(f"{dest} would leave {vol} through a symlink or another device — manual review required")
    log(f"  Drive: {vol} ({tier})")
    return dest


def move_one(t: Target) -> None:
    if t.admin == "yes" and S.target_home.rstrip("/") == S.home.rstrip("/"):
        warn(f"  SKIP: {t.label} requires Admin mode. Re-run with --target-home <path> from a separate "
             "Admin account whose Terminal has Full Disk Access.")
        return
    if t.admin == "yes":
        assert_admin_invariants()
        assert_fda_granted()
    if t.strategy not in STRATEGIES:
        die(f"unknown strategy '{t.strategy}' for {t.label}")
    drive, strategy = STRATEGIES[t.strategy]
    tier, _ = split_tier(t.dest)
    try:
        if t.strategy in TIERED and tier:
            dest = resolve_dest(t)
            if dest is None:
                return
        elif t.strategy in ("repos", "cloud"):
            dest = t.dest                      # repos picks a drive per repo; cloud resolves CLOUD/ itself
        else:
            if drive:
                require_drive(drive)
            dest = expand(t.dest)
        strategy(t.source, dest, t.label)
    except PermissionDenied:
        warn(f"  STOPPED: {t.label} needs the admin pass; nothing more is done to it this run")


# ----------------------------------------------------------------------------
# Per-row state
# ----------------------------------------------------------------------------

def row_bytes(t: Target) -> int:
    """Bytes offloading this row would reclaim; 0 when done or absent."""
    src, strat = t.source, t.strategy
    if strat in ("symlink", "native-ui"):
        return du_bytes(src) if os.path.isdir(src) and not os.path.islink(src) else 0
    if strat == "archive":
        return du_bytes(src) if os.path.isdir(src) and not is_empty_dir(src) else 0
    if strat == "merge":
        return du_bytes(src) if os.path.isdir(src) else 0
    if strat == "sweep":
        return sum(du_bytes(d) for d in sweep_dirs(src)) if os.path.isdir(src) else 0
    if strat == "purge":
        return du_bytes(src) if readable_dir(src) else 0
    return 0


def row_state(t: Target) -> str:
    src, strat = t.source, t.strategy
    if strat == "symlink":
        if os.path.islink(src):
            return "symlinked" if os.path.isdir(src) else "broken-symlink"
        if readable_dir(src):
            return f"on-disk ({du_human(src)})"
        return "unreadable" if os.path.isdir(src) else "absent"
    if strat in ("archive", "purge"):
        if not os.path.isdir(src):
            return "absent"
        if not readable_dir(src):
            return "unreadable"
        if is_empty_dir(src):
            return "empty (likely already archived)" if strat == "archive" else "purged (empty)"
        return f"on-disk ({du_human(src)})"
    if strat == "merge":
        if readable_dir(src):
            return f"on-disk ({du_human(src)})"
        return "unreadable" if os.path.isdir(src) else "absent"
    if strat == "sweep":
        return f"{sum(1 for _ in sweep_dirs(src))} cruft dirs" if os.path.isdir(src) else "absent"
    if strat == "native-ui":
        if os.path.islink(src):
            return "symlinked (via native UI)"
        return f"on-disk ({du_human(src)})" if os.path.exists(src) else "absent"
    if strat == "repos":
        if not os.path.isdir(src):
            return "absent"
        repos = repo_find(src)
        cold = sum(repo_age_days(p) >= REPO_COLD_DAYS for p in repos)
        return f"{len(repos)} repos, {cold} cold (see 'offload repos')"
    return "unknown"


