def main(argv: list) -> int:
    args, i = [], 0
    while i < len(argv):
        if argv[i] == "--target-home":
            if i + 1 >= len(argv):
                die("--target-home takes a path")
            S.target_home, i = argv[i + 1], i + 1
        elif argv[i] == "--all-users":
            S.all_users = True
        elif argv[i] == "--benchmark":
            S.benchmark = True
        else:
            args.append(argv[i])
        i += 1
    sub = args[0] if args else "help"
    if sub not in COMMANDS:
        die(f"unknown subcommand: {sub} (try 'offload help')")
    if sub not in ("help", "-h", "--help", "version", "-V", "--version"):
        load_config()
    COMMANDS[sub](args[1:])
    return 0


if __name__ == "__main__":
    S.home = os.path.expanduser("~")
    S.target_home = S.home
    try:
        sys.exit(main(sys.argv[1:]))
    except Fatal as error:
        line = _stamp(f"FATAL: {error}")
        print(line, file=sys.stderr)
        _append_log(line)
        sys.exit(error.code)
    except KeyboardInterrupt:
        sys.exit(130)
