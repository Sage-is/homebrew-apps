def _stamp(message: str) -> str:
    return f"[{time.strftime('%H:%M:%S')}] {message}"


def _append_log(line: str) -> None:
    try:
        with open(S.log_path, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def log(message: str) -> None:
    line = _stamp(message)
    print(line, flush=True)
    _append_log(line)


def warn(message: str) -> None:
    line = _stamp(f"WARN: {message}")
    print(line, file=sys.stderr, flush=True)
    _append_log(line)


def die(message: str, code: int = 1):
    raise Fatal(message, code)


def conflict(message: str):
    die(message, 2)


def mode() -> str:
    return "DRY-RUN" if S.dry else "APPLY"


def human(n: int) -> str:
    """Bytes in numfmt's --to=iec-i style: 500B, 2.4GiB, 13GiB (rounded away from zero)."""
    if n < 1024:
        return f"{n}B"
    units = ["", "Ki", "Mi", "Gi", "Ti", "Pi", "Ei"]
    value, i = float(n), 0
    while value >= 1024 and i < len(units) - 1:
        value, i = value / 1024, i + 1
    if value < 10:
        rounded = math.ceil(value * 10) / 10
        if rounded < 10:
            return f"{rounded:.1f}{units[i]}B"
        value = rounded
    rounded = math.ceil(value)
    if rounded >= 1024 and i < len(units) - 1:
        return f"1.0{units[i + 1]}B"
    return f"{rounded}{units[i]}B"


# ----------------------------------------------------------------------------
# Configuration: read, never run
# ----------------------------------------------------------------------------

_ASSIGN = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)(\+?=)(.*)$")


def _unquote(raw: str, path: str, lineno: int) -> str:
    raw = raw.strip()
    if len(raw) >= 2 and raw[0] == raw[-1] == "'":
        return raw[1:-1]
    if len(raw) >= 2 and raw[0] == raw[-1] == '"':
        return os.path.expandvars(raw[1:-1])
    if re.search(r"[\s;&|`$()<>]", raw) and not raw.startswith("$"):
        die(f"{path}:{lineno}: quote this value: {raw}")
    return os.path.expandvars(raw)


def parse_conf(path: str) -> list:
    """Statements in order: (key, op, value), value a str or a list of rows."""
    statements, lines = [], open(path, encoding="utf-8").read().splitlines()
    i = 0
    while i < len(lines):
        lineno, line = i + 1, lines[i].strip()
        i += 1
        if not line or line.startswith("#"):
            continue
        m = _ASSIGN.match(line)
        if not m:
            die(f"{path}:{lineno}: not a KEY=value or KEY=( ... ) line (offload.conf is read, never run): {line}")
        key, op, rest = m.group(1), m.group(2), m.group(3).strip()
        if rest.startswith("("):
            body = rest[1:]
            while ")" not in _strip_quoted(body):
                if i >= len(lines):
                    die(f"{path}:{lineno}: list for {key} never closes")
                body += "\n" + lines[i]
                i += 1
            inner = body[:_close_paren(body)]
            items = []
            for item_line in inner.splitlines():
                item_line = item_line.strip()
                if not item_line or item_line.startswith("#"):
                    continue
                items.extend(shlex.split(item_line, comments=True))
            statements.append((key, op, items))
        else:
            if op == "+=":
                die(f"{path}:{lineno}: += needs a ( ... ) list")
            statements.append((key, op, _unquote(rest, path, lineno)))
    return statements


def _strip_quoted(text: str) -> str:
    return re.sub(r'"[^"]*"|\'[^\']*\'', "", text)


def _close_paren(text: str) -> int:
    quote = ""
    for pos, ch in enumerate(text):
        if quote:
            quote = "" if ch == quote else quote
        elif ch in "\"'":
            quote = ch
        elif ch == ")":
            return pos
    return len(text)


def load_config() -> None:
    S.conf = os.environ.get("OFFLOAD_CONF") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.join(S.home, ".config"), "offload", "offload.conf")
    S.hot = os.environ.get("OFFLOAD_HOT", "")
    S.cold = os.environ.get("OFFLOAD_COLD", "")
    if os.environ.get("OFFLOAD_HEADROOM", "").isdigit():
        S.headroom = int(os.environ["OFFLOAD_HEADROOM"])
    S.targets = list(DEFAULT_TARGETS)
    legacy_apps: list = []
    if os.path.isfile(S.conf):
        for key, op, value in parse_conf(S.conf):
            if key == "OFFLOAD_HOT":
                S.hot = value
            elif key == "OFFLOAD_COLD":
                S.cold = value
            elif key == "OFFLOAD_TARGETS":
                S.targets = (S.targets if op == "+=" else []) + list(value)
            elif key == "OFFLOAD_APPS":
                legacy_apps = (legacy_apps if op == "+=" else []) + list(value)
            elif key == "SWEEP_DIRNAMES":
                SWEEP_DIRNAMES[:] = (SWEEP_DIRNAMES if op == "+=" else []) + list(value)
            elif key == "OFFLOAD_DRIVES":
                S.drives = (S.drives if op == "+=" else []) + list(value)
            elif key == "OFFLOAD_PRIVATE_LABELS":
                S.private = (S.private if op == "+=" else []) + list(value)
            elif key == "OFFLOAD_REPO_KEEP":
                S.extra[key] = (S.extra.get(key, []) if op == "+=" else []) + list(value)
            elif key == "OFFLOAD_APPROVED_REMOTES":
                S.approved_remotes = (S.approved_remotes if op == "+=" else []) + list(value)
            elif key in ("OFFLOAD_HEADROOM", "OFFLOAD_BOOT_FREE_PCT"):
                if not str(value).isdigit() or not 0 <= int(value) < 100:
                    die(f"{S.conf}: {key} is a whole percent from 0 to 99, not '{value}'")
                if key == "OFFLOAD_HEADROOM":
                    S.headroom = int(value)
                else:
                    S.boot_free_pct = int(value)
    # Legacy OFFLOAD_APPS rows (label|source|bundle) join as app/symlink targets unless the label exists.
    labels = {row.split("|", 1)[0] for row in S.targets}
    for row in legacy_apps:
        label, src, bundle = (row.split("|") + ["", "", ""])[:3]
        if label not in labels:
            S.targets.append(f"{label}|app|{src}|HOT/MovedAppData/<U>/{label}|symlink|no|{bundle}")


