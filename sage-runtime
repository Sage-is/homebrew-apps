#!/bin/bash
set -euo pipefail

# sage-runtime: one switch between the container runtimes a Mac can carry.
#
# Colima, Docker Desktop and OrbStack can all be installed at once. Each runs
# its own engine with its own volumes and images, and the docker CLI talks to
# whichever one its context names. `use` starts one runtime, points docker at
# it, saves the choice where ai-ui and trellis-crm read it (~/.sage-is/runtime)
# and stops the others, since they all forward published ports to localhost.
# `copy-volume` and `copy-image` move data across, so nothing has to be
# migrated up front and Docker Desktop is never required. `build-vm` runs a
# second Colima VM, with Rosetta, for linux/amd64 and multi-arch builds.
# `convert` makes a vz Colima VM a krunkit one on the same data disk.

VERSION="0.1.0"
PROG="sage-runtime"
# The runtime code lives in lib/ beside this script, in a checkout and in the
# formula's libexec alike. A link to it, such as one in ~/bin, leads there.
here="${BASH_SOURCE[0]}"
while [[ -L "$here" ]]; do
  target="$(readlink "$here")"
  if [[ "$target" == /* ]]; then here="$target"; else here="$(dirname "$here")/$target"; fi
done
here="$(dirname "$here")"
[[ -f "$here/lib/sage-runtime.sh" ]] || { echo "Error: $here/lib/sage-runtime.sh is missing. Reinstall the formula (brew reinstall sage-runtime), or run sage-runtime from a checkout of the tap, which has lib/." >&2; exit 1; }
# shellcheck source=lib/sage-runtime.sh
source "$here/lib/sage-runtime.sh"
trap_cleanup

usage() {
  cat <<EOF
Usage: $PROG <command> [options]

Commands:
  status                  Which runtimes are installed and running, which one
                          docker uses, anything in ~/.docker that will break,
                          and what Docker Desktop left behind
  use RUNTIME [--keep-other]
                          Stop the other runtimes (unless --keep-other), then
                          start RUNTIME, point docker at it and remember it
  copy-volume NAME [--from RUNTIME] [--to RUNTIME] [--force]
                          Copy a named volume between runtimes (default: from
                          the one not in use to the one in use)
  copy-image REF [--from RUNTIME] [--to RUNTIME]
                          Copy an image between runtimes
  migrate [--from RUNTIME] [--images] [--dry-run]
                          Move to Colima: copy every named volume but buildx
                          caches (and with --images every tagged image) that
                          Colima lacks from RUNTIME (default docker-desktop),
                          then use colima. Anonymous volumes stay behind, and
                          RUNTIME keeps its copy. --dry-run starts nothing,
                          copies nothing and lists what the running side shows
  convert [--dry-run] [--yes]
                          Make the vz Colima VM a krunkit VM on the same data
                          disk, with every image and volume. Without --yes,
                          or with --dry-run, print the plan and change nothing
  build-vm [--stop]       Start (or stop) the build VM, for linux/amd64 and
                          multi-arch builds
  version                 Show the version

Runtimes: $RUNTIMES

\$SAGE_DATA (default ~/SageData) holds folders both runtimes mount, such as the
Sprig registry. Two runtimes writing there at once lose data, so use stops
the others before starting one. The build VM keeps running for its builds,
so use, build-vm, convert and the copy commands refuse while containers in
two runtimes, or in a runtime and the build VM, use it. An OrbStack engine
that runs with its app closed (orb start) counts as running: use stops it
with orb stop.

Docker Desktop is optional. With Colima in use, docker keeps its logins with
the Keychain helper, which Docker Desktop's helper only wraps: use colima
switches credsStore to osxkeychain, with a dated backup of config.json. use
also removes plugin links into Docker.app that lead nowhere. status names
what else Docker Desktop leaves behind, each with the line that mends it:
/var/run/docker.sock, its plugin hooks, its links in /usr/local/bin that
lead nowhere or block Homebrew's own and, with Colima in use, its Login
Item. $PROG never changes those itself.
Going back stays one line: $PROG use docker-desktop

Stop your apps before a copy: copy-volume and migrate refuse while running
containers on either side use the volume. A volume or image that will not fit
on the Mac or in the VM is refused; migrate --images names such an image and
goes on. A copy that fails or is interrupted leaves no half-made volume, and
each finished one is noted in ~/.sage-is/migrated. migrate never copies over
data Colima holds; while a volume there holds data no note vouches for,
migrate copies the rest but does not switch.

A new Colima VM gets virtiofs mounts with file events, half the Mac's cores
(2 to 8) and a 100 GiB disk. On Apple Silicon it is a krunkit VM: memory the
VM frees goes back to macOS, so it may take half the Mac's memory (4 to 12
GiB), and containers reach the GPU through Vulkan with
docker run --device /dev/dri, from an image whose Mesa Venus driver is
patched for krunkit, such as ghcr.io/unsuman/fedora-vgpu-llama. krunkit has
no Rosetta: linux/amd64 runs there only under QEMU emulation, so amd64 builds
belong on the build VM. Before $PROG makes a krunkit VM, it adds two
settings to Lima's override file, which every Colima VM reads:
  $LIMA_OVERRIDE
"mountType: virtiofs" (abiosoft/colima#1607) forces virtiofs mounts,
so a QEMU Colima profile will not start while it is there. A boot step
mounts the VM's data disk, which krunkit leaves unmounted after its first
boot (abiosoft/colima#1614). Docker keeps images and volumes on that disk:
on a krunkit VM, colima ssh -- findmnt /var/lib/docker shows /dev/vdc1,
and $PROG stops while Docker runs on the VM's root disk instead.
Without krunkit, Apple Silicon warns and uses vz with Rosetta. Get krunkit:
  $KRUNKIT_INSTALL
An Intel Mac uses vz without Rosetta. vz keeps memory it has touched, so a
vz VM gets a third of the Mac's memory (4 to 8 GiB). Override the sizes with
SAGE_RUNTIME_MEMORY (GiB), SAGE_RUNTIME_CPU and SAGE_RUNTIME_DISK (GiB). An
existing VM keeps its own settings.

convert turns a vz VM, made before krunkit was the default, into a krunkit
VM with the same memory, CPUs, disk and mounts (SAGE_RUNTIME_MEMORY and
SAGE_RUNTIME_CPU override the first two). colima delete takes the VM's root
disk, so convert goes on only while the VM shows Docker's data on its data
disk, and no container or volume keeps data in a folder of the root disk,
such as /srv/pg from docker run -v /srv/pg:... (the system's own folders do
not count). It records the VM's volumes, images and running containers in
~/.sage-is/convert, deletes the VM but never its data disk (no --data),
makes the krunkit VM on that disk, and compares. The delete also removes the
VM's Colima settings; a copy stays in ~/.sage-is. A mount it cannot carry
across, such as a key colima start has no flag for, keeps the VM vz.
Containers started with --rm go as the VM stops, with their anonymous
volumes, as they would at any stop. When anything is missing, it stops and
prints the way back to vz; once the cause is mended, convert --yes
finishes from the record. It refuses while containers in Colima and in
another runtime or the build VM use \$SAGE_DATA.

The build VM is a vz profile, with Rosetta on Apple Silicon, and a third of
the Mac's memory (9 to 12 GiB, room for AI-UI's multi-arch release), made
the first time build-vm runs. It never becomes docker's context: build on
it with DOCKER_CONTEXT=colima-$BUILD_PROFILE in front of the build command, and stop
it when done, since it keeps the memory a build touched.
EOF
}

need_docker() {
  command -v docker &>/dev/null || die "the docker CLI is missing. Install it: brew install docker"
}

# An option that takes a runtime, such as --from, needs one after it: a bare
# `shift 2` at the end of the line exits under set -e without a word.
need_value() {
  (( $# >= 2 )) || die "$1 needs a runtime: one of $RUNTIMES. See: $PROG --help"
}

# --- commands -----------------------------------------------------------------

cmd_status() {
  local rt mark current state problems=0
  current="$(current_runtime)"
  echo "Runtimes:"
  for rt in $RUNTIMES; do
    if ! runtime_installed "$rt"; then
      printf '  %-15s not installed\n' "$rt"
      continue
    fi
    mark=""
    [[ "$rt" == "$current" ]] && mark="  <- in use"
    if runtime_running "$rt"; then
      printf '  %-15s running, %s volumes%s\n' "$rt" \
        "$(briefly docker --context "$(runtime_context "$rt")" volume ls -q 2>/dev/null | wc -l | tr -d ' ')" "$mark"
    elif runtime_up "$rt"; then
      printf '  %-15s up, but its engine does not answer%s\n' "$rt" "$mark"
      if [[ "$rt" == "$current" ]]; then echo "  Restart $rt."; else echo "  Stop it: $PROG use $current"; fi
      problems=1
    else
      printf '  %-15s stopped%s\n' "$rt" "$mark"
    fi
  done
  # Colima tells whether the build VM runs: one whose docker stopped
  # answering still holds its memory.
  state="$(colima_state "$BUILD_PROFILE")"
  if [[ "$state" == Running ]]; then
    printf '  %-15s running; stop it when builds are done: %s build-vm --stop\n' "build VM" "$PROG"
  elif [[ -n "$state" ]]; then
    printf '  %-15s %s\n' "build VM" "$(echo "$state" | tr '[:upper:]' '[:lower:]')"
  fi
  echo "docker context: $(docker context show 2>/dev/null || echo none)"
  [[ "$(docker context show 2>/dev/null)" == "$(runtime_context "$current")" ]] \
    || { echo "  Not the runtime in use. Run: $PROG use $current"; problems=1; }

  local store leftovers
  store="$(plutil -extract credsStore raw -o - "$DOCKER_CONFIG_FILE" 2>/dev/null)" || store=""
  if [[ -n "$store" ]] && ! command -v "docker-credential-$store" &>/dev/null; then
    echo "credsStore \"$store\" has no helper on this Mac: pulls and logins will fail. Run: $PROG use $current"
    problems=1
  fi
  leftovers="$(desktop_leftovers "$current")"
  if [[ -n "$leftovers" ]]; then
    echo "$leftovers"
    problems=1
  fi
  if ! docker buildx version &>/dev/null; then
    echo "buildx not found. Install it: brew install docker-buildx (then: $PROG use $current)"
    problems=1
  fi
  local line
  while read -r line; do
    [[ -n "$line" ]] || continue
    echo "buildx builder ${line% *} points at the missing context ${line#* }. Remove it: docker buildx rm ${line% *}"
    problems=1
  done < <(stale_builders)
  (( problems == 0 )) && echo "No problems found."
  return 0
}

cmd_use() {
  local rt="" keep_other=0 other
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --keep-other) keep_other=1; shift ;;
      -*) die "unknown option $1" ;;
      *)  rt="$1"; shift ;;
    esac
  done
  check_runtime "$rt"
  fix_credentials "$rt"
  fix_plugin_dirs
  # Stop the others before starting this one: containers with a restart policy
  # come back as soon as a runtime starts, and two runtimes must never share
  # $SAGE_DATA or the published ports at the same moment. The build VM keeps
  # running for its builds, so the guard asks it even then.
  if (( keep_other == 0 )); then
    for other in $RUNTIMES; do
      if [[ "$other" != "$rt" ]] && runtime_installed "$other"; then stop_runtime "$other"; fi
    done
  fi
  start_runtime "$rt"
  guard_shared_data "$rt"
  docker context use "$(runtime_context "$rt")" >/dev/null
  mkdir -p "$SAGE_CONFIG_DIR"
  echo "$rt" > "$RUNTIME_FILE"
  echo "docker now uses $rt (context $(runtime_context "$rt")). ai-ui and trellis-crm follow."
  if [[ "$rt" == colima ]]; then hint_convert; fi
}

# --from and --to for the copy commands: the default copies from the other
# installed runtime into the one in use.
parse_copy() {
  FROM="" TO="" FORCE=0 ITEM=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from)  need_value "$@"; FROM="$2"; shift 2 ;;
      --to)    need_value "$@"; TO="$2"; shift 2 ;;
      --force) FORCE=1; shift ;;
      -*)      die "unknown option $1" ;;
      *)       ITEM="$1"; shift ;;
    esac
  done
  [[ -n "$ITEM" ]] || die "name what to copy. See: $PROG --help"
  TO="${TO:-$(current_runtime)}"
  if [[ -z "$FROM" ]]; then
    local rt
    for rt in $(installed_runtimes); do
      if [[ "$rt" != "$TO" ]]; then FROM="$rt"; break; fi
    done
  fi
  check_runtime "$FROM"
  check_runtime "$TO"
  [[ "$FROM" != "$TO" ]] || die "--from and --to are both $TO"
  start_runtime "$FROM"
  start_runtime "$TO"
  guard_shared_data "$TO"
}

cmd_copy_volume() {
  parse_copy "$@"
  copy_volume "$ITEM" "$FROM" "$TO" "$FORCE"
}

cmd_copy_image() {
  local why
  parse_copy "$@"
  why="$(image_fits "$FROM" "$TO" "$ITEM")" || die "$why"
  echo "Copying image $ITEM from $FROM to $TO..."
  copy_image "$(runtime_context "$FROM")" "$(runtime_context "$TO")" "$ITEM" || die "could not copy image $ITEM"
}

# One move from another runtime to Colima. buildx caches and anonymous
# volumes (64 hex digits) stay behind: on Colima an app's container starts
# with a new anonymous volume, so a copy would go unused. Each one a container
# still holds is named, since its data stays behind. Containers stay too; each
# app's own start command makes them anew.
# Nothing Colima holds with data is copied over, and all of it holds back the
# switch unless a recorded copy vouches for it, or the source's is empty. As
# many files, even the same size, may be other data: a database a trial run
# made, or a copy that stopped inside its last file. A dry run starts nothing,
# so it reads only what already runs.
cmd_migrate() {
  local from="docker-desktop" images=0 dry=0 src listing name t tk s copied ref size users why
  local volumes="" anonymous="" to_copy="" doubts="" failed="" verb="Copying" from_seen=1 colima_seen=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from)    need_value "$@"; from="$2"; shift 2 ;;
      --images)  images=1; shift ;;
      --dry-run) dry=1; shift ;;
      *)         die "unknown option $1" ;;
    esac
  done
  check_runtime "$from"
  [[ "$from" != colima ]] || die "migrate brings data into Colima; name the runtime it comes from"
  runtime_installed "$from" || die "$from is not installed, so there is nothing to migrate"
  src="$(runtime_context "$from")"
  if (( dry == 0 )); then
    start_runtime "$from"
    start_runtime colima
  else
    verb="Would copy"
    if ! runtime_running "$from"; then
      from_seen=0
      echo "Would start $from."
    fi
    if ! runtime_running colima; then
      colima_seen=0
      if colima_exists; then
        echo "Would start colima."
      else
        plan_colima default
        echo "Would create the Colima VM default ($VM_TYPE): $VM_SIZE."
      fi
    fi
    hint_convert
    if (( from_seen == 0 )); then
      echo "Dry run: $from is not running, so nothing in it was listed."
      return 0
    fi
    if (( colima_seen == 0 )); then
      echo "Colima is not running, so nothing was checked against it: a real run copies only what Colima lacks."
    fi
  fi
  guard_shared_data colima
  listing="$(briefly docker --context "$src" volume ls -q)" || die "could not list the volumes in $from"
  for name in $listing; do
    if [[ "$name" =~ ^[0-9a-f]{64}$ ]]; then
      anonymous+=" $name"
    elif [[ "$name" != buildx_buildkit_* ]]; then
      volumes+=" $name"
    fi
  done
  if [[ -n "$anonymous" ]]; then
    listing="$(container_mounts "$from" -a)" || exit 1
    for name in $anonymous; do
      users="$(users_of "$listing" "$name")"
      if [[ -n "$users" ]]; then
        echo "Leaving anonymous volume ${name:0:12} (used by $users) in $from: on Colima, its container starts with a new, empty one."
      fi
    done
  fi
  for name in $volumes; do
    t=0
    if (( colima_seen == 1 )) && volume_exists colima "$name"; then measure_volume colima "$name"; t=$ENTRIES tk=$KIB; fi
    if (( t <= 1 )); then
      to_copy+=" $name"
      continue
    fi
    measure_volume "$from" "$name"
    s=$ENTRIES
    copied="$(recorded_copy "$name" "$from" colima)"
    if [[ "$copied" == "$s $KIB" ]]; then
      echo "Skipping volume $name: copied from $from before, and its count and size there have not changed."
      continue
    fi
    if (( s == 1 )); then
      echo "Skipping volume $name: Colima has one with data, and $from's is empty."
      continue
    fi
    if [[ -n "$copied" ]]; then
      echo "Volume $name changed in $from after it was copied. Colima's copy stays as it is."
    else
      echo "Volume $name in Colima holds data no recorded copy vouches for: $s files and folders ($KIB KiB) in $from, $t ($tk KiB) in Colima. Colima's stays as it is."
    fi
    doubts+=" $name"
    echo "  To replace Colima's copy with $from's: $PROG copy-volume $name --from $from --to colima --force"
  done
  # Before the first copy. In the source every volume counts, since the switch
  # stops it under its apps; in Colima only those about to be copied.
  refuse_in_use "$from" "$volumes" colima "$to_copy"
  for name in $to_copy; do
    if (( dry == 1 )); then echo "$verb volume $name"; else copy_volume "$name" "$from" colima 0; fi
  done
  if (( images == 1 )); then
    listing="$(briefly docker --context "$src" images --filter dangling=false --format '{{.Repository}}:{{.Tag}}\t{{.Size}}')" \
      || die "could not list the images in $from"
    while IFS=$'\t' read -r ref size; do
      [[ -n "$ref" ]] || continue
      if [[ "$ref" == *:"<none>" ]]; then
        echo "Skipping image ${ref%:*}: it has no tag, only a digest. A pull or build on Colima brings it back."
        continue
      fi
      if (( colima_seen == 1 )) && briefly docker --context colima image inspect "$ref" &>/dev/null; then continue; fi
      echo "$verb image $ref ($size)"
      (( dry == 0 )) || continue
      if ! why="$(image_fits "$from" colima "$ref")"; then
        echo "Skipping image $ref: $why"
        failed+=" $ref"
      elif ! copy_image "$src" colima "$ref"; then
        failed+=" $ref"
      fi
    done <<< "$listing"
    if [[ -n "$failed" ]]; then
      echo "Warning: these images did not come across:$failed. Copy each later: $PROG copy-image REF --from $from --to colima" >&2
    fi
  fi
  if (( dry == 1 )); then
    echo "Dry run: nothing copied. Run again without --dry-run to move."
    if [[ -n "$doubts" ]]; then echo "A real run will not switch to Colima while these volumes may differ:$doubts"; fi
    return 0
  fi
  [[ -z "$doubts" ]] || die "not switching to Colima while these volumes may differ:$doubts. Replace each with its line above, or keep Colima's and switch: $PROG use colima"
  cmd_use colima
  echo "$from keeps its own copy; go back any time with: $PROG use $from"
  echo "Start your apps again on Colima (ai-ui start, trellis-crm start, docker compose up -d)."
}

# The conversion itself is the shared convert_colima.
cmd_convert() {
  local act=0 dry=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes)     act=1; shift ;;
      --dry-run) dry=1; shift ;;
      *)         die "unknown option $1" ;;
    esac
  done
  (( dry == 0 )) || act=0
  convert_colima "$act"
}

# The build VM is a second Colima profile: vz with Rosetta, so linux/amd64
# stages run near native speed, which a krunkit VM cannot do. It never becomes
# docker's context, so everyday work stays put while it starts; Colima keeps
# --activate=false with the VM, and every start passes it again for a VM made
# by hand. Builds name it per command (DOCKER_CONTEXT); the Makefiles' buildx
# builders follow the context, so each VM keeps its own builder. Colima tells
# whether it runs: one whose docker stopped answering still holds its memory.
cmd_build_vm() {
  local stop=0 ctx="colima-$BUILD_PROFILE" state
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stop) stop=1; shift ;;
      *)      die "unknown option $1" ;;
    esac
  done
  runtime_installed colima || die "Colima is not installed. Install it: $(runtime_install_command colima)"
  state="$(colima_state "$BUILD_PROFILE")"
  if (( stop == 1 )); then
    if [[ "$state" == Running ]]; then colima stop --profile "$BUILD_PROFILE"; fi
    echo "The build VM is stopped."
    return 0
  fi
  if [[ -z "$state" ]]; then
    start_new_colima "$BUILD_PROFILE"
  elif [[ "$state" != Running ]]; then
    colima start --profile "$BUILD_PROFILE" --activate=false
  fi
  if [[ "$state" != Running ]]; then STARTED+=" $ctx"; fi
  briefly docker --context "$ctx" info &>/dev/null \
    || die "the build VM runs, but its docker does not answer. Restart it: colima restart --profile $BUILD_PROFILE"
  # Restart policies bring its containers back as it starts. A Sprig registry
  # there beside one in a runtime would write $SAGE_DATA from two VMs and
  # claim port 5000 twice.
  guard_shared_data "$ctx"
  echo "The build VM is running (docker context $ctx). Build on it with:"
  echo "  DOCKER_CONTEXT=$ctx make <target>"
  echo "Stop it when done, since it keeps the memory a build touched: $PROG build-vm --stop"
}

case "${1:-}" in
  status|use|copy-volume|copy-image|migrate|convert|build-vm) need_docker ;;
esac
case "${1:-}" in
  status)              shift; cmd_status ;;
  use)                 shift; cmd_use "$@" ;;
  copy-volume)         shift; cmd_copy_volume "$@" ;;
  copy-image)          shift; cmd_copy_image "$@" ;;
  migrate)             shift; cmd_migrate "$@" ;;
  convert)             shift; cmd_convert "$@" ;;
  build-vm)            shift; cmd_build_vm "$@" ;;
  version|--version|-v) echo "$PROG $VERSION" ;;
  ""|help|-h|--help)   usage ;;
  *)                   usage >&2; exit 1 ;;
esac
