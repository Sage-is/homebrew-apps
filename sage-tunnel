#!/usr/bin/env python3
"""sage-tunnel: Cloudflare tunnels with fixed hostnames, made from the terminal.

    sage-tunnel version
    sage-tunnel list                          tunnels, their hostnames and live connections
    sage-tunnel create NAME HOSTNAME --service URL --env-file PATH
                                              a tunnel routed to HOSTNAME; its connector token
                                              goes into PATH at mode 600, never to the screen
    sage-tunnel route NAME HOSTNAME --service URL
                                              add HOSTNAME to an existing tunnel
    sage-tunnel unroute NAME HOSTNAME         remove a hostname and its DNS record
    sage-tunnel rotate NAME --env-file PATH [--keep-connectors]
                                              a new connector token into PATH; connectors
                                              still on the old one are disconnected
    sage-tunnel delete NAME [--yes]           the tunnel and every DNS record pointing at it

Credentials: CLOUDFLARE_API_TOKEN, scoped to Account > Cloudflare Tunnel: Edit and
Zone > DNS: Edit on each hostname's zone. CLOUDFLARE_ACCOUNT_ID picks the account
when the token sees more than one. Hand the token over with `sage-secret run`, so it
is never typed or printed.

A tunnel's routes live in Cloudflare, so its connector needs only the token. Hand it
to cloudflared as TUNNEL_TOKEN in its environment, never as `--token`: any process
list shows a command line. `create` writes CLOUDFLARED_TUNNEL_TOKEN and
CLOUDFLARED_HOSTNAME into the env file of the service that runs cloudflared.

A tunnel configured locally keeps its routes in a cloudflared config file instead,
where this tool cannot see them. `list` says so in place of its hostnames; `create`,
`route`, `unroute` and `delete` refuse such a tunnel and change nothing.

`rotate` changes nothing unless PATH holds a token for the tunnel, none for another,
and can be rewritten. Then it gives the tunnel a new secret and keeps its id, routes
and DNS. The new token goes to CLOUDFLARED_TUNNEL_TOKEN, and to TUNNEL_TOKEN when
that held the old one. Each keeps its line, so a ${...} reference below it still
resolves. The old token opens no new connections, but connectors already running
it stay up until they restart. So `rotate` disconnects them, as Cloudflare advises
for a leaked token, and the hostnames are offline until the service is recreated.
For a planned rotation, --keep-connectors leaves them serving until then.

This tool cannot write the vault, so a bw: reference in PATH stops `rotate` too.
A vault copy of a raw token in PATH goes dead with it; `rotate` prints the command
that replaces it.
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import secrets
import shlex
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

VERSION = "0.1.0"
CF_API = os.environ.get("SAGE_TUNNEL_API", "https://api.cloudflare.com/client/v4")
CATCH_ALL = {"service": "http_status:404"}
SCOPES = "Account > Cloudflare Tunnel: Edit and Zone > DNS: Edit"
LOCAL = "configured locally (cloudflared config, not the dashboard)"


class CloudflareError(RuntimeError):
    def __init__(self, message: str, codes: set[int]):
        super().__init__(message)
        self.codes = codes


class Cloudflare:
    def __init__(self, token: str):
        self.token = token
        self._account = None

    def call(self, method: str, path: str, data: dict | None = None) -> dict:
        req = urllib.request.Request(
            CF_API + path,
            data=json.dumps(data).encode("utf-8") if data is not None else None,
            method=method,
            headers={"Authorization": f"Bearer {self.token}", "Content-Type": "application/json"},
        )
        where = f"Cloudflare {method} {path.split('?')[0]}"
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                status, body = r.status, r.read()
        except urllib.error.HTTPError as e:
            status, body = e.code, e.read()
        try:
            payload = json.loads(body.decode("utf-8") or "{}")
        except ValueError:  # say, a proxy's HTML error page
            raise CloudflareError(f"{where}: HTTP {status}, not JSON", set()) from None
        if not payload.get("success"):
            errors = payload.get("errors") or []
            text = "; ".join(f"{x.get('code')} {x.get('message')}" for x in errors) or "failed"
            raise CloudflareError(f"{where}: {text}", {x.get("code") for x in errors})
        return payload["result"]

    def account(self) -> str:
        if self._account is None:
            self._account = os.environ.get("CLOUDFLARE_ACCOUNT_ID") or ""
            if not self._account:
                accounts = self.call("GET", "/accounts")
                if not accounts:
                    # A token scoped to one zone cannot list accounts, but its zones name theirs.
                    owners = {z["account"]["id"]: z["account"].get("name", "?")
                              for z in self.call("GET", "/zones?per_page=50") if z.get("account")}
                    accounts = [{"id": i, "name": n} for i, n in owners.items()]
                if len(accounts) != 1:
                    names = ", ".join(f"{a['name']} ({a['id']})" for a in accounts) or "none"
                    raise RuntimeError(f"the token sees {len(accounts)} accounts ({names}); set CLOUDFLARE_ACCOUNT_ID")
                self._account = accounts[0]["id"]
        return self._account

    def tunnel(self, name: str) -> dict | None:
        q = urllib.parse.urlencode({"name": name, "is_deleted": "false"})
        found = self.call("GET", f"/accounts/{self.account()}/cfd_tunnel?{q}")
        return found[0] if found else None

    def must_tunnel(self, name: str) -> dict:
        tunnel = self.tunnel(name)
        if tunnel is None:
            raise RuntimeError(f"no tunnel named {name}. See: sage-tunnel list")
        return tunnel

    def ingress(self, tunnel: dict) -> list[dict] | None:
        """The tunnel's hostname rules, or None for a tunnel configured locally."""
        # Cloudflare sends a local tunnel's connector no configuration, so one stored for it anyway, say by
        # an earlier PUT, is not what it serves. Its config_src decides first.
        if tunnel.get("config_src") == "local":
            return None
        try:
            config = self.call("GET", f"/accounts/{self.account()}/cfd_tunnel/{tunnel['id']}/configurations") or {}
        except CloudflareError as e:
            # 1055, configuration not found: a remote tunnel has none before its first route, and any
            # other tunnel keeps its routes in a cloudflared config file.
            if 1055 not in e.codes:
                raise
            return [] if tunnel.get("config_src") == "cloudflare" else None
        if config.get("source") == "local":
            return None
        rules = (config.get("config") or {}).get("ingress") or []
        return [r for r in rules if r.get("hostname")]

    def must_ingress(self, tunnel: dict) -> list[dict]:
        rules = self.ingress(tunnel)
        if rules is None:
            # Its hostnames are out of sight: route and unroute would write a configuration without
            # them, and delete would leave their DNS records behind.
            raise RuntimeError(f"tunnel {tunnel['name']} is {LOCAL}; manage it with cloudflared")
        return rules

    def set_ingress(self, tunnel_id: str, rules: list[dict]) -> None:
        self.call("PUT", f"/accounts/{self.account()}/cfd_tunnel/{tunnel_id}/configurations",
                  {"config": {"ingress": rules + [CATCH_ALL]}})

    def connectors(self, tunnel_id: str) -> list[dict]:
        # Tunnel objects lost their connections field on 2026-10-05; this endpoint replaced it.
        return self.call("GET", f"/accounts/{self.account()}/cfd_tunnel/{tunnel_id}/connections")

    def zone(self, hostname: str) -> dict:
        labels = hostname.split(".")
        for i in range(len(labels) - 1):
            name = ".".join(labels[i:])
            found = self.call("GET", f"/zones?{urllib.parse.urlencode({'name': name})}")
            if found:
                return found[0]
        raise RuntimeError(f"no zone this token can see holds {hostname}")

    def records(self, zone_id: str, hostname: str) -> list[dict]:
        return self.call("GET", f"/zones/{zone_id}/dns_records?{urllib.parse.urlencode({'name': hostname})}")


def target(tunnel_id: str) -> str:
    return f"{tunnel_id}.cfargotunnel.com"


def point_dns(cf: Cloudflare, hostname: str, tunnel_id: str) -> str:
    """A proxied CNAME from hostname to the tunnel. Never replaces another kind of record."""
    zone = cf.zone(hostname)
    record = {"type": "CNAME", "name": hostname, "content": target(tunnel_id), "proxied": True}
    existing = cf.records(zone["id"], hostname)
    other = [r for r in existing if r["type"] != "CNAME"]
    if other:
        kinds = ", ".join(sorted({r["type"] for r in other}))
        raise RuntimeError(f"{hostname} already has {kinds} records; remove them first, this tool replaces only a CNAME")
    if not existing:
        cf.call("POST", f"/zones/{zone['id']}/dns_records", record)
        return "created"
    if existing[0]["content"] == record["content"] and existing[0].get("proxied"):
        return "already pointed"
    cf.call("PUT", f"/zones/{zone['id']}/dns_records/{existing[0]['id']}", record)
    return f"repointed from {existing[0]['content']}"


def unpoint_dns(cf: Cloudflare, hostname: str, tunnel_id: str) -> bool:
    zone = cf.zone(hostname)
    for r in cf.records(zone["id"], hostname):
        if r["type"] == "CNAME" and r["content"] == target(tunnel_id):
            cf.call("DELETE", f"/zones/{zone['id']}/dns_records/{r['id']}")
            return True
    return False


def route(cf: Cloudflare, tunnel: dict, hostname: str, service: str) -> None:
    rules = [r for r in cf.must_ingress(tunnel) if r["hostname"] != hostname]
    cf.set_ingress(tunnel["id"], rules + [{"hostname": hostname, "service": service}])
    print(f"{hostname} -> {service} on tunnel {tunnel['name']}; DNS {point_dns(cf, hostname, tunnel['id'])}")


def write_env(path: Path, values: dict[str, str]) -> None:
    """Set KEY=VALUE lines in path, keeping every other line, at mode 600.
    A symlink or hard link to path still reaches the new values."""
    path = path.resolve()
    lines = path.read_text().splitlines() if path.exists() else []
    kept, new = [], dict(values)
    for line in lines:
        key = line.split("=", 1)[0].strip()
        if key not in values:
            kept.append(line)
        elif key in new:
            # The first line for a key takes the value, and later ones go: compose fills in a
            # ${KEY} reference only from the lines above it.
            kept.append(f"{key}={new.pop(key)}")
    text = "\n".join(kept + [f"{k}={v}" for k, v in new.items()]) + "\n"
    if path.exists() and path.stat().st_nlink > 1:
        # A new inode would leave the other links on the old values. chmod first: it can refuse,
        # and the write truncates.
        os.chmod(path, 0o600)
        path.write_text(text)
        return
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def create(cf: Cloudflare, name: str, hostname: str, service: str, env_file: Path) -> None:
    folder = env_file.resolve().parent  # write_env writes where a symlink points
    if not folder.is_dir():
        raise RuntimeError(f"no folder {folder} for the env file")
    tunnel = cf.tunnel(name)
    if tunnel is None:
        tunnel = cf.call("POST", f"/accounts/{cf.account()}/cfd_tunnel", {"name": name, "config_src": "cloudflare"})
        print(f"created tunnel {name}")
    else:
        print(f"tunnel {name} exists; reusing it")
    route(cf, tunnel, hostname, service)
    token = cf.call("GET", f"/accounts/{cf.account()}/cfd_tunnel/{tunnel['id']}/token")
    write_env(env_file, {"CLOUDFLARED_TUNNEL_TOKEN": token, "CLOUDFLARED_HOSTNAME": hostname})
    print(f"wrote CLOUDFLARED_TUNNEL_TOKEN (hidden) and CLOUDFLARED_HOSTNAME to {env_file} (mode 600)")
    print("Recreate the service so it reads the file; a restart keeps its old environment.")


def token_tunnel(token: str) -> str | None:
    """The id of the tunnel a connector token opens, or None for a value that is no token."""
    try:
        # cloudflared reads a token as base64 JSON: "a" the account, "t" the tunnel id, "s" its secret.
        # b64decode skips what is not base64, such as quotes around the value.
        return json.loads(base64.b64decode(token))["t"]
    except (ValueError, KeyError, TypeError):
        return None


def held_tokens(env_file: Path) -> dict[str, str]:
    """Each connector token in env_file, by key. As for docker and compose, the last line wins.
    TUNNEL_TOKEN is the key cloudflared reads itself, say in a container run with --env-file."""
    lines = (line.partition("=") for line in env_file.read_text().splitlines())
    return {key.strip(): value for key, _, value in lines
            if key.strip() in ("CLOUDFLARED_TUNNEL_TOKEN", "TUNNEL_TOKEN")}


def rotate(cf: Cloudflare, name: str, env_file: Path, keep: bool) -> None:
    if not env_file.is_file():
        raise RuntimeError(f"{env_file} is not a file; name the env file the service reads")
    tokens = held_tokens(env_file)
    for key, value in tokens.items():
        if value.strip(" \"'").startswith("bw:"):  # sage-secret run fills it in from the vault
            raise RuntimeError(f"{key} in {env_file} is a vault reference, and rotate cannot write the vault. "
                               "Put the raw token in the file, rotate, then replace the vault copy")
    held = {key: token_tunnel(value) for key, value in tokens.items()}
    if not held.get("CLOUDFLARED_TUNNEL_TOKEN"):
        raise RuntimeError(f"{env_file} has no tunnel token in CLOUDFLARED_TUNNEL_TOKEN; "
                           "name the env file the service reads")
    tunnel = cf.must_tunnel(name)
    for key, tid in held.items():
        if tid not in (None, tunnel["id"]):
            raise RuntimeError(f"{key} in {env_file} holds a token for tunnel {tid}, not {name} ({tunnel['id']})")
    keys = [key for key, tid in held.items() if tid]  # a value that is no token, such as ${...}, stays
    # The PATCH kills the old token, so first prove that the same write works on this file.
    write_env(env_file, {})
    path = f"/accounts/{cf.account()}/cfd_tunnel/{tunnel['id']}"
    secret = base64.b64encode(secrets.token_bytes(32)).decode()
    # From the PATCH on, whatever fails must say what it left behind, so these catch every exception.
    try:
        cf.call("PATCH", path, {"name": tunnel["name"], "tunnel_secret": secret})
    except Exception as e:
        # Cloudflare can apply it and still answer with an error, or lose the answer.
        raise RuntimeError(f"{e}\n  Cloudflare may have changed the secret anyway, and {env_file} still holds "
                           "the old token. Run rotate again before the service restarts.") from e
    print(f"rotated the token of tunnel {name}; its id, hostnames and DNS stay")
    try:
        write_env(env_file, dict.fromkeys(keys, cf.call("GET", f"{path}/token")))
    except Exception as e:
        raise RuntimeError(f"{e}\n  {env_file} still holds the old token, which opens no new connections. "
                           "Run rotate again before the service restarts.") from e
    print(f"wrote {' and '.join(keys)} (hidden) to {env_file} (mode 600)")
    print("If the vault holds the old token, replace it there without showing the new one:\n"
          f"  sage-secret run --env {shlex.quote(str(env_file))} -- "
          "sage-secret put ITEM --replace --from-env CLOUDFLARED_TUNNEL_TOKEN")
    # Connectors already running the old token stay up until they restart. Cut them off only once
    # the new token is on disk, so a failure before this point leaves the service serving.
    old = None
    try:
        old = cf.connectors(tunnel["id"])
    except Exception as e:
        # The list only shows who ran the old token, so the disconnect goes ahead without it.
        print(f"Warning: {e}", file=sys.stderr)
    if not keep:
        try:
            cf.call("DELETE", f"{path}/connections")
        except Exception as e:
            raise RuntimeError(f"{e}\n  The new token is in {env_file}, but connectors on the old one are still up. "
                               "To cut them off, run rotate again.") from e
    state = "serving until they restart" if keep else f"disconnected; {name} is down until the service is recreated"
    print(f"connectors on the old token: {'unknown' if old is None else len(old)}, {state}")
    for c in old or []:
        ips = ", ".join(sorted({x["origin_ip"] for x in c.get("conns") or [] if x.get("origin_ip")}))
        print(f"  {ips or '?'} since {c.get('run_at', '?')}")
    if old:
        print("An address you do not run means someone else used the old token.")
    print("Recreate the service so it reads the file; a restart keeps its old environment.")


def show(cf: Cloudflare) -> None:
    tunnels = cf.call("GET", f"/accounts/{cf.account()}/cfd_tunnel?is_deleted=false")
    if not tunnels:
        print("No tunnels.")
    for t in tunnels:
        rules = cf.ingress(t)
        hosts = LOCAL if rules is None else ", ".join(r["hostname"] for r in rules) or "no hostnames"
        live = sum(len(c.get("conns") or []) for c in cf.connectors(t["id"]))
        print(f"{t['name']:24} {t.get('status', '?'):9} {live:2} connections  {hosts}")


def delete(cf: Cloudflare, name: str, yes: bool) -> None:
    tunnel = cf.must_tunnel(name)
    hosts = [r["hostname"] for r in cf.must_ingress(tunnel)]
    if not yes:
        if not sys.stdin.isatty():
            raise RuntimeError(f"deleting {name} removes {', '.join(hosts) or 'no hostnames'}; run again with --yes")
        if input(f"Delete tunnel {name} and the DNS for {', '.join(hosts) or 'nothing'}? Type yes: ") != "yes":
            raise RuntimeError("nothing changed")
    for host in hosts:
        if unpoint_dns(cf, host, tunnel["id"]):
            print(f"removed DNS for {host}")
    cf.call("DELETE", f"/accounts/{cf.account()}/cfd_tunnel/{tunnel['id']}")
    print(f"deleted tunnel {name}")


def cli() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="sage-tunnel", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("version")
    sub.add_parser("list")
    c = sub.add_parser("create")
    c.add_argument("name")
    c.add_argument("hostname")
    c.add_argument("--service", required=True, help="where the connector sends traffic, e.g. http://localhost:8000")
    c.add_argument("--env-file", required=True, type=Path, help="the file that receives the connector token")
    r = sub.add_parser("route")
    r.add_argument("name")
    r.add_argument("hostname")
    r.add_argument("--service", required=True)
    u = sub.add_parser("unroute")
    u.add_argument("name")
    u.add_argument("hostname")
    o = sub.add_parser("rotate")
    o.add_argument("name")
    o.add_argument("--env-file", required=True, type=Path, help="the file that receives the new connector token")
    o.add_argument("--keep-connectors", action="store_true",
                   help="a planned rotation: connectors on the old token serve until they restart")
    d = sub.add_parser("delete")
    d.add_argument("name")
    d.add_argument("--yes", action="store_true")
    return parser


def main(argv: list[str]) -> int:
    args = cli().parse_args(argv[1:])
    if args.cmd == "version":
        print(f"sage-tunnel {VERSION}")
        return 0
    token = os.environ.get("CLOUDFLARE_API_TOKEN", "")
    if not token:
        print(f"Error: CLOUDFLARE_API_TOKEN is not set. It needs {SCOPES}.\n"
              "  Hand it over without typing it: sage-secret run -- sage-tunnel ...", file=sys.stderr)
        return 1
    cf = Cloudflare(token)
    try:
        if args.cmd == "list":
            show(cf)
        elif args.cmd == "create":
            create(cf, args.name, args.hostname, args.service, args.env_file)
        elif args.cmd == "route":
            route(cf, cf.must_tunnel(args.name), args.hostname, args.service)
        elif args.cmd == "unroute":
            tunnel = cf.must_tunnel(args.name)
            cf.set_ingress(tunnel["id"], [r for r in cf.must_ingress(tunnel) if r["hostname"] != args.hostname])
            gone = unpoint_dns(cf, args.hostname, tunnel["id"])
            print(f"{args.hostname} removed from {args.name}" + ("; DNS removed" if gone else "; it had no DNS record here"))
        elif args.cmd == "rotate":
            rotate(cf, args.name, args.env_file, args.keep_connectors)
        elif args.cmd == "delete":
            delete(cf, args.name, args.yes)
    except (RuntimeError, OSError) as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
