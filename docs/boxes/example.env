# A Sage.is box: copy this to ~/.sage-is/boxes/<name>.env, chmod 600, fill it in.
# sage-secret resolves the bw: references a command needs from the vault when
# sage-box runs, and no others; nothing here is a secret, only the names of
# secrets. A value runs to the end
# of its line, so comments stay on lines of their own. Paths on the box are
# absolute (no ~). Keep this file out of every repo: it names a host and a login.

# The box on the tailnet, and its login (the short name).
BOX_HOST=100.64.0.1
BOX_USER=admin
# Where the operators reach boxes from: addresses or CIDR ranges, comma-separated, no spaces.
# Every key line on the box carries it as from="...", and every window certificate as source-address.
BOX_OPERATORS=100.64.0.0/10

# The read key (an ed25519 private key in the vault): status, read and the dry run use it alone.
# The box holds it to a fixed list of read verbs (docs/boxes/access.md).
BOX_READ_KEY=bw:<box>-read-key

# Legacy admin door, until windows work on this box: the private SSH key and the login's password.
# A new box goes without them: admin work runs inside a window (sage-box <box> unlock) or --as-me.
# BOX_SSH_KEY=bw:<box>-ssh-key
# BOX_SUDO=bw:<box>-user

# source | image | peer. 1 when the box runs AI-UI too (installed, started as it is).
BOX_MODE=source
BOX_AI_UI=1

# source mode: Trellis runs from this checkout on the box; sage-box <box> update pulls it.
# The deploy key is read-only, registered on Sage-is/trellis.
BOX_CHECKOUT=/Users/admin/Documents/Projects/WEB-AI-Sage-Trellis
BOX_DEPLOY_KEY=bw:<box>-trellis-deploy-key

# source and image modes: the Trellis image is a private package; a classic token with read:packages only.
BOX_GHCR_USER=your-github-login
BOX_GHCR_TOKEN=bw:github-packages-read

# sage | realestate; the port; the address people use (behind a tunnel, its https address); the review times.
BOX_PROFILE=realestate
BOX_PORT=8030
BOX_URL=http://localhost:8030
BOX_REVIEW_AT=15:00
BOX_SHIFT_END=18:00

# Backups: the box backs itself up nightly at 02:00; sage-box <box> backup pulls the newest copy here,
# encrypted to the age recipient, whose private half lives in the vault.
BOX_BACKUP_DIR=/Volumes/Somma 02 14TB/Backups/boxes/<box>
BOX_BACKUP_TO=age1...
