# step NAME FOUND ACTION RUNNER: an empty ACTION means the box already has it.
step() {
  local name="$1" found="$2" action="$3" runner="${4:-}"
  if [[ -z "$action" ]]; then
    printf '  ok     %-9s %s\n' "$name" "$found"
  elif [[ $APPLY == 1 ]]; then
    printf '  doing  %-9s %s\n' "$name" "$action"
    "$runner"
  else
    printf '  would  %-9s %s (found: %s)\n' "$name" "$action" "$found"
    CHANGES=$((CHANGES + 1))
  fi
}

