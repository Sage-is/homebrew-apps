# The settings only trellis-crm start does not take: written as trellis-crm
# writes them, one KEY= line each, then start again reads them.
run_trellis() {
  local source_flag="--no-source"
  [[ "$BOX_MODE" != source ]] || source_flag="--source $(printf '%q' "$BOX_CHECKOUT")"
  remote 'F=~/.sage-is/trellis-crm.env
[ -f "$F" ] || trellis-crm start --profile "$BOX_PROFILE" --url "$BOX_URL" --port "$BOX_PORT" '"$source_flag"' 2>&1 | tail -3
for pair in "REVIEW_AT=$BOX_REVIEW_AT" "SHIFT_END=$BOX_SHIFT_END"; do
  k="${pair%%=*}"; v="${pair#*=}"; [ -n "$v" ] || continue
  T="$(mktemp "$F.XXXXXX")"; grep -v "^$k=" "$F" > "$T" || true; echo "$k=$v" >> "$T"; chmod 600 "$T"; mv "$T" "$F"
done
trellis-crm start --profile "$BOX_PROFILE" --url "$BOX_URL" --port "$BOX_PORT" '"$source_flag"' 2>&1 | tail -3'
}

run_aiui() {
  remote 'ai-ui start 2>&1 | tail -2
'"$AI_UI_CONNECT"' 2>/dev/null || true'
}

step_trellis() {
  [[ "$BOX_MODE" != peer ]] || return 0
  local want_source=""
  [[ "$BOX_MODE" != source ]] || want_source="$BOX_CHECKOUT"
  local differs=""
  [[ "$found_profile" == "$BOX_PROFILE" ]] || differs="$differs profile"
  [[ "$found_source" == "$want_source" ]] || differs="$differs source"
  [[ -z "$BOX_REVIEW_AT" || "$found_review_at" == "$BOX_REVIEW_AT" ]] || differs="$differs REVIEW_AT"
  [[ -z "$BOX_SHIFT_END" || "$found_shift_end" == "$BOX_SHIFT_END" ]] || differs="$differs SHIFT_END"
  if [[ "$found_trellis" == up && -z "$differs" ]]; then
    step trellis "up on :$BOX_PORT, profile $found_profile${found_source:+, from $found_source}" ""
  elif [[ "$found_trellis" == up ]]; then
    step trellis "up, but${differs} differ" "set${differs} and start again (trellis-crm start $BOX_MODE mode)" run_trellis
  else
    step trellis "down" "trellis-crm start --profile $BOX_PROFILE $([[ "$BOX_MODE" == source ]] && echo "--source $BOX_CHECKOUT" || echo --no-source)" run_trellis
  fi
  if [[ "$BOX_AI_UI" == 1 ]]; then
    if [[ "$found_aiui" == up ]]; then step ai-ui "up on :8080" ""; else step ai-ui "down" "ai-ui start" run_aiui; fi
  fi
