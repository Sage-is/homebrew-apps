  [[ "$BOX_MODE" != source ]] || want_source="$BOX_CHECKOUT"
  local differs=""
  [[ "$found_profile" == "$BOX_PROFILE" ]] || differs="$differs profile"
  [[ "$found_source" == "$want_source" ]] || differs="$differs source"
  [[ -z "$BOX_REVIEW_AT" || "$found_review_at" == "$BOX_REVIEW_AT" ]] || differs="$differs REVIEW_AT"
  [[ -z "$BOX_SHIFT_END" || "$found_shift_end" == "$BOX_SHIFT_END" ]] || differs="$differs SHIFT_END"
  if [[ "$found_trellis" == up && -z "$differs" ]]; then
    step trellis "up on :$BOX_PORT, profile $found_profile${found_source:+, from $found_source}" ""
  elif [[ "$found_trellis" == up ]]; then
    step trellis "up, but${differs} differ" "set${differs} and start again (trellis-crm start $BOX_MODE mode)" run_trellis
  else
    step trellis "down" "trellis-crm start --profile $BOX_PROFILE $([[ "$BOX_MODE" == source ]] && echo "--source $BOX_CHECKOUT" || echo --no-source)" run_trellis
  fi
  if [[ "$BOX_AI_UI" == 1 ]]; then
    if [[ "$found_aiui" == up ]]; then step ai-ui "up on :8080" ""; else step ai-ui "down" "ai-ui start" run_aiui; fi
  fi
}

backup_plist() {
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$BACKUP_LABEL</string>
  <key>UserName</key><string>$BOX_USER</string>
  <key>ProgramArguments</key><array><string>/opt/homebrew/bin/trellis-crm</string><string>backup</string><string>--dir</string><string>/Users/$BOX_USER/$STAGING_REL</string></array>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>/Users/$BOX_USER</string><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/$BOX_USER/.sage-is/logs/trellis-backup.log</string>
  <key>StandardErrorPath</key><string>/Users/$BOX_USER/.sage-is/logs/trellis-backup.log</string>
</dict></plist>
EOF
}

run_backup_daemon() {
  remote 'mkdir -p ~/.sage-is/logs'$'\n'"$(root_call backup-daemon)"
}

# A trellis-crm without backup --dir would fail every night under the new
# LaunchDaemon, as quietly as 0.1.0's unloaded one did: --apply stops first.
old_trellis_crm() {
  die "trellis-crm $found_trellis_crm on $THE_BOX has no backup --dir, so the nightly backup would fail. Upgrade it first: $PROG $THE_BOX update, then --apply again"
}

step_backups() {
  [[ "$BOX_MODE" != peer ]] || return 0
  if [[ "$found_backup_dir" != yes && "$found_trellis_crm" != missing ]]; then
    step backups "trellis-crm $found_trellis_crm has no backup --dir" "stop: upgrade trellis-crm first ($PROG $THE_BOX update)" old_trellis_crm
  elif [[ "$found_backup_daemon" == yes && "$found_backup_plist" == "$(backup_plist | digest)" ]]; then
    step backups "trellis-crm backup --dir runs nightly at 02:00" ""
  elif [[ "$found_backup_daemon" == yes ]]; then
    # The old one wrote a whole .tar.gz each night; the pull wants the staging folder.
    step backups "the LaunchDaemon $BACKUP_LABEL differs from this $PROG's" "install it again: trellis-crm backup --dir ~/$STAGING_REL (02:00, as $BOX_USER)" run_backup_daemon
  elif [[ "$found_backup_daemon" == unloaded ]]; then
    # The plist alone proves nothing: 0.1.0 wrote it and its bootstrap failed, so no backup ever ran.
    step backups "the LaunchDaemon $BACKUP_LABEL is there, but launchd never loaded it" "load it again (02:00, as $BOX_USER)" run_backup_daemon
  else
    step backups "no nightly backup" "install the LaunchDaemon $BACKUP_LABEL (02:00, as $BOX_USER); this Mac pulls it with: $PROG <box> backup --nightly" run_backup_daemon
  fi
}

verify() {
  probe
  local ok=1
  if [[ "$BOX_MODE" != peer ]]; then
    printf '  %-9s %s\n' trellis "$found_trellis"; [[ "$found_trellis" == up ]] || ok=0
  fi
  if [[ "$BOX_AI_UI" == 1 ]]; then
    printf '  %-9s %s\n' ai-ui "$found_aiui"; [[ "$found_aiui" == up ]] || ok=0
    # Only Trellis calls sage-ai by name, and only trellis-crm makes sage-network: a peer box has none to judge. AI-UI down already fails the run.
    if [[ "$BOX_MODE" != peer && "$found_aiui" == up ]]; then
      if [[ "$found_aiui_net" == yes ]]; then
        printf '  %-9s %s\n' network "$AI_UI_CONTAINER is on $AI_UI_NETWORK"
      else
        printf '  %-9s %s\n' network "$AI_UI_CONTAINER is not on $AI_UI_NETWORK (on the box: $AI_UI_CONNECT)"; ok=0
      fi
    fi
  fi
  printf '  %-9s %s\n' vm "${found_vm:-none}"
  printf '  %-9s %s\n' boot "$found_boot"
  [[ $ok == 1 ]]
}

# The connection drops as the box goes down, so ssh's own 255 is the usual answer.
run_reboot() {
  local waited=0 status=0
  echo "Restarting the box..."
  remote "$(root_call reboot)" || status=$?
  [[ $status == 0 || $status == 255 ]] || die "the box did not restart; the root helper answered $status"
  sleep 20
  until ssh -o ConnectTimeout=5 "${SSH_OPTS[@]}" "${DOOR_OPTS[@]}" "$(target)" true </dev/null 2>/dev/null; do
    sleep 10; waited=$((waited + 10))
    [[ $waited -lt 420 ]] || die "the box did not answer within 7 minutes of the restart. FileVault on? Someone unlocks it at the screen."
  done
  echo "Back after about $((waited + 20)) s; giving the apps a minute."
  sleep 60
}

# --apply goes through an admin door. The dry run looks through the read key,
# or with --as-me through an admin door, for a box that has no read key yet.
cmd_plan() {
  local name="$1"
  if [[ $APPLY == 1 ]]; then
    load_box "$name" apply
    open_admin_door "$name"
  elif [[ $AS_ME == 1 ]]; then
    load_box "$name" plan
    open_admin_door "$name"
  else
    load_box "$name" look
    open_read_door "$name"
  fi
  [[ -n "$READ_PUB" ]] || die "$(box_file "$name") needs BOX_READ_KEY=bw:$name-read-key: the keys step puts its public half on the box (docs/boxes/access.md)"
  [[ -n "$BOX_OPERATORS" ]] || die "$(box_file "$name") needs BOX_OPERATORS, the addresses the operators reach boxes from (100.64.0.0/10 is the whole tailnet): every key line on the box names them"
  load_cas
  echo "$name: $(target), $BOX_MODE mode$([[ "$BOX_AI_UI" == 1 ]] && echo ", with AI-UI"), $DOOR_WORDS"
  probe
  echo "Found: $found_os on $found_arch, FileVault $found_filevault"
  if [[ $APPLY == 1 ]]; then echo "Plan, applying:"; else echo "Plan (nothing changes without --apply):"; fi
  # First: the helper they install runs every root step after them.
  step_access
  step_keys
  step_tools
  if [[ $APPLY == 1 ]]; then probe; fi  # the tools step may have installed what the next ones need
  step_runtime
  step_leftovers
  step_power
  step_code
  step_registry
  step_trellis
  step_backups
  if [[ $APPLY == 1 ]]; then
    echo "Verify:"
    verify || die "something is still down; see above"
    if [[ $REBOOT == 1 ]]; then
      run_reboot
      echo "Verify after the restart:"
      verify || die "the box came back, but not everything did; see above"
    fi
    echo "Done. $name is a Sage.is box."
  elif [[ $CHANGES == 0 ]]; then
    echo "Nothing to change."
  else
    echo "$CHANGES change(s). Run them: $PROG $name --apply"
  fi
}

# A step of the update that fails stops the update, also one behind "| tail":
# -e stops the script, pipefail makes a pipe report the failure and not tail's
# success. The scripts say so themselves, not prelude: the grep | tail lines of
# the other scripts would fail on an empty match.
update_remote() {
  remote $'set -eo pipefail\n'"$2" || die "the update stopped at $1 on the box; the steps after it did not run"
}

cmd_update() {
  local name="$1"
  load_box "$name" admin
  open_admin_door "$name"
  echo "Updating $name, $DOOR_WORDS..."
  update_remote "brew upgrade" 'brew update >/dev/null 2>&1 || true; brew upgrade '"$(tools_wanted)"' 2>&1 | grep -vE "^==> (Downloading|Pouring|Fetching)|^\s*$" | tail -3 || true'
  if [[ "$BOX_MODE" != peer ]]; then
    if [[ "$BOX_MODE" == source ]]; then
      # This pulls BOX_CHECKOUT; trellis-crm update pulls the TRELLIS_SOURCE in the box's settings. Only --apply makes them one checkout.
      update_remote "git pull" 'git -C "$BOX_CHECKOUT" pull --ff-only 2>&1 | tail -1; git -C "$BOX_CHECKOUT" log -1 --format="  checkout at %h %s"'
    fi
    update_remote "trellis-crm update" 'trellis-crm update 2>&1 | tail -2'
    [[ "$BOX_AI_UI" != 1 ]] || update_remote "ai-ui start" 'ai-ui start 2>&1 | tail -1
'"$AI_UI_CONNECT"' 2>/dev/null || true'
  fi
  echo "Verify:"
  verify || die "something is down after the update; see above"
}

# --- backups on this Mac: snapshots that never recopy --------------------------------
# The box refreshes one staging folder at 02:00 (trellis-crm backup --dir): the
# database, kept as it was when nothing changed, and each artifact once. This
# Mac pulls that folder with brew's rsync through the backup key into a dated
# snapshot inside an encrypted APFS sparse bundle (BOX_BACKUP_DIR), attached for
# the pull alone. Only what changed crosses the network: a changed database as
# rsync's changed blocks, a new artifact whole. Every file that did not change
# is a hard link to the snapshot before (--link-dest), so it takes no space
# twice, and the bundle's unchanged bands never upload again.
#
# Not rsync_tmbackup.sh, which this Mac's own snapshots use. With a remote
# source it runs nothing over ssh but rsync, so rrsync would take it. But its
# ssh is fixed, -e 'ssh -p PORT -o StrictHostKeyChecking=no -o
# UserKnownHostsFile=/dev/null': it checks no host key, and it cannot hold the
# pull to the backup key, so ssh would offer the person's own keys first. Its
# --strategy sets a variable nothing reads, so it cannot thin as below, and it
# moves `latest` after a failed run.

bundle_mount() { echo "$SNAPSHOT_MOUNTS/$1"; }
newest_file() { echo "$SNAPSHOT_MOUNTS/$1.last"; }

# BOX_BACKUP_DIR names the bundle by its absolute path; it may hold spaces.
check_bundle_path() {
  [[ -n "$BOX_BACKUP_DIR" ]] || die "$(box_file "$1") needs BOX_BACKUP_DIR: the encrypted sparse bundle on this Mac that holds $1's snapshots, such as /Volumes/<drive>/Backups/boxes/$1.sparsebundle"
  [[ "$BOX_BACKUP_DIR" == /*.sparsebundle ]] || die "BOX_BACKUP_DIR in $(box_file "$1") names an encrypted sparse bundle by its absolute path, ending in .sparsebundle: $BOX_BACKUP_DIR"
}

# The pull needs brew's rsync here. Apple's /usr/bin/rsync is openrsync, an
# older protocol without the options the box's rrsync is built for.
check_rsync_here() {
  local first
  first="$(rsync --version 2>/dev/null | head -1 || true)"
  [[ "$first" =~ ^rsync\ +version\ +[3-9]\. ]] || die "the pull needs brew's rsync 3 here, first on the PATH (brew install rsync). This Mac's rsync says: ${first:-nothing}"
}

# The snapshot folders in MNT, oldest first: their names sort by time. Never
# latest, a link, nor a pull that broke off.
snapshots() {
  local path
  for path in "$1"/*; do
    if [[ -d "$path" && ! -L "$path" && "${path##*/}" =~ $SNAPSHOT_RE ]]; then echo "${path##*/}"; fi
  done
}

detach_bundle() {
  hdiutil detach "$1" -quiet 2>/dev/null || hdiutil detach "$1" -force -quiet 2>/dev/null ||
    echo "Warning: the bundle is still attached at $1. Detach it: hdiutil detach \"$1\"" >&2
}

# The passphrase reaches hdiutil on stdin, never on a command line. The bundle
# is detached as the run ends, however it ends.
attach_bundle() {
  local name="$1" mnt
  mnt="$(bundle_mount "$name")"
  [[ -d "$BOX_BACKUP_DIR" ]] || die "no sparse bundle at $BOX_BACKUP_DIR (is its drive attached?). Make it once: $PROG $name backup --init"
  mkdir -p "$mnt"
  chmod 700 "$SNAPSHOT_MOUNTS" "$mnt"
  # A run that died while attached left the bundle there.
  if /sbin/mount | grep -qF " on $mnt ("; then detach_bundle "$mnt"; fi
  printf '%s' "$BOX_BACKUP_SPARSE" | hdiutil attach -stdinpass -nobrowse -noautoopen -owners on -mountpoint "$mnt" "$BOX_BACKUP_DIR" >/dev/null ||
    die "hdiutil could not attach $BOX_BACKUP_DIR with the passphrase from the vault (BOX_BACKUP_SPARSE); nothing was pulled"
  at_exit "detach_bundle $(printf '%q' "$mnt")"
  MOUNTED="$mnt"
}

# Every snapshot of the last 2 days stays; then the newest of each day, to 30
# days; then the newest of each week, to a year; older ones go. The newest of
# all always stays, whatever its age.
thin_snapshots() {
  local mnt="$1" now snap when age bucket kept="" newest=1
  now="$(date +%s)"
  for snap in $(snapshots "$mnt" | sort -r); do
    if [[ $newest == 1 ]]; then newest=0; continue; fi
    when="$(date -j -f %Y-%m-%d-%H%M%S "$snap" +%s 2>/dev/null)" || continue
    age=$((now - when))
    if ((age < 2 * 86400)); then continue
    elif ((age < 30 * 86400)); then bucket="day-${snap:0:10}"
    elif ((age < 365 * 86400)); then bucket="week-$(date -j -f %Y-%m-%d-%H%M%S "$snap" +%G-%V)"
    else bucket=""
    fi
    if [[ -n "$bucket" && " $kept " != *" $bucket "* ]]; then kept="$kept $bucket"; continue; fi
    rm -rf "${mnt:?}/$snap"
    echo "  thinned $snap"
  done
}

backup_pull() {
  local name="$1" mnt prev stamp work out word leftover rsh="ssh" status=0
  load_box "$name" backup
  [[ "$BOX_MODE" != peer ]] || die "a peer box has no Trellis to back up"
  check_bundle_path "$name"
  [[ -n "${BOX_BACKUP_SPARSE:-}" ]] || die "$(box_file "$name") needs BOX_BACKUP_SPARSE=bw:$name-backup-sparse, the bundle's passphrase in the vault (backup --init stores it)"
  check_rsync_here
  open_backup_door "$name"
  # rsync starts ssh itself, so the door's options ride in its -e, each word
  # quoted for rsync's own splitting. A quote inside one could not ride.
  for word in "${SSH_OPTS[@]}" "${DOOR_OPTS[@]}"; do
    [[ "$word" != *"'"* ]] || die "an ssh option holds a single quote, which rsync's -e cannot carry: $word"
    rsh="$rsh '$word'"
  done
  attach_bundle "$name"
  mnt="$MOUNTED"
  prev="$(snapshots "$mnt" | tail -1)"
  stamp="$(date +%Y-%m-%d-%H%M%S)"
  # A name a second: a second pull within the same second waits for the next.
  while [[ -e "$mnt/$stamp" ]]; do sleep 1; stamp="$(date +%Y-%m-%d-%H%M%S)"; done
  work="$mnt/$stamp.partial"
  # A pull that broke off left its folder: this one finishes it, so what
  # crossed then does not cross again.
  for leftover in "$mnt"/*.partial; do
    if [[ -d "$leftover" ]]; then
      [[ "$leftover" == "$work" ]] || mv "$leftover" "$work"
      echo "Finishing the pull that broke off in ${leftover##*/}"
      break
    fi
  done
  mkdir -p "$work"
  out="$(mktemp)"
  at_exit "rm -f $(printf '%q' "$out")"
  echo "Pulling $name's staging folder $DOOR_WORDS${prev:+; files unchanged since $prev are linked, not copied}..."
  # No --rsync-path: the box's door picks brew's rsync, and rrsync refuses a
  # command that does not start with plain rsync.
  rsync -rlpt --compress --stats ${prev:+"--link-dest=$mnt/$prev"} -e "$rsh" "$(target):" "$work/" > "$out" || status=$?
  if [[ $status != 0 ]]; then
    die "the pull from $name failed (rsync said $status). ${work##*/} stays, and the next pull finishes it; the newest snapshot is still ${prev:-none}"
  fi
  mv "$work" "$mnt/$stamp"
  ln -sfn "$stamp" "$mnt/latest"
  echo "$stamp" > "$(newest_file "$name")"
  grep -E '^(Number of regular files transferred|Total transferred file size|Total bytes received):' "$out" | sed 's/^/  /' || true
  thin_snapshots "$mnt"
  echo "Snapshot $stamp in $BOX_BACKUP_DIR; $(snapshots "$mnt" | wc -l | tr -d ' ') kept."
}

# A new bundle, and its passphrase in the vault before the bundle exists: a
# bundle whose passphrase lives nowhere else is lost. The passphrase is made
# here and travels on stdin alone. An item that exists is never replaced from
# here, since it may open a bundle already.
backup_init() {
  local name="$1" ref item pass
  load_box "$name" none
  [[ "$BOX_MODE" != peer ]] || die "a peer box has no Trellis to back up"
  check_bundle_path "$name"
  ref="$(named_ref BOX_BACKUP_SPARSE)"
  [[ "$ref" =~ ^bw:[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "$(box_file "$name") needs BOX_BACKUP_SPARSE=bw:$name-backup-sparse, a vault item of its own (no /FIELD): --init stores the bundle's passphrase there"
  item="${ref#bw:}"
  [[ ! -e "$BOX_BACKUP_DIR" ]] || die "$BOX_BACKUP_DIR exists already; --init makes a new bundle only. Its passphrase is bw:$item"
  [[ -d "$(dirname "$BOX_BACKUP_DIR")" ]] || die "no folder $(dirname "$BOX_BACKUP_DIR") for the bundle (is its drive attached?)"
  command -v sage-secret &>/dev/null || die "sage-secret is not installed: brew install $TAP/sage-secret"
  pass="$(head -c 32 /dev/urandom | base64 | tr -d '\n')"
  if ! printf '%s' "$pass" | sage-secret put "$item" --stdin; then
    unset pass
    die "the vault refused $item, so no bundle was made"
  fi
  if ! printf '%s' "$pass" | hdiutil create -size "$BUNDLE_SIZE" -type SPARSEBUNDLE -fs APFS -encryption AES-256 -stdinpass -volname "$name snapshots" "$BOX_BACKUP_DIR" >/dev/null; then
    unset pass
    die "hdiutil could not create $BOX_BACKUP_DIR. The vault holds its new passphrase as $item, which opens nothing: remove that item, then --init again"
  fi
  unset pass
  echo "Created $BOX_BACKUP_DIR: APFS, AES-256, $BUNDLE_SIZE at most. Its passphrase is in the vault as bw:$item."
  echo "Pull into it: $PROG $name backup. Nightly at 03:30: $PROG $name backup --nightly"
}

cmd_backup() {
  local name="$1" mode=pull
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --init)    mode=init ;;
      --nightly) mode=nightly ;;
      *) die "backup takes --init, --nightly, or nothing" ;;
    esac
    shift
  done
  case "$mode" in
    init) backup_init "$name" ;;
    pull) backup_pull "$name" ;;
    nightly)
      # The nightly pull is a file on this Mac: no secret, no door. It checks
      # what the 03:30 run will resolve, so that run does not fail alone.
      load_box "$name" none
      [[ "$BOX_MODE" != peer ]] || die "a peer box has no Trellis to back up"
      check_bundle_path "$name"
      named BOX_BACKUP_KEY && named BOX_BACKUP_SPARSE ||
        die "$(box_file "$name") needs BOX_BACKUP_KEY=bw:$name-backup-key and BOX_BACKUP_SPARSE=bw:$name-backup-sparse: the 03:30 pull resolves both"
      install_pull_agent "$name" ;;
  esac
}

# A launchd agent on this Mac pulls the box's backup at 03:30, after the box's 02:00 run.
install_pull_agent() {
  local name="$1" dir="${LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
  local label="is.sage.box-backup-$name"
  local plist="$dir/$label.plist"
  mkdir -p "$dir" "$SAGE_CONFIG_DIR/logs"
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array><string>$(command -v "$PROG" || echo "$0")</string><string>$name</string><string>backup</string></array>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>$HOME</string><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>$SAGE_CONFIG_DIR/logs/box-backup-$name.log</string>
  <key>StandardErrorPath</key><string>$SAGE_CONFIG_DIR/logs/box-backup-$name.log</string>
</dict></plist>
EOF
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null || true
  echo "This Mac pulls $name's backup nightly at 03:30: $plist (log: $SAGE_CONFIG_DIR/logs/box-backup-$name.log)"
}

# The nightly backup in one line: whether launchd holds the job, and how old the
# newest backup on the box is. A job that is not loaded, or no backup within
# BACKUP_STALE_HOURS, says WARNING: a plist on disk once read as "yes" while no
# backup had ever run.
backup_words() {
  local job age
  case "$found_backup_daemon" in
    yes) job="loaded (02:00)" ;;
    unloaded) job="WARNING: installed but not loaded, so it never runs; fix: $PROG $THE_BOX --apply" ;;
    *) job="WARNING: no LaunchDaemon; fix: $PROG $THE_BOX --apply" ;;
  esac
  age="$found_backup_age"
  if [[ ! "$age" =~ ^[0-9]+$ ]]; then
    echo "$job; WARNING: no backup on the box yet"
  elif ((age > BACKUP_STALE_HOURS)); then
    echo "$job; WARNING: the newest backup is ${age} h old"
  else
    echo "$job; newest backup ${age} h old"
  fi
}

# Through the read key: status works with BOX_READ_KEY alone in the vault.
cmd_status() {
  local name="$1"
  load_box "$name" read
  open_read_door "$name"
  probe
  echo "$name: $(target), $BOX_MODE mode"
  printf '  %-9s %s\n' tools "$(tools_found)"
  printf '  %-9s %s\n' vm "${found_vm:-none} (docker context ${found_context:-none})"
  printf '  %-9s %s\n' boot "$found_boot, autorestart ${found_autorestart:-?}, sleep ${found_sleep:-?}"
  printf '  %-9s %s\n' ups "$found_ups"
  if [[ "$BOX_MODE" != peer ]]; then
    printf '  %-9s %s\n' trellis "$found_trellis, profile ${found_profile:-?}${found_source:+, from $found_source}"
    printf '  %-9s %s\n' nightly "$(backup_words)"
  fi
  [[ "$BOX_AI_UI" != 1 ]] || printf '  %-9s %s\n' ai-ui "$found_aiui"
  [[ -z "$BOX_TUNNEL" ]] || printf '  %-9s %s\n' tunnel "$(tunnel_words)"
  [[ -z "$BOX_BACKUP_DIR" ]] || printf '  %-9s %s\n' backups "$(snapshot_words "$name")"
  printf '  %-9s %s\n' window "$(window_state "$name")"
}

# The newest snapshot on this Mac, from the note each pull leaves beside the
# bundle's mount point: status reads it without the bundle's passphrase.
snapshot_words() {
  local last when age
  last="$(cat "$(newest_file "$1")" 2>/dev/null || true)"
  when=""
  [[ ! "$last" =~ $SNAPSHOT_RE ]] || when="$(date -j -f %Y-%m-%d-%H%M%S "$last" +%s 2>/dev/null || true)"
  if [[ -z "$when" ]]; then
    echo "none pulled yet into $BOX_BACKUP_DIR"
    return 0
  fi
  age=$((($(date +%s) - when) / 3600))
  if ((age > BACKUP_STALE_HOURS)); then
    echo "WARNING: the newest snapshot is $age h old ($last), in $BOX_BACKUP_DIR"
  else
    echo "newest snapshot $age h old ($last), in $BOX_BACKUP_DIR"
  fi
}

tunnel_words() {
  case "$found_tunnel_daemon" in
    yes) echo "$BOX_TUNNEL: loaded, cloudflared at power-on" ;;
    unloaded) echo "WARNING: $BOX_TUNNEL is installed but not loaded; fix: $PROG $THE_BOX tunnel install --env-file PATH" ;;
    *) echo "WARNING: no LaunchDaemon for $BOX_TUNNEL; fix: $PROG $THE_BOX tunnel install --env-file PATH" ;;
  esac
}

# --- mailboxes -----------------------------------------------------------------------

# Arguments as words the box's bash reads back exactly: spaces and quotes survive.
quoted() {
  [[ $# -eq 0 ]] || printf ' %q' "$@"
}

# A box that runs Trellis, through an admin door. WHAT names what a peer box lacks.
trellis_box() {
  load_box "$1" admin
  [[ "$BOX_MODE" != peer ]] || die "a peer box runs no Trellis, so it has no $2"
  open_admin_door "$1"
}

# Every mailbox command but secret goes through as typed. stdin stays here:
# nothing on the box reads it.
cmd_mailbox() {
  local name="$1"
  shift
  if [[ "${1:-}" == secret ]]; then shift; cmd_mailbox_secret "$name" "$@"; return; fi
  trellis_box "$name" mailboxes
  remote "trellis-crm mailbox$(quoted "$@")" </dev/null
}

# The password lives in one shell variable, travels on stdin alone (printf is
# a builtin, so no process list shows it) and is unset after. --from resolves
# the vault item on this Mac: the reference rides in a child's environment,
# and sage-secret run hands that child the value.
cmd_mailbox_secret() {
  local name="$1" mailbox="${2:-}" from="" prompt=0 vault="" replace=0 clear=0 password="" again="" status=0
  local how="$PROG $name mailbox secret NAME (--from bw:ITEM[/FIELD] | --prompt [--vault ITEM [--replace]] | --clear)"
  [[ -n "$mailbox" && "$mailbox" != -* ]] || die "name the mailbox: $how"
  shift 2
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from)    [[ $# -ge 2 ]] || die "--from needs bw:ITEM or bw:ITEM/FIELD"; from="$2"; shift 2 ;;
      --prompt)  prompt=1; shift ;;
      --vault)   [[ $# -ge 2 ]] || die "--vault needs the vault item's name"; vault="${2#bw:}"; shift 2 ;;
      --replace) replace=1; shift ;;
      --clear)   clear=1; shift ;;
      # Never echo it: a password typed here by mistake would land in the terminal.
      *) die "mailbox secret takes no such argument. $how" ;;
    esac
  done
  [[ $((${from:+1} + prompt + clear)) == 1 ]] || die "pick one of --from, --prompt or --clear. $how"
  [[ -z "$vault" || $prompt == 1 ]] || die "--vault goes with --prompt: an item from --from is in the vault already"
  [[ $replace == 0 || -n "$vault" ]] || die "--replace goes with --vault"
  [[ -z "$from" || "$from" == bw:?* ]] || die "--from takes a vault reference, bw:ITEM or bw:ITEM/FIELD. A password never goes on a command line."
  [[ $prompt == 0 || -t 0 ]] || die "--prompt reads from a terminal. From a script, put the password in the vault and use --from bw:ITEM"
  trellis_box "$name" mailboxes
  if [[ $clear == 1 ]]; then
    remote "trellis-crm mailbox secret $(printf '%q' "$mailbox") --clear" </dev/null
    return
  fi
  if [[ -n "$from" ]]; then
    # shellcheck disable=SC2016 # the child expands the variable, after sage-secret resolves it
    password="$(SAGE_BOX_MAILBOX_SECRET="$from" sage-secret run -- /bin/sh -c 'printf "%s" "$SAGE_BOX_MAILBOX_SECRET"')" \
      || die "the vault did not give $from; nothing reached the box"
    [[ -n "$password" ]] || die "$from is empty in the vault; nothing reached the box"
  else
    IFS= read -rs -p "Password for mailbox $mailbox: " password || true
    echo >&2
    IFS= read -rs -p "The same again: " again || true
    echo >&2
    if [[ -z "$password" || "$password" != "$again" ]]; then
      unset password again
      die "the two entries differ or are empty; nothing changed"
    fi
    unset again
    if [[ -n "$vault" ]]; then
      local put=(sage-secret put "$vault" --stdin)
      [[ $replace == 0 ]] || put+=(--replace)
      printf '%s' "$password" | "${put[@]}" || { unset password; die "the vault refused $vault; nothing reached the box"; }
    fi
  fi
  printf '%s' "$password" | remote_stdin "trellis-crm mailbox secret $(printf '%q' "$mailbox") --stdin" || status=$?
  unset password
  if [[ $status != 0 && -n "$vault" ]]; then
    echo "The vault holds it as bw:$vault. Send it again: $PROG $name mailbox secret$(quoted "$mailbox") --from bw:$vault" >&2
  fi
  return "$status"
}

# --- Trellis's manage.py, a fixed few -------------------------------------------------

# trellis-crm manage on the box holds the list and refuses the rest with exit
# 2: seed_profile, loaddata NAME, import_sheet /app/FILE.csv --sheet NAME
# [--create]. Here every argument travels quoted, as mailbox's do, and the exit
# code comes back. Nothing reads stdin on the box.
cmd_manage() {
  local name="$1"
  shift
  [[ $# -gt 0 ]] || die "manage takes a command: seed_profile, loaddata NAME, or import_sheet /app/FILE.csv --sheet NAME [--create]"
  trellis_box "$name" "manage.py commands"
  remote "trellis-crm manage$(quoted "$@")" </dev/null
}

# --- a capture folder to import --------------------------------------------------------

# The folder lands in the checkout as mockups/imports/NAME: git ignores
# mockups/, and Trellis's container mounts the checkout at /app, so trellis-crm
# manage import_incumbent reads it there. It travels as base64 on stdin through
# the admin door (a NUL byte survives no shell), unpacks into NAME.new and only
# then replaces NAME, so a broken push leaves the last good one. umask 077: the
# capture holds real people's data.
cmd_import() {
  local name="$1" verb="${2:-}" dir="${3:-}" label="${4:-}" checkout
  [[ "$verb" == push && $# -eq 4 ]] || die "import takes: push DIR NAME"
  [[ -d "$dir" ]] || die "no folder at $dir"
  [[ "$label" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "NAME is letters, digits, _ and -, starting with a letter or digit"
  trellis_box "$name" "checkout to import into"
  [[ "$BOX_MODE" == source ]] || die "import push needs a source-mode box: the folder lands in its checkout, which Trellis mounts at /app"
  checkout="$(printf '%q' "$BOX_CHECKOUT")"
  echo "Sending $dir to $name as /app/mockups/imports/$label, $DOOR_WORDS..."
  tar -C "$dir" -cf - . | base64 | remote_stdin "set -e; umask 077; d=$checkout/mockups/imports/$label; rm -rf \"\$d.new\"; mkdir -p \"\$d.new\"; base64 -d | tar -xf - -C \"\$d.new\"; rm -rf \"\$d\"; mv \"\$d.new\" \"\$d\"; echo \"  \$(du -sh \"\$d\" | cut -f1) in \$d\""
}

# --- the tunnel ------------------------------------------------------------------------

# What the box sources at each start of the tunnel: NAME=value lines, comments
# and blank lines. bash reads the file with `.`, so a value takes only what
# needs no quoting, and a $ or a quote could not run anything there. A bad line
# is named by its number, never printed: it may hold the token.
check_tunnel_env() {
  local file="$1" mode line n=0 token=0
  local skip_re='^[[:space:]]*(#.*)?$' line_re='^[A-Z_][A-Z0-9_]*=[A-Za-z0-9+/=._:-]*$'
  [[ -f "$file" ]] || die "no env file at $file. sage-tunnel create NAME HOSTNAME --service URL --env-file $file writes one"
  mode="$(stat -f %Lp "$file" 2>/dev/null || stat -c %a "$file")"
  [[ "$mode" == 600 || "$mode" == 400 ]] || die "$file is mode $mode and holds a tunnel token. First: chmod 600 \"$file\""
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    [[ ! "$line" =~ $skip_re ]] || continue
    [[ "$line" =~ $line_re ]] || die "$file: line $n is not NAME=value with a plain value (letters, digits, + / = . _ : -)"
    [[ "$line" != CLOUDFLARED_TUNNEL_TOKEN=?* ]] || token=1
  done < "$file"
  [[ $token == 1 ]] || die "$file has no CLOUDFLARED_TUNNEL_TOKEN, which the tunnel's LaunchDaemon reads"
}

# The env file reaches the box on stdin, at mode 600 from its first byte, then
# the root helper loads the LaunchDaemon for BOX_TUNNEL. The token never rides
# on a command line, and no output here prints it.
cmd_tunnel() {
  local name="$1" file=""
  shift
  [[ "${1:-}" == install ]] || die "tunnel takes: install --env-file PATH"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --env-file) [[ $# -ge 2 && -n "$2" ]] || die "--env-file needs the file sage-tunnel create wrote"; file="$2"; shift 2 ;;
      *) die "tunnel install takes --env-file PATH and nothing else" ;;
    esac
  done
  [[ -n "$file" ]] || die "tunnel install needs --env-file PATH, the file sage-tunnel create wrote"
  check_tunnel_env "$file"
  load_box "$name" admin
  [[ -n "$BOX_TUNNEL" ]] || die "$(box_file "$name") needs BOX_TUNNEL=<the tunnel's name>: the root helper's LaunchDaemon names it"
  open_admin_door "$name"
  echo "Sending the tunnel's env file to $name, $DOOR_WORDS..."
  remote_stdin 'set -e
umask 077
mkdir -p "$HOME/.sage-is/tunnels" "$HOME/.sage-is/logs"
F="$HOME/.sage-is/tunnels/'"$BOX_TUNNEL"'.env"
T="$(mktemp "$F.XXXXXX")"
cat > "$T"
mv "$T" "$F"
echo "  $F, mode 600"
'"$(root_call tunnel-daemon)"'
echo "  the LaunchDaemon '"$TUNNEL_LABEL"' runs cloudflared for '"$BOX_TUNNEL"' at power-on, as '"$BOX_USER"'"' < "$file"
}

# --- the read key and the window ------------------------------------------------------

# One read verb through the read key, its output as the box gave it.
cmd_read() {
  local name="$1" verb="${2:-}"
  [[ $# -eq 2 && " $READ_VERBS " == *" $verb "* ]] || die "read takes one verb: $READ_VERBS"
  load_box "$name" read
  open_read_door "$name"
  read_remote "$name" "$verb"
}

# A window: a fresh key in $UNLOCK_DIR/<box>, and a certificate for it that the
# person's FIDO CA signs ($SAGE_BOX_CA, a touch). The box checks the principal,
# the address and the expiry; this Mac only picks the door.
cmd_unlock() {
  local name="$1" hours=$DEFAULT_HOURS dir ca_type ca_key id end
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --hours) [[ $# -ge 2 ]] || die "--hours needs a number of hours, 1 to $MAX_HOURS"; hours="$2"; shift 2 ;;
      *) die "unlock takes --hours N and nothing else" ;;
    esac
  done
  # A longer window is refused, never trimmed: whoever asked for six hours decides again.
  [[ "$hours" =~ ^[0-9]$ && $hours -ge 1 && $hours -le $MAX_HOURS ]] || die "--hours takes a whole number from 1 to $MAX_HOURS; '$hours' is refused, not trimmed"
  load_box "$name" none
  [[ -n "$BOX_OPERATORS" ]] || die "$(box_file "$name") needs BOX_OPERATORS: the certificate holds the window to those addresses"
  [[ -n "${SAGE_BOX_CA:-}" ]] || die "SAGE_BOX_CA names your FIDO CA key's handle, such as ~/.ssh/sage-box-ca (docs/boxes/access.md)"
  [[ -f "$SAGE_BOX_CA" && -f "$SAGE_BOX_CA.pub" ]] || die "SAGE_BOX_CA: no key handle and .pub at $SAGE_BOX_CA"
  read -r ca_type ca_key _ < "$SAGE_BOX_CA.pub" || true
  is_sk_type "$ca_type" || die "$SAGE_BOX_CA is a ${ca_type:-empty} key. A window CA lives on a FIDO device (ed25519-sk or ecdsa-sk), so each window takes a touch"
  grep -qsF " $ca_key" "$CA_DIR"/*.pub || die "$SAGE_BOX_CA.pub is not in $CA_DIR, so no box trusts it. Copy it there, then a person runs: $PROG $name --as-me --apply"
  dir="$UNLOCK_DIR/$name"
  mkdir -p "$dir"
  chmod 700 "$UNLOCK_DIR" "$dir"
  close_master window
  rm -f "$dir/key" "$dir/key.pub" "$dir/key-cert.pub"
  ssh-keygen -q -t ed25519 -N '' -C "sage-window:$name" -f "$dir/key" || die "ssh-keygen could not make the window's key"
  chmod 600 "$dir/key"
  id="$(id -un)-$name-$(date -u +%Y%m%dT%H%M%SZ)"
  echo "Signing a $hours-hour window for $name with $SAGE_BOX_CA. Touch the key when it blinks."
  # -O clear: no forwarding and no terminal; source-address: the operators only.
  # The box's CA line says the same, so the box holds the line either way.
  if ! ssh-keygen -q -s "$SAGE_BOX_CA" -I "$id" -n "$WINDOW_PRINCIPAL" -V "+${hours}h" -O clear -O "source-address=$BOX_OPERATORS" "$dir/key.pub"; then
    rm -f "$dir/key" "$dir/key.pub" "$dir/key-cert.pub"
    die "the CA did not sign (no touch, or the key is not plugged in); $name stays locked"
  fi
  chmod 600 "$dir/key-cert.pub"
  end="$(window_end "$name")" || die "the new certificate is not valid now; check this Mac's clock"
  echo "$name: window open until $(date -r "$end" +%H:%M) (key ID $id). Admin verbs use it. Close it early: $PROG $name lock"
}

# Ends the window now: its key goes, and so does the connection it opened.
cmd_lock() {
  local name="$1" dir="$UNLOCK_DIR/$1"
  load_box "$name" none
  close_master window
  rm -f "$dir/key" "$dir/key.pub" "$dir/key-cert.pub"
  rmdir "$dir" 2>/dev/null || true
  echo "$name: locked."
}

cmd_local() {
  echo "This Mac: $(uname -m), $(sw_vers -productVersion 2>/dev/null || uname -s)"
  local t
  for t in sage-runtime trellis-crm ai-ui; do
    printf '  %-13s %s\n' "$t" "$($t version 2>/dev/null | head -1 || echo "not installed")"
  done
  printf '  %-13s %s\n' "Colima VM" "$(vm_type || echo none)"
  if command -v sage-runtime &>/dev/null; then
    echo "sage-runtime status:"
    sage-runtime status 2>&1 | sed 's/^/  /'
  fi
}

# --- main ----------------------------------------------------------------------------

ORIGINAL_ARGS=("$@")
name="${1:-}"
case "$name" in
  ""|help|-h|--help) usage; exit 0 ;;
  version|--version|-v) echo "$PROG $VERSION"; exit 0 ;;
  local) cmd_local; exit 0 ;;
esac
# The name becomes a file name here and a tag on the box: nothing that walks paths.
[[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "a box name is letters, digits, - and _: $name"
THE_BOX="$name"
shift
# --as-me stands right after the box, for any admin verb.
if [[ "${1:-}" == --as-me ]]; then AS_ME=1; shift; fi
sub="${1:-}"
case "$sub" in
  update)
    shift
    [[ $# -eq 0 || ( $# -eq 1 && "$1" == --as-me ) ]] || die "update takes --as-me only"
    [[ $# -eq 0 ]] || AS_ME=1
    cmd_update "$name" ;;
  backup) shift; cmd_backup "$name" "$@" ;;
  status) cmd_status "$name" ;;
  read) shift; cmd_read "$name" "$@" ;;
  unlock) shift; cmd_unlock "$name" "$@" ;;
  lock) cmd_lock "$name" ;;
  mailbox) shift; cmd_mailbox "$name" "$@" ;;
  manage) shift; cmd_manage "$name" "$@" ;;
  import) shift; cmd_import "$name" "$@" ;;
  tunnel) shift; cmd_tunnel "$name" "$@" ;;
  ""|--apply|--reboot|--as-me)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --apply)  APPLY=1 ;;
        --reboot) REBOOT=1 ;;
        --as-me)  AS_ME=1 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
      esac
      shift
    done
    [[ $REBOOT == 0 || $APPLY == 1 ]] || die "--reboot goes with --apply"
    cmd_plan "$name" ;;
  *) echo "Unknown command: $sub" >&2; usage >&2; exit 1 ;;
esac
