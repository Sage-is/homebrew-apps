  if [[ "$found_backup_daemon" == yes ]]; then
    step backups "trellis-crm backup runs nightly at 02:00" ""
  elif [[ "$found_backup_daemon" == unloaded ]]; then
    # The plist alone proves nothing: 0.1.0 wrote it and its bootstrap failed, so no backup ever ran.
    step backups "the LaunchDaemon $BACKUP_LABEL is there, but launchd never loaded it" "load it again (02:00, as $BOX_USER)" run_backup_daemon
  else
    step backups "no nightly backup" "install the LaunchDaemon $BACKUP_LABEL (02:00, as $BOX_USER); this Mac pulls it with: $PROG <box> backup --nightly" run_backup_daemon
